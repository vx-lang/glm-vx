// glm_vx_gpu_router through Vx's own GPU path: one warp of 32 lanes picks k <= 8 of experts <=
// 256 by sigmoid(logit) + bias (the bias changes ids only), with the hand kernel's stable warp
// argmax (ties go to the lower id), then normalizes the chosen sigmoid weights and scales them.
// spawn-include: device.vx

// One step of the hand kernels' vxk_warp_argmax at offset `width`, from (score, id) in
// (src_s, src_i) to (dst_s, dst_i). A negative id marks an empty lane.
macro_rules! argmax_step {
    ($dst_s:ident, $dst_i:ident, $src_s:ident, $src_i:ident, $width:expr) => {
        unsafe {
          for l in 0..$width across lanes {
            let mut best: f32 = $src_s[l];
            let mut result: i32 = $src_i[l];
            let other_score: f32 = $src_s[l + $width];
            let other_index: i32 = $src_i[l + $width];
            let mut replace: i32 = 0;
            if other_index >= 0 {
              if result < 0 { replace = 1; }
              else {
                if other_score > best { replace = 1; }
                if other_score == best { if other_index < result { replace = 1; } }
              }
            }
            if replace != 0 { best = other_score; result = other_index; }
            $dst_s[l] = best;
            $dst_i[l] = result;
          }
        }
    };
}

pub fn glm_vx_spawn_router(indices: &mut Tensor<i32, [?], Memory::HBM>, weights: &mut Tensor<f32, [?], Memory::HBM>,
                           logits: &Tensor<f32, [?], Memory::HBM>, bias: &Tensor<f32, [?], Memory::HBM>,
                           experts: i32, k: i32, scale: f32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      if experts > 0 && experts <= 256 && k > 0 && k <= 8 && k <= experts {
        let mut sa = unsafe { Tensor<f32, [32], Memory::SMEM>::uninit() };
        let mut ia = unsafe { Tensor<i32, [32], Memory::SMEM>::uninit() };
        let mut sb = unsafe { Tensor<f32, [32], Memory::SMEM>::uninit() };
        let mut ib = unsafe { Tensor<i32, [32], Memory::SMEM>::uninit() };
        for slot in 0..k {
          for lane in 0..32 across lanes {
            let mut best_index: i32 = -1;
            let mut best_score: f32 = 0.0;
            let mut e: i32 = lane;
            while e < experts {
              let mut used: i32 = 0;
              let mut previous: i32 = 0;
              while previous < slot { if indices[previous] == e { used = 1; } previous = previous + 1; }
              if used == 0 {
                let score: f32 = sigmoid!(logits[e]) + bias[e];
                if best_index < 0 { best_index = e; best_score = score; }
                else { if score > best_score { best_index = e; best_score = score; } }
              }
              e = e + 32;
            }
            sa[lane] = best_score;
            ia[lane] = best_index;
          }
          argmax_step!(sb, ib, sa, ia, 16);
          argmax_step!(sa, ia, sb, ib, 8);
          argmax_step!(sb, ib, sa, ia, 4);
          argmax_step!(sa, ia, sb, ib, 2);
          argmax_step!(sb, ib, sa, ia, 1);
          for t in 0..1 across lanes {
            let chosen: i32 = ib[t];
            indices[blk + slot] = chosen;
            weights[blk + slot] = sigmoid!(logits[chosen]);
          }
        }
        for lane in 0..32 across lanes {
          let mut value: f32 = 0.0;
          if lane < k { value = weights[lane]; }
          sa[lane] = value;
        }
        warp_sums!(sb, sa, 1);
        for lane in 0..32 across lanes {
          if lane < k { weights[lane] = weights[lane] / (sb[0] + 0.00000000000000000001) * scale; }
        }
      }
    }
  }
  return;
}
