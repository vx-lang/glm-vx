// FP8 e4m3fn matvec that reads sixteen codes a lane step: out[r] = sum over columns of
// (decode(w[r, c]) * scale[r / 128, c / 128]) * x[c], one warp of 32 lanes per row, four rows a block.
// weight is the [rows, cols] code bytes viewed as u32 (cols % 16 == 0, little-endian: byte j of a
// word is column 4 * word + j). Lane l reads words 4l .. 4l + 3 of every 128-word tile, columns
// tile * 512 + 16l .. + 15, one 16-byte load (Vx #2375), and decodes them with fp8_decode!'s bit
// cast. Lane l's order is tile by tile, its sixteen columns in order (device.vx's fp8_row_dot4!);
// then lanes::sum's tree. Other widths write zeros.
// spawn-include: device.vx

pub fn glm_vx_spawn_fp8_matvec4(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u32, [?], Memory::HBM>,
                                scales: &Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 4 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for lane in 0..32 across lanes {
          let row: i64 = (rb * 4 + w) as i64;
          let mut sum: f32 = 0.0;
          if row < (rows as i64) && cols % 16 == 0 {
            sum = fp8_row_dot4!(weight, scales, x, 0, 0, row, rows, cols as i64, lane);
          }
          a[w][lane] = sum;
        }
        let total: f32 = lanes::sum(&a[w], 32);
        if rb * 4 + w < rows && cols >= 0 { out[rb * 4 + w] = total; }
      }
    }
  }
  return;
}
