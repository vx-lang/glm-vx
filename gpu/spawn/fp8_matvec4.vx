// FP8 e4m3fn matvec that reads four codes per load: out[r] = sum over columns of
// (decode(w[r, c]) * scale[r / 128, c / 128]) * x[c], one warp of 32 lanes per row, four rows a block.
// weight is the [rows, cols] code bytes viewed as u32 (cols % 4 == 0, little-endian: byte j of a
// word is column 4 * word + j). Lane l reads word l of every 128-column tile, columns
// tile * 128 + 4l .. + 3, so one load per lane covers a scale tile per warp, and it issues the
// loads of four tiles before it adds any of them. Codes are decoded through a 256-entry table ([8, 32]) in
// shared memory that each subgroup builds from fp8_decode!, exact for every code.
// Lane l's order is tile by tile, its four columns in order; then lanes::sum's tree.
// spawn-include: device.vx

// Word `lane` of tile `tile + t` of a row, or 0 past the row.
macro_rules! word_at {
    ($weight:ident, $row_words:expr, $words:expr, $tiles:expr, $tile:expr, $t:expr, $lane:expr) => {
        unsafe {
          let dv_at: i64 = ($tile + $t) * 32 + ($lane as i64);
          let mut dv_word: i32 = 0;
          if $tile + $t < $tiles && dv_at < $words { dv_word = $weight[$row_words + dv_at] as i32; }
          dv_word
        }
    };
}

// sum plus the word's four terms in column order, (decode(code) * scale) * x[col].
macro_rules! fp8_word_terms {
    ($sum:expr, $word:expr, $table:ident, $w:expr, $scales:ident, $scale_base:expr, $x:ident, $tiles:expr, $tile:expr,
     $t:expr, $lane:expr, $k:expr) => {
        unsafe {
          let mut dv_sum: f32 = $sum;
          if $tile + $t < $tiles {
            let dv_scale: f32 = $scales[$scale_base + $tile + $t];
            let dv_col: i64 = ($tile + $t) * 128 + (($lane * 4) as i64);
            let mut dv_j: i32 = 0;
            while dv_j < 4 {
              if dv_col + (dv_j as i64) < $k {
                let dv_code: i32 = ($word >> (dv_j * 8)) & 255;
                dv_sum = dv_sum + ($table[$w][dv_code >> 5][dv_code & 31] * dv_scale) * $x[dv_col + (dv_j as i64)];
              }
              dv_j = dv_j + 1;
            }
          }
          dv_sum
        }
    };
}

pub fn glm_vx_spawn_fp8_matvec4(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u32, [?], Memory::HBM>,
                                scales: &Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 4 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      let mut table = unsafe { Tensor<f32, [4, 8, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for i in 0..8 {
          for lane in 0..32 across lanes {
            table[w][i][lane] = fp8_decode!(i * 32 + lane);
          }
        }
        for lane in 0..32 across lanes {
          let row: i64 = (rb * 4 + w) as i64;
          let mut sum: f32 = 0.0;
          if row < (rows as i64) && cols % 4 == 0 {
            let k: i64 = cols as i64;
            let tiles: i64 = (k + 127) / 128;
            let words: i64 = k / 4;
            let row_words: i64 = row * words;
            let scale_base: i64 = (row / 128) * tiles;
            let mut tile: i64 = 0;
            while tile < tiles {
              // Four tiles' words first (zero past the row), then their sums in order.
              let w0: i32 = word_at!(weight, row_words, words, tiles, tile, 0, lane);
              let w1: i32 = word_at!(weight, row_words, words, tiles, tile, 1, lane);
              let w2: i32 = word_at!(weight, row_words, words, tiles, tile, 2, lane);
              let w3: i32 = word_at!(weight, row_words, words, tiles, tile, 3, lane);
              sum = fp8_word_terms!(sum, w0, table, w, scales, scale_base, x, tiles, tile, 0, lane, k);
              sum = fp8_word_terms!(sum, w1, table, w, scales, scale_base, x, tiles, tile, 1, lane, k);
              sum = fp8_word_terms!(sum, w2, table, w, scales, scale_base, x, tiles, tile, 2, lane, k);
              sum = fp8_word_terms!(sum, w3, table, w, scales, scale_base, x, tiles, tile, 3, lane, k);
              tile = tile + 4;
            }
          }
          a[w][lane] = sum;
        }
        let total: f32 = lanes::sum(&a[w], 32);
        if rb * 4 + w < rows && cols >= 0 { out[rb * 4 + w] = total; }
      }
    }
  }
  return;
}
