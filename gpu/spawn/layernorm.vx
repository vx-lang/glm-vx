// glm_vx_gpu_layernorm through Vx's own GPU path (the DSA indexer key norm). One block per row;
// the mean first, then the variance of the centered values, correctly rounded sqrt (Vx #1944).
// spawn-include: device.vx

pub fn glm_vx_spawn_layernorm(out: &mut Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                              weight: &Tensor<f32, [?], Memory::HBM>, bias: &Tensor<f32, [?], Memory::HBM>,
                              rows: i32, dim: i32, eps: f32) -> void {
  spawn on(Topology::Device) grid([rows]) block(256) {
    let mut shared = unsafe { Tensor<f32, [33], Memory::SMEM>::uninit() };
    let tid: i32 = thread_id();
    let row: i32 = block_id();
    let block: i32 = block_dim();
    if rows > 0 && dim > 0 && eps > 0.0 && row < rows && block >= 32 && block <= 1024 && block % 32 == 0 {
      let base: i32 = row * dim;
      let mut s: f32 = 0.0;
      let mut d: i32 = tid;
      while d < dim { s = s + x[base + d]; d = d + block; }
      let sum: f32 = block_sum(s, &mut shared);
      let mean: f32 = sum / (dim as f32);
      let mut ss: f32 = 0.0;
      d = tid;
      while d < dim {
        let c: f32 = x[base + d] - mean;
        ss = ss + c * c;
        d = d + block;
      }
      let sq: f32 = block_sum(ss, &mut shared);
      let inv: f32 = 1.0 / (sq / (dim as f32) + eps).sqrt();
      d = tid;
      while d < dim { out[base + d] = (x[base + d] - mean) * inv * weight[d] + bias[d]; d = d + block; }
    }
  }
  return;
}
