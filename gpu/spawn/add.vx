// glm_vx_gpu_add through Vx's own GPU path: the spawn region becomes the device kernel, with
// no extern adapter. vxc names the PTX entry after the function and passes the function's
// parameters in declared order (Vx docs/lang/abi.md 3.5).
// spawn-include: device.vx

// out[i] = a[i] + b[i] for i < n, grid-stride. out may be a or b: each thread touches only
// its own index.
pub fn glm_vx_spawn_add(out: &mut Tensor<f32, [?], Memory::HBM>, a: &Tensor<f32, [?], Memory::HBM>,
                        b: &Tensor<f32, [?], Memory::HBM>, n: i32) -> void {
  spawn on(Topology::Device) grid([(n - 1) / 256 + 1]) block(256) {
    let stride: i32 = grid_dim() * block_dim();
    let mut i: i32 = block_id() * block_dim() + thread_id();
    while i < n {
      out[i] = a[i] + b[i];
      i = i + stride;
    }
  }
  return;
}
