// Generated by gen_fp8_gemm.py from fp8_gemm_grouped.vx.in (m64: 1 consumer warpgroup(s), 4 stages).
// Grouped block-FP8 GEMM for H100 (sm_90a): the routed experts of a MoE layer in one launch. Built
// from fp8_gemm.vx.in (gen_fp8_gemm.py); the pipeline, the ring and the wgmma are that kernel's.
//
//   for each expert e and each gathered row m in offsets[e] .. offsets[e + 1]:
//   C[m, n] = sum_kb a_scale[m, kb] * b_scale[e, n / 128, kb] * sum_{k in block kb} A[m, k] * B[e, n, k]
//
// A [rows, K] are the gathered e4m3 rows, grouped by expert; a_scale is f32 [rows, KB]. B is the
// experts' e4m3 weights [E, N, K], one TMA map over [E * N, K]; b_scale is f32 [E, ceil(N / 128), KB].
// C is f32 [rows, N], in the order of A. N % 128 == 0, so a 128-row box of B never crosses an expert.
//
// fp8_gemm_grouped_plan.vx writes `tiles`: tiles[0] entries of (expert, first row, end row), one for
// each 64 rows of an expert. It also writes `ranges`: range t is the rows [first row, min(first row
// + 64, end row)) of entry t, and the empty range [0, 0) past tiles[0]. No two ranges overlap, so the
// race check of Vx proves that no two CTAs store the same element of C. The grid has tiles_max x
// N / 128 CTAs, so the host needs no offsets: CTA (n_tile, t) with t past tiles[0] runs no k block
// and stores nothing. Rows of the next expert in a tile are multiplied with this expert's B and not
// stored; rows past A are zeros (TMA).
// spawn-include: ../device.vx
// spawn-include: sm90.vx
// spawn-include: wgmma_m64n128k32.vx

fn ring_a_address(t: &Tensor<i32, [8192], Memory::SMEM, aligned(1024)>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<8192xi32, 3>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<8192xi32, 3> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

fn ring_b_address(t: &Tensor<i32, [16384], Memory::SMEM, aligned(1024)>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<16384xi32, 3>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<16384xi32, 3> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

fn bars_address(t: &Tensor<i64, [8], Memory::SMEM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<8xi64, 3>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<8xi64, 3> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

// Tells LLVM that the second dimension of `$t` is even, so that it can merge the stores of columns
// c and c + 1 (c even) into one store: bf16x2 in 4 bytes, f32 pairs in 8. Nothing checks it, and the
// kernel's caller makes it true. The clause names an element that the lane writes anyway: the race
// check of Vx refuses a block that names all of `$t`.
macro_rules! even_pitch {
    ($t:ident, $el:ident, $row:ident, $col:ident) => {
        mlir!( inputs : (%o = $t : memref<?x?x$el>), returns : i32, dialects : ["arith", "memref", "llvm"],
               ensures : [writes_only($t[$row][$col])]) {
          %c1 = arith.constant 1 : index
          %n = memref.dim %o, %c1 : memref<?x?x$el>
          %m = arith.andi %n, %c1 : index
          %c0 = arith.constant 0 : index
          %e = arith.cmpi eq, %m, %c0 : index
          llvm.intr.assume %e : i1
          %z = arith.constant 0 : i32
          macro.yield %z : i32
        }
    };
}

// maps: 256 bytes, the CUtensorMap of A at byte 0 and of B at byte 128 (64-byte aligned each).
// out: f32 C [M, N] when bf16_out == 0; out_bf16: C in bfloat16 [M, N] (round to nearest even),
// written instead when bf16_out != 0. N is a multiple of 128, and the second dimension of the
// tensor that the kernel writes is even.
pub fn glm_vx_fp8_gemm_grouped_m64(maps: &Tensor<u8, [?], Memory::HBM>, a_scale: &Tensor<f32, [?], Memory::HBM>,
                                 b_scale: &Tensor<f32, [?], Memory::HBM>, out: &mut Tensor<f32, [?, ?], Memory::HBM>,
                                 out_bf16: &mut Tensor<bf16, [?, ?], Memory::HBM>, tiles: &Tensor<i32, [?], Memory::HBM>,
                                 ranges: &DisjointRanges<Tensor<i32, [?, 2], Memory::HBM>>,
                                 rows_m: i32, rows_n: i32, cols: i32, tiles_max: i32, bf16_out: i32) -> void {
  // The loops give the launch shape (Vx #2097): one block for each entry and 128 columns, of 160 lanes.
  spawn on(Topology::Device) {
    for bid in 0..tiles_max * ((rows_n + 127) / 128) across blocks {
    // The shared tensors come before any loop: over 48 KiB of shared memory declared after a loop
    // crashes a vxc with #1995 and #2058 but not #2064 (Vx #2061).
    let mut ring_a = unsafe { Tensor<i32, [8192], Memory::SMEM, aligned(1024)>::uninit() };
    let mut ring_b = unsafe { Tensor<i32, [16384], Memory::SMEM, aligned(1024)>::uninit() };
    let mut bars = unsafe { Tensor<i64, [8], Memory::SMEM>::uninit() };
    // Lane 0 sets up the barriers. The end of a lane loop is a barrier of the block, so every lane
    // sees them after it. Each lane then works out the tile itself: code between lane loops runs on
    // lane 0 only.
    for tid in 0..160 across lanes(160) {
      if tid == 0 {
        let bar_base: i64 = bars_address(&bars);
        for s in 0..4 {
          let _f: i32 = mbar_init(bar_base + 8 * (s as i64), 1);
          let _e: i32 = mbar_init(bar_base + 8 * ((4 + s) as i64), 4);
        }
        let _b: i32 = fence_barrier_init();
      } else {
        let _idle: i32 = 0;
      }
    }
    for tid in 0..160 across lanes(160) {
      let a_base: i64 = ring_a_address(&ring_a);
      let b_base: i64 = ring_b_address(&ring_b);
      let bar_base: i64 = bars_address(&bars);
      let blocks_k: i32 = (cols + 127) / 128;
      let t: i32 = bid % tiles_max;
      let n0: i32 = (bid / tiles_max) * 128;
      let active: bool = t < tiles[0];
      let expert: i32 = if active { tiles[1 + 3 * t] } else { 0 };
      let m0: i32 = if active { tiles[2 + 3 * t] } else { 0 };
      let m_end: i32 = if active { tiles[3 + 3 * t] } else { 0 };
      let kb0: i32 = 0;
      let nkb: i32 = if active { blocks_k } else { 0 };
      // ::fill(0.0) of 64 elements stays a loop with a variable index, which keeps the tensor in local
      // memory; a constant-bound loop over a REG tensor is unrolled by Vx (PR #1991).
      let mut acc = unsafe { Tensor<f32, [64], Memory::REG>::uninit() };
      let mut part = unsafe { Tensor<f32, [64], Memory::REG>::uninit() };
      for r in 0..64 {
        acc[r] = 0.0;
        part[r] = 0.0;
      }
      let mut i: i32 = 0;
      if tid == 128 {
        // Only this thread reads the maps, so its fence is the block's (sm90.vx, gpu/FP8-GEMM.md).
        let a_map: i64 = global_address(maps);
        let b_map: i64 = a_map + 128;
        let _fa: i32 = fence_tensormap_acquire(a_map);
        let _fb: i32 = fence_tensormap_acquire(b_map);
        let _pa: i32 = prefetch_tensormap(a_map);
        let _pb: i32 = prefetch_tensormap(b_map);
        while i < nkb {
          let s: i32 = i % 4;
          let parity: i32 = (i / 4) & 1;
          let _m: i32 = mbar_wait(bar_base + 8 * ((4 + s) as i64), parity ^ 1);
          let full: i64 = bar_base + 8 * (s as i64);
          let _x: i32 = mbar_arrive_expect_tx(full, 24576);
          let k: i32 = (kb0 + i) * 128;
          let _ta: i32 = tma_load_2d(a_base + 8192 * (s as i64), a_map, k, m0, full);
          let _tb: i32 = tma_load_2d(b_base + 16384 * (s as i64), b_map, k, expert * rows_n + n0, full);
          i = i + 1;
        }
      } else {
        // Vx: without this `else`, E3048 says the `if` above has no value (gpu/FP8-GEMM.md).
        let _idle: i32 = 0;
      }
      if tid < 128 {
        let group: i32 = tid >> 7;
        let warp: i32 = (tid >> 5) & 3;
        let lane: i32 = tid & 31;
        let row_lo: i32 = m0 + 64 * group + 16 * warp + (lane >> 2);
        let row_hi: i32 = row_lo + 8;
        // Rows past M read row M - 1's scale: their A rows are zeros (TMA), so their part is 0 and
        // the scale only has to be finite. They are not stored.
        let mut srow_lo: i32 = row_lo;
        if srow_lo > rows_m - 1 {
          srow_lo = rows_m - 1;
        }
        let mut srow_hi: i32 = row_hi;
        if srow_hi > rows_m - 1 {
          srow_hi = rows_m - 1;
        }
        let kbs: i64 = blocks_k as i64;
        let a_lo: i64 = (srow_lo as i64) * kbs;
        let a_hi: i64 = (srow_hi as i64) * kbs;
        let b_row: i64 = ((expert * ((rows_n + 127) / 128) + n0 / 128) as i64) * kbs;
        let a_desc: i64 = sw128_desc(a_base + 8192 * (group as i64));
        let b_desc: i64 = sw128_desc(b_base);
        while i < nkb {
          let s: i32 = i % 4;
          let parity: i32 = (i / 4) & 1;
          let kb: i64 = (kb0 + i) as i64;
          // The scales are loaded before the wait, so their latency hides behind it.
          let sb: f32 = b_scale[b_row + kb];
          let s_lo: f32 = a_scale[a_lo + kb] * sb;
          let s_hi: f32 = a_scale[a_hi + kb] * sb;
          let _m: i32 = mbar_wait(bar_base + 8 * (s as i64), parity);
          let _w: i32 = wgmma_m64n128k32_k128!(part, a_desc + 512 * (s as i64), b_desc + 1024 * (s as i64));
          if lane == 0 {
            let _a: i32 = mbar_arrive(bar_base + 8 * ((4 + s) as i64));
          }
          for j in 0..16 {
            acc[4 * j] = acc[4 * j] + part[4 * j] * s_lo;
            acc[4 * j + 1] = acc[4 * j + 1] + part[4 * j + 1] * s_lo;
            acc[4 * j + 2] = acc[4 * j + 2] + part[4 * j + 2] * s_hi;
            acc[4 * j + 3] = acc[4 * j + 3] + part[4 * j + 3] * s_hi;
          }
          i = i + 1;
        }
        // Epilogue: register 4j + q is row row_lo + 8 (q >> 1), column n0 + 8j + 2 (lane % 4) + (q & 1).
        // The rows are those of range t, written as parts of tid that the race check of Vx follows.
        let start: i64 = ranges[t][0] as i64;
        let end: i64 = ranges[t][1] as i64;
        let row_lo: i64 = start + ((64 * (tid / 128) + 16 * ((tid % 128) / 32) + (tid % 32) / 4) as i64);
        let row_hi: i64 = row_lo + 8;
        let col0: i32 = n0 + 2 * (tid % 4);
        // One loop over j for both rows: the race check compares the columns of the two rows by
        // the same j.
        if bf16_out != 0 {
          for j in 0..16 {
            let c: i32 = col0 + 8 * j;
            if row_lo < end {
              let _e: i32 = even_pitch!(out_bf16, bf16, row_lo, c);
              out_bf16[row_lo][c] = acc[4 * j] as bf16;
              out_bf16[row_lo][c + 1] = acc[4 * j + 1] as bf16;
            }
            if row_hi < end {
              let _e: i32 = even_pitch!(out_bf16, bf16, row_hi, c);
              out_bf16[row_hi][c] = acc[4 * j + 2] as bf16;
              out_bf16[row_hi][c + 1] = acc[4 * j + 3] as bf16;
            }
          }
        } else {
          for j in 0..16 {
            let c: i32 = col0 + 8 * j;
            if row_lo < end {
              let _e: i32 = even_pitch!(out, f32, row_lo, c);
              out[row_lo][c] = acc[4 * j];
              out[row_lo][c + 1] = acc[4 * j + 1];
            }
            if row_hi < end {
              let _e: i32 = even_pitch!(out, f32, row_hi, c);
              out[row_hi][c] = acc[4 * j + 2];
              out[row_hi][c + 1] = acc[4 * j + 3];
            }
          }
        }
      }
    }
  }
  }
  return;
}
