// glm_vx_spawn_kv_rows_prefill_bf16 (#63, item 5b): prefill_chunk's MLA cache rows for `rows` tokens at positions start.., one
// block a token: kv_a's first `rank` values RMSNormed with kv_a_layernorm (eps; the sums of gpu/spawn/rmsnorm_rows
// with `threads` lanes, so the hand rmsnorm's bits) into the bf16 latent cache, and its last `rot` values RoPE'd
// (glm_vx_gpu_rope_strided's packed [rotated even, rotated odd]) into the bf16 rope cache, each token with its own
// cos and sin (steps[t]: cos at 0.., sin at rot / 2..). compressed is [rows, rank + rot].
// spawn-include: device.vx

pub fn glm_vx_spawn_kv_rows_prefill_bf16(latents: &mut Tensor<bf16, [?, ?], Memory::HBM>, rope_keys: &mut Tensor<bf16, [?, ?], Memory::HBM>,
                                compressed: &Tensor<f32, [?, ?], Memory::HBM>, weight: &Tensor<f32, [?], Memory::HBM>,
                                steps: &Tensor<f32, [?, ?], Memory::HBM>, start: i32, rows: i32, rank: i32, rot: i32,
                                eps: f32, threads: i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..rows across blocks {
      if rank > 0 && eps > 0.0 && threads >= 32 && threads <= 1024 && threads % 32 == 0 {
        let mut a = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
        for l in 0..1024 across lanes {
          let mut ss: f32 = 0.0;
          if l < threads {
            let mut d: i32 = l;
            while d < rank { ss = ss + compressed[t][d] * compressed[t][d]; d = d + threads; }
          }
          a[l] = ss;
        }
        let total: f32 = lanes::sum(&a, threads);
        for k in 0..rank across lanes(256) {
          let inv: f32 = 1.0 / (total / (rank as f32) + eps).sqrt();
          latents[start + t][k] = (compressed[t][k] * inv * weight[k]) as bf16;
        }
      }
      for j in 0..rot across lanes(256) {
        let pairs: i32 = rot / 2;
        if pairs > 0 && rot % 2 == 0 {
          let p: i32 = j % pairs;
          let a0: f32 = compressed[t][rank + p * 2];
          let b0: f32 = compressed[t][rank + p * 2 + 1];
          let c: f32 = steps[t][p];
          let s: f32 = steps[t][pairs + p];
          let mut v: f32 = a0 * c - b0 * s;
          if j >= pairs { v = b0 * c + a0 * s; }
          rope_keys[start + t][j] = v as bf16;
        }
      }
    }
  }
  return;
}
