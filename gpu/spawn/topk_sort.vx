// The stable top-k for short contexts (#32): ids sorted by (descending score, ascending position),
// the first min(k, tokens) of np.argsort(-scores, kind='stable'), as topk.vx, for tokens <= 2048.
// One block of 1024 lanes sorts every position in shared memory, so there is no histogram pass:
// topk.vx's radix select keeps 256 histogram rows of 256 counts in device memory and clears and
// sums them four times, whatever the context.
//   - Each position becomes one i64, its key above its position reversed, so a bigger value ranks
//     first; the padding up to p, the power of two at or above tokens, is the smallest i64.
//   - A bitonic sort, descending, two stages a round, a to b then b to a, as topk.vx's.
// Scores arrive as raw float32 bits in an i32 tensor. tokens > 2048 writes nothing: the caller
// uses topk_stable there. topk_sort_at.vx is this kernel with tokens read from the step buffer.
// spawn-include: device.vx

// Order-preserving map from float32 bits to [0, 2^32): bigger key == bigger score; NaN is 0.
macro_rules! topk_key {
    ($bits:expr) => {
        unsafe {
          let dv_b: i64 = ($bits as i64) & 4294967295;
          let dv_man: i64 = dv_b & 8388607;
          let mut dv_key: i64 = dv_b + 2147483648;
          if dv_b >= 2147483648 { dv_key = 4294967295 - dv_b; }
          if dv_b == 2147483648 { dv_key = 2147483648; }
          if ((dv_b >> 23) & 255) == 255 && dv_man != 0 { dv_key = 0; }
          dv_key
        }
    };
}

// One compare-exchange of stage st of the descending bitonic sort, at position i of src.
macro_rules! bitonic_stage {
    ($src:ident, $i:expr, $st:expr, $stages:expr) => {
        unsafe {
          let dv_i: i32 = $i;
          let dv_st: i32 = $st;
          let dv_x: i64 = $src[dv_i];
          let mut dv_value: i64 = dv_x;
          if dv_st < $stages {
            let mut dv_m: i32 = 1;
            let mut dv_before: i32 = 0;
            while dv_before + dv_m <= dv_st { dv_before = dv_before + dv_m; dv_m = dv_m + 1; }
            let dv_size: i32 = 1 << dv_m;
            let dv_d: i32 = dv_size >> (dv_st - dv_before + 1);
            let dv_y: i64 = $src[dv_i ^ dv_d];
            let mut dv_larger: i64 = dv_x;
            let mut dv_smaller: i64 = dv_y;
            if dv_y > dv_x { dv_larger = dv_y; dv_smaller = dv_x; }
            dv_value = dv_smaller;
            if ((dv_i & dv_d) == 0) == ((dv_i & dv_size) == 0) { dv_value = dv_larger; }
          }
          dv_value
        }
    };
}

pub fn glm_vx_spawn_topk_sort(out_ids: &mut Tensor<i32, [?], Memory::HBM>, scores: &Tensor<i32, [?], Memory::HBM>,
                              tokens: i32, k: i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      if tokens > 0 && k > 0 && tokens <= 2048 {
        let mut order_a = unsafe { Tensor<i64, [2048], Memory::SMEM>::uninit() };
        let mut order_b = unsafe { Tensor<i64, [2048], Memory::SMEM>::uninit() };
        let kk: i32 = k.min(tokens);
        // p, the power of two at or above tokens, is 2^bits (closed forms: a bound of a lane loop
        // must be uniform, which a `while` loop's result is not).
        let v0: i32 = tokens - 1;
        let v1: i32 = v0 | (v0 >> 1);
        let v2: i32 = v1 | (v1 >> 2);
        let v3: i32 = v2 | (v2 >> 4);
        let v4: i32 = v3 | (v3 >> 8);
        let v5: i32 = v4 | (v4 >> 16);
        let p: i32 = v5 + 1;
        let c1: i32 = v5 - ((v5 >> 1) & 1431655765);
        let c2: i32 = (c1 & 858993459) + ((c1 >> 2) & 858993459);
        let c3: i32 = (c2 + (c2 >> 4)) & 252645135;
        let c4: i32 = c3 + (c3 >> 8);
        let bits: i32 = (c4 + (c4 >> 16)) & 63;
        let stages: i32 = bits * (bits + 1) / 2;
        for i in 0..p across lanes(1024) {
          let mut value: i64 = -9223372036854775807 - 1;
          if i < tokens {
            value = (topk_key!(scores[i]) - 2147483648) * 4294967296 + (4294967295 - (i as i64));
          }
          order_a[i] = value;
        }
        for round in 0..(stages + 1) / 2 {
          for i in 0..p across lanes(1024) { order_b[i] = bitonic_stage!(order_a, i, round * 2, stages); }
          for i in 0..p across lanes(1024) { order_a[i] = bitonic_stage!(order_b, i, round * 2 + 1, stages); }
        }
        for r in 0..kk across lanes(1024) {
          out_ids[r] = (4294967295 - (order_a[r] & 4294967295)) as i32;
        }
      }
    }
  }
  return;
}
