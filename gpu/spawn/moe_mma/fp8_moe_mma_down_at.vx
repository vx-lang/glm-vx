m, m, t; abs.f32 t, x30; max.f32 m, m, t; abs.f32 t, x31; max.f32 m, m, t; shfl.sync.bfly.b32 t, m, 1, 31, -1; max.f32 m, m, t; shfl.sync.bfly.b32 t, m, 2, 31, -1; max.f32 m, m, t; max.f32 s, m, 0f2EDBE6FF; div.rn.f32 s, s, 0f43E00000; div.rn.f32 inv, 0f3F800000, s; mul.f32 x0, x0, inv; mul.f32 x1, x1, inv; mul.f32 x2, x2, inv; mul.f32 x3, x3, inv; mul.f32 x4, x4, inv; mul.f32 x5, x5, inv; mul.f32 x6, x6, inv; mul.f32 x7, x7, inv; mul.f32 x8, x8, inv; mul.f32 x9, x9, inv; mul.f32 x10, x10, inv; mul.f32 x11, x11, inv; mul.f32 x12, x12, inv; mul.f32 x13, x13, inv; mul.f32 x14, x14, inv; mul.f32 x15, x15, inv; mul.f32 x16, x16, inv; mul.f32 x17, x17, inv; mul.f32 x18, x18, inv; mul.f32 x19, x19, inv; mul.f32 x20, x20, inv; mul.f32 x21, x21, inv; mul.f32 x22, x22, inv; mul.f32 x23, x23, inv; mul.f32 x24, x24, inv; mul.f32 x25, x25, inv; mul.f32 x26, x26, inv; mul.f32 x27, x27, inv; mul.f32 x28, x28, inv; mul.f32 x29, x29, inv; mul.f32 x30, x30, inv; mul.f32 x31, x31, inv; cvt.rn.satfinite.e4m3x2.f32 h0, x1, x0; cvt.rn.satfinite.e4m3x2.f32 h1, x3, x2; mov.b32 b0, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x5, x4; cvt.rn.satfinite.e4m3x2.f32 h1, x7, x6; mov.b32 b1, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x9, x8; cvt.rn.satfinite.e4m3x2.f32 h1, x11, x10; mov.b32 b2, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x13, x12; cvt.rn.satfinite.e4m3x2.f32 h1, x15, x14; mov.b32 b3, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x17, x16; cvt.rn.satfinite.e4m3x2.f32 h1, x19, x18; mov.b32 b4, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x21, x20; cvt.rn.satfinite.e4m3x2.f32 h1, x23, x22; mov.b32 b5, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x25, x24; cvt.rn.satfinite.e4m3x2.f32 h1, x27, x26; mov.b32 b6, {h0, h1}; cvt.rn.satfinite.e4m3x2.f32 h0, x29, x28; cvt.rn.satfinite.e4m3x2.f32 h1, x31, x30; mov.b32 b7, {h0, h1}; mov.f32 c0, 0f00000000; mov.f32 c1, 0f00000000; mov.f32 c2, 0f00000000; mov.f32 c3, 0f00000000; mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {c0, c1, c2, c3}, {a16, a20, a1