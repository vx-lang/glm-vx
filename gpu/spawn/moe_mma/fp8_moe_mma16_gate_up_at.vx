// Generated by gen_moe_mma.py: the routed experts' gate and up projections and SwiGLU on the tensor cores (#63,
// docs/TP-SERVING-PLAN.md item 4): act[s * inter + i] = silu(gate . x) * (up . x) for expert s (ascending id order)
// and row i, as fp8_moe_cvt_gate_up. The FP8 weights are unpacked to f16 in registers (exact), x is put in f16 with
// a power-of-two scale a group of 128, mma.sync.m16n8k16.f16 with f32 sums, times the 128x128 weight scales and x's.
// A block takes 16 rows of an expert's gate and the same 16 of up; its 8 warps an eighth of the columns
// each, a 256-column segment a call (16 loads of 16 bytes a lane in flight); their sums added in warp order, then
// silu(g) * u (device.vx's sigmoid!). Arguments as fp8_moe_cvt_gate_up. Needs k <= 9, inter % 16 == 0 and
// cols % 2048 == 0; otherwise act is zeros (ResidentGLM(moe_mma=True) keeps fp8_moe_cvt_gate_up there).
// spawn-include: ../device.vx
// spawn-maxnreg: 128

fn address1(t: &Tensor<f32, [?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?xf32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?xf32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

fn address1i(t: &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?xi32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?xi32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

fn address1u(t: &Tensor<u32, [?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?xi32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?xi32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

fn slot_of_rank_warp(ids: i64, k: i32, rank: i32) on Topology::Device -> i32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%i = ids : i64, %k = k : i32, %r = rank : i32), returns : i32, dialects : ["llvm"],
                ensures : [writes_only()]) {
    %s = llvm.inline_asm has_side_effects "{ .reg .b32 l, id, other, r, ball; .reg .b64 addr; .reg .pred inr, lt, hit; mov.u32 l, %laneid; mov.u32 id, 2147483647; setp.lt.s32 inr, l, $2; mul.wide.u32 addr, l, 4; add.s64 addr, addr, $1; @inr ld.global.nc.u32 id, [addr]; mov.u32 r, 0; shfl.sync.idx.b32 other, id, 0, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 1, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 2, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 3, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 4, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 5, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 6, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 7, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; shfl.sync.idx.b32 other, id, 8, 31, -1; setp.lt.s32 lt, other, id; @lt add.u32 r, r, 1; setp.eq.u32 hit, r, $3; and.pred hit, hit, inr; vote.sync.ballot.b32 ball, hit, -1; bfind.u32 $0, ball; }", "=r,l,r,r" %i, %k, %r : (i64, i32, i32) -> i32
    macro.yield %s : i32
  } };
}

