// Generated by gen_topk_bitmap_stats.py from topk_select_bitmap_at.vx: that kernel with stats[4], which
// each launch with tokens > k adds to: launches, launches whose threshold bin held more than 2048 keys,
// the most keys it held, and launches whose bin held more than 1024.
//
// The stable top-k set in ascending position order (topk_select_at's: ties at the threshold take the
// lowest positions first), one block of 1024 lanes, tokens from step[1]. With tokens <= k it writes
// nothing (#43). It reads hist[4096], the keys' top 12 bits that index_scores_mma_hist_at or
// index_scores_fp8_hist_at counted, and zeroes it. One pass over the scores, then work on at most 4096
// keys and 2048 words:
//   - From hist, the threshold bin B and `take`, the keys of bin B to take.
//   - The pass: a key above bin B sets its position's bit in `taken`. A key of bin B is counted by its
//     next 10 bits and listed in shared memory. If bin B holds more than 2048 keys, the two rounds below
//     read the scores again instead of the list.
//   - Two rounds of 10 bits over bin B's keys give the threshold key K and `left`, the keys equal to K
//     to take. They set the bits of the keys above K in `taken`, and of the keys equal to K in `ties`.
//   - Lane l owns the bitmaps' words 2l and 2l + 1 (positions 64l .. 64l + 63). Scans of its taken and
//     tie counts give its first slot. It writes its taken positions and its first ties while fewer than
//     `left` ties come before them, in position order.
// The bitmaps hold 65536 positions: more tokens stop the kernel. No warp instructions, so the CPU runs it
// too. Each bit is set once, so an atomic add sets it. Scores arrive as raw float32 bits in an i32 tensor.
// spawn-include: device.vx
// spawn-vxc: -fweak-relaxed-atomics
import core::sync::atomic;

// Order-preserving map from float32 bits to [0, 2^32): bigger key == bigger score. NaN is 0, and -0.0
// is +0.0's key. (topk_select_at's.)
macro_rules! topk_key32 {
    ($bits:expr) => {
        unsafe {
          let dv_b: u32 = $bits as u32;
          let mut dv_key: u32 = dv_b ^ 2147483648u32;
          if dv_b >= 2147483648u32 { dv_key = 4294967295u32 - dv_b; }
          if dv_b == 2147483648u32 { dv_key = 2147483648u32; }
          if (dv_b & 2147483647u32) > 2139095040u32 { dv_key = 0u32; }
          dv_key
        }
    };
}

// The number of set bits, and of zero bits below the lowest set bit: math.ctpop and math.cttz, which the
// CPU and the GPU both have. The checker does not yet know that u32's own methods write no memory.
fn ones(x: u32) on Topology::Device -> u32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%x = x : i32), returns : u32, dialects : ["math"], ensures : [writes_only()]) {
    %r = math.ctpop %x : i32
    macro.yield %r : i32
  } };
}

fn low_zeros(x: u32) on Topology::Device -> u32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%x = x : i32), returns : u32, dialects : ["math"], ensures : [writes_only()]) {
    %r = math.cttz %x : i32
    macro.yield %r : i32
  } };
}

// Sets position p's bit in a bitmap of 2048 u32 words (p < 65536, so the mask changes nothing but lets the
// compiler drop the bounds check).
macro_rules! set_bit {
    ($bitmap:ident, $p:expr) => {
        unsafe {
          let _o = atomic_fetch_add_u32(&$bitmap, ($p >> 5) & 2047, 1u32 << (($p & 31) as u32), AtomicOrdering::Relaxed);
        }
    };
}

// Stops the kernel (llvm.intr.trap: a trap on the GPU and on the CPU).
fn stop_kernel(x: i32) on Topology::Device -> i32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%x = x : i32), returns : i32, dialects : ["llvm"], ensures : [writes_only()]) {
    llvm.intr.trap
    macro.yield %x : i32
  } };
}

// Sums of 32 counts a[$base + j], over j > $t or j < $t, with every load before the adds: the 32 loads
// issue together, where a loop would wait for each group of them in turn.
macro_rules! term_if {
    ($a:ident, $base:expr, $j:expr, $keep:expr) => {
        unsafe {
          let dv_v: u32 = $a[$base + $j];
          if $keep { dv_v } else { 0u32 }
        }
    };
}

macro_rules! sum8_above {
    ($a:ident, $base:expr, $j:expr, $t:expr) => {
        (term_if!($a, $base, $j, $j > $t) + term_if!($a, $base, $j + 1, $j + 1 > $t)
         + term_if!($a, $base, $j + 2, $j + 2 > $t) + term_if!($a, $base, $j + 3, $j + 3 > $t)
         + term_if!($a, $base, $j + 4, $j + 4 > $t) + term_if!($a, $base, $j + 5, $j + 5 > $t)
         + term_if!($a, $base, $j + 6, $j + 6 > $t) + term_if!($a, $base, $j + 7, $j + 7 > $t))
    };
}

macro_rules! sum8_below {
    ($a:ident, $base:expr, $j:expr, $t:expr) => {
        (term_if!($a, $base, $j, $j < $t) + term_if!($a, $base, $j + 1, $j + 1 < $t)
         + term_if!($a, $base, $j + 2, $j + 2 < $t) + term_if!($a, $base, $j + 3, $j + 3 < $t)
         + term_if!($a, $base, $j + 4, $j + 4 < $t) + term_if!($a, $base, $j + 5, $j + 5 < $t)
         + term_if!($a, $base, $j + 6, $j + 6 < $t) + term_if!($a, $base, $j + 7, $j + 7 < $t))
    };
}

macro_rules! sum32_above {
    ($a:ident, $base:expr, $t:expr) => {
        (sum8_above!($a, $base, 0, $t) + sum8_above!($a, $base, 8, $t) + sum8_above!($a, $base, 16, $t)
         + sum8_above!($a, $base, 24, $t))
    };
}

macro_rules! sum32_below {
    ($a:ident, $base:expr, $t:expr) => {
        (sum8_below!($a, $base, 0, $t) + sum8_below!($a, $base, 8, $t) + sum8_below!($a, $base, 16, $t)
         + sum8_below!($a, $base, 24, $t))
    };
}

// One lane of a search for the largest bin d with (the counts of bins d and above) >= need, over 32
// counts a[$base + j] that start `over` above: the lane whose count reaches need writes its j and the
// count above it to sel[$at] and sel[$at + 1]. The search runs twice, over 32 groups of bins and then
// over the 32 bins of the group found.
macro_rules! find_lane {
    ($sel:ident, $at:expr, $a:ident, $base:expr, $t:expr, $over:expr, $need:expr) => {
        unsafe {
          let dv_above: u32 = $over + sum32_above!($a, $base, $t);
          let dv_mine: u32 = $a[$base + $t];
          if dv_above < $need && dv_above + dv_mine >= $need {
            atomic_store_u32(&$sel, $at, $t as u32, AtomicOrdering::Relaxed);
            atomic_store_u32(&$sel, $at + 1, dv_above, AtomicOrdering::Relaxed);
          }
        }
    };
}

// One position p of the pass over the scores, if $inside (p < tokens). A key above bin B sets p's bit in
// `taken`. A key of bin B is counted in h2 (and its group of 32) by its next 10 bits, and listed while the
// list has room.
macro_rules! visit {
    ($taken:ident, $h2:ident, $groups:ident, $cursor:ident, $ckey:ident, $cpos:ident, $bits:expr, $p:expr, $inside:expr,
     $bin:expr, $listed:expr) => {
        unsafe {
          if $inside {
            let dv_key: u32 = topk_key32!($bits);
            let dv_kb: u32 = dv_key >> 20u32;
            if dv_kb > $bin { set_bit!($taken, $p); }
            if dv_kb == $bin {
              let dv_d: u32 = (dv_key >> 10u32) & 1023u32;
              let _a = atomic_fetch_add_u32(&$h2, dv_d as i32, 1u32, AtomicOrdering::Relaxed);
              let _b = atomic_fetch_add_u32(&$groups, 32 + (dv_d >> 5u32) as i32, 1u32, AtomicOrdering::Relaxed);
              if $listed {
                let dv_c: u32 = atomic_fetch_add_u32(&$cursor, 0, 1u32, AtomicOrdering::Relaxed);
                if dv_c < 2048u32 {
                  atomic_store_u32(&$ckey, dv_c as i32, dv_key, AtomicOrdering::Relaxed);
                  atomic_store_i32(&$cpos, dv_c as i32, $p, AtomicOrdering::Relaxed);
                }
              }
            }
          }
        }
    };
}

// One key of bin B in the first round: with its next 10 bits above d1 it is taken, and at d1 its last 10
// bits are counted.
macro_rules! round_one {
    ($taken:ident, $h3:ident, $groups:ident, $key:expr, $p:expr, $d1:expr) => {
        unsafe {
          let dv_d: u32 = ($key >> 10u32) & 1023u32;
          if dv_d > $d1 { set_bit!($taken, $p); }
          if dv_d == $d1 {
            let dv_low: u32 = $key & 1023u32;
            let _a = atomic_fetch_add_u32(&$h3, dv_low as i32, 1u32, AtomicOrdering::Relaxed);
            let _b = atomic_fetch_add_u32(&$groups, 64 + (dv_low >> 5u32) as i32, 1u32, AtomicOrdering::Relaxed);
          }
        }
    };
}

// One key of bin B in the last round: above K it is taken, equal to K it is a tie.
macro_rules! round_two {
    ($taken:ident, $ties:ident, $key:expr, $p:expr, $key_k:expr) => {
        unsafe {
          if ($key >> 10u32) == ($key_k >> 10u32) {
            if $key > $key_k { set_bit!($taken, $p); }
            if $key == $key_k { set_bit!($ties, $p); }
          }
        }
    };
}

// Writes the positions of word w's taken bits and of its first `allowed` tie bits from slot $slot on, in
// position order, and moves $slot past them.
macro_rules! write_word {
    ($out:ident, $w:expr, $tw:expr, $ew:expr, $allowed:expr, $slot:ident) => {
        unsafe {
          let mut dv_kept: u32 = $ew;
          if $allowed < ones($ew) as i32 {
            dv_kept = 0u32;
            let mut dv_rest: u32 = $ew;
            let mut dv_i: i32 = 0;
            while dv_i < $allowed {
              let dv_low: u32 = dv_rest & !(dv_rest - 1u32);
              dv_kept = dv_kept | dv_low;
              dv_rest = dv_rest ^ dv_low;
              dv_i = dv_i + 1;
            }
          }
          let mut dv_m: u32 = $tw | dv_kept;
          while dv_m != 0u32 {
            atomic_store_i32($out, $slot, 32 * $w + low_zeros(dv_m) as i32, AtomicOrdering::Relaxed);
            $slot = $slot + 1;
            dv_m = dv_m & (dv_m - 1u32);
          }
        }
    };
}

pub fn glm_vx_spawn_topk_select_bitmap_stats_at(out_ids: &mut Tensor<i32, [?], Memory::HBM>,
                                                scores: &Tensor<i32, [?], Memory::HBM>,
                                                hist: &mut Tensor<u32, [?], Memory::HBM>,
                                                stats: &mut Tensor<u32, [?], Memory::HBM>,
                                                step: &Tensor<i32, [?], Memory::HBM>, k: i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let tokens: i32 = step[1];
      if tokens > k && k > 0 {
        let mut taken = unsafe { Tensor<u32, [2048], Memory::SMEM>::uninit() };
        let mut ties = unsafe { Tensor<u32, [2048], Memory::SMEM>::uninit() };
        let ckey = unsafe { Tensor<u32, [2048], Memory::SMEM>::uninit() };
        let cpos = unsafe { Tensor<i32, [2048], Memory::SMEM>::uninit() };
        // The 4-bin sums of hist, then each lane's taken (low 16 bits) and tie (high 16 bits) counts.
        let mut quads = unsafe { Tensor<u32, [1024], Memory::SMEM>::uninit() };
        // The counts of the two rounds, then the scans.
        let mut h2 = unsafe { Tensor<u32, [1024], Memory::SMEM>::uninit() };
        let mut h3 = unsafe { Tensor<u32, [1024], Memory::SMEM>::uninit() };
        // Sums of 32 bins: quads' at [0, 32), h2's at [32, 64) and h3's at [64, 96). The lanes' counts at
        // [96, 128).
        let mut groups = unsafe { Tensor<u32, [128], Memory::SMEM>::uninit() };
        let mut cursor = unsafe { Tensor<u32, [1], Memory::SMEM>::uninit() };
        // sel: the searches' results, each a lane j and the count above it: [0, 1] the group of quads,
        // [2, 3] the quad, [8, 9] the group of d1, [10, 11] d1, [12, 13] the group of d2, [14, 15] d2. And
        // [4] bin B, [5] its keys to take, [6] its key count, [7] 1 if the list holds them (at most 2048).
        let sel = unsafe { Tensor<u32, [16], Memory::SMEM>::uninit() };
        for l in 0..1024 across lanes {
          if l == 0 && tokens > 65536 { let _s = stop_kernel(tokens); }
          quads[l] = hist[4 * l] + hist[4 * l + 1] + hist[4 * l + 2] + hist[4 * l + 3];
          h2[l] = 0u32;
          h3[l] = 0u32;
          taken[l] = 0u32;
          taken[1024 + l] = 0u32;
          ties[l] = 0u32;
          ties[1024 + l] = 0u32;
          if l < 128 { groups[l] = 0u32; }
          if l == 0 { cursor[0] = 0u32; }
        }
        for l in 0..32 across lanes(1024) {
          groups[l] = sum32_below!(quads, 32 * l, 32);
        }
        // Bin B: its group of 32 quads, its quad, then its bin of the 4.
        for t in 0..32 across lanes(1024) { find_lane!(sel, 0, groups, 0, t, 0u32, k as u32); }
        for t in 0..32 across lanes(1024) {
          let need: u32 = k as u32;
          let group: i32 = atomic_load_u32(&sel, 0, AtomicOrdering::Relaxed) as i32;
          let c: i32 = 32 * group + t;
          let mut above: u32 = atomic_load_u32(&sel, 1, AtomicOrdering::Relaxed) + sum32_above!(quads, 32 * group, t);
          if above < need && above + quads[c] >= need {
            let h0: u32 = hist[4 * c];
            let h1: u32 = hist[4 * c + 1];
            let h2b: u32 = hist[4 * c + 2];
            let h3b: u32 = hist[4 * c + 3];
            let mut b: i32 = 4 * c + 3;
            let mut count: u32 = h3b;
            if above + h3b < need {
              above = above + h3b;
              b = 4 * c + 2;
              count = h2b;
              if above + h2b < need {
                above = above + h2b;
                b = 4 * c + 1;
                count = h1;
                if above + h1 < need {
                  above = above + h1;
                  b = 4 * c;
                  count = h0;
                }
              }
            }
            atomic_store_u32(&sel, 4, b as u32, AtomicOrdering::Relaxed);
            atomic_store_u32(&sel, 5, need - above, AtomicOrdering::Relaxed);
            atomic_store_u32(&sel, 6, count, AtomicOrdering::Relaxed);
            atomic_store_u32(&sel, 7, if count <= 2048u32 { 1u32 } else { 0u32 }, AtomicOrdering::Relaxed);
          }
        }
        // The pass over the scores, eight loads in flight a lane. It also zeroes hist for the next layer's
        // scores kernel.
        for g in 0..32 across subgroups {
          for t in 0..32 across lanes {
            let bin: u32 = sel[4];
            let listed: bool = sel[7] != 0u32;
            for j in 0..4 { hist[4 * (32 * g + t) + j] = 0u32; }
            if g == 0 && t == 0 {
              stats[0] = stats[0] + 1u32;
              if !listed { stats[1] = stats[1] + 1u32; }
              stats[2] = stats[2].max(sel[6]);
              if sel[6] > 1024u32 { stats[3] = stats[3] + 1u32; }
            }
            let last: i32 = tokens - 1;
            // Groups of 8 steps of 1024 positions: the full groups, then the rest with each position checked.
            let full: i32 = tokens / 8192;
            let mut p: i32 = 32 * g + t;
            let mut c0: i32 = scores[(p + 0).min(last)];
            let mut c1: i32 = scores[(p + 1024).min(last)];
            let mut c2: i32 = scores[(p + 2048).min(last)];
            let mut c3: i32 = scores[(p + 3072).min(last)];
            let mut c4: i32 = scores[(p + 4096).min(last)];
            let mut c5: i32 = scores[(p + 5120).min(last)];
            let mut c6: i32 = scores[(p + 6144).min(last)];
            let mut c7: i32 = scores[(p + 7168).min(last)];
            let mut i: i32 = 0;
            while i < full {
              let n0: i32 = scores[(p + 8192).min(last)];
              let n1: i32 = scores[(p + 9216).min(last)];
              let n2: i32 = scores[(p + 10240).min(last)];
              let n3: i32 = scores[(p + 11264).min(last)];
              let n4: i32 = scores[(p + 12288).min(last)];
              let n5: i32 = scores[(p + 13312).min(last)];
              let n6: i32 = scores[(p + 14336).min(last)];
              let n7: i32 = scores[(p + 15360).min(last)];
              visit!(taken, h2, groups, cursor, ckey, cpos, c0, p + 0, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c1, p + 1024, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c2, p + 2048, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c3, p + 3072, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c4, p + 4096, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c5, p + 5120, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c6, p + 6144, true, bin, listed);
              visit!(taken, h2, groups, cursor, ckey, cpos, c7, p + 7168, true, bin, listed);
              c0 = n0;
              c1 = n1;
              c2 = n2;
              c3 = n3;
              c4 = n4;
              c5 = n5;
              c6 = n6;
              c7 = n7;
              p = p + 8192;
              i = i + 1;
            }
            visit!(taken, h2, groups, cursor, ckey, cpos, c0, p + 0, p + 0 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c1, p + 1024, p + 1024 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c2, p + 2048, p + 2048 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c3, p + 3072, p + 3072 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c4, p + 4096, p + 4096 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c5, p + 5120, p + 5120 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c6, p + 6144, p + 6144 < tokens, bin, listed);
            visit!(taken, h2, groups, cursor, ckey, cpos, c7, p + 7168, p + 7168 < tokens, bin, listed);
          }
        }
        // d1: the group of 32 and then the digit, over bin B's counts.
        for t in 0..32 across lanes(1024) {
          let need: u32 = atomic_load_u32(&sel, 5, AtomicOrdering::Relaxed);
          find_lane!(sel, 8, groups, 32, t, 0u32, need);
        }
        for t in 0..32 across lanes(1024) {
          let need: u32 = atomic_load_u32(&sel, 5, AtomicOrdering::Relaxed);
          let over: u32 = atomic_load_u32(&sel, 9, AtomicOrdering::Relaxed);
          let base: i32 = 32 * (atomic_load_u32(&sel, 8, AtomicOrdering::Relaxed) as i32);
          find_lane!(sel, 10, h2, base, t, over, need);
        }
        // Round one: bin B's keys from the list, or from the scores.
        for l in 0..1024 across lanes {
          let bin: u32 = sel[4];
          let d1: u32 = 32u32 * sel[8] + sel[10];
          if sel[7] != 0u32 {
            // The list's entries l and 1024 + l, both read first.
            let n: i32 = sel[6] as i32;
            let key0: u32 = if l < n { ckey[l] } else { 0u32 };
            let pos0: i32 = if l < n { cpos[l] } else { 0 };
            let key1: u32 = if 1024 + l < n { ckey[1024 + l] } else { 0u32 };
            let pos1: i32 = if 1024 + l < n { cpos[1024 + l] } else { 0 };
            if l < n { round_one!(taken, h3, groups, key0, pos0, d1); }
            if 1024 + l < n { round_one!(taken, h3, groups, key1, pos1, d1); }
          } else {
            // Eight loads in flight a lane.
            let last: i32 = tokens - 1;
            let mut i: i32 = l;
            while i < tokens {
              let b0: i32 = scores[(i + 0).min(last)];
              let b1: i32 = scores[(i + 1024).min(last)];
              let b2: i32 = scores[(i + 2048).min(last)];
              let b3: i32 = scores[(i + 3072).min(last)];
              let b4: i32 = scores[(i + 4096).min(last)];
              let b5: i32 = scores[(i + 5120).min(last)];
              let b6: i32 = scores[(i + 6144).min(last)];
              let b7: i32 = scores[(i + 7168).min(last)];
              if i + 0 < tokens {
                let key: u32 = topk_key32!(b0);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 0, d1); }
              }
              if i + 1024 < tokens {
                let key: u32 = topk_key32!(b1);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 1024, d1); }
              }
              if i + 2048 < tokens {
                let key: u32 = topk_key32!(b2);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 2048, d1); }
              }
              if i + 3072 < tokens {
                let key: u32 = topk_key32!(b3);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 3072, d1); }
              }
              if i + 4096 < tokens {
                let key: u32 = topk_key32!(b4);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 4096, d1); }
              }
              if i + 5120 < tokens {
                let key: u32 = topk_key32!(b5);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 5120, d1); }
              }
              if i + 6144 < tokens {
                let key: u32 = topk_key32!(b6);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 6144, d1); }
              }
              if i + 7168 < tokens {
                let key: u32 = topk_key32!(b7);
                if (key >> 20u32) == bin { round_one!(taken, h3, groups, key, i + 7168, d1); }
              }
              i = i + 8192;
            }
          }
        }
        // d2, over the counts of the keys at d1.
        for t in 0..32 across lanes(1024) {
          let need: u32 = atomic_load_u32(&sel, 5, AtomicOrdering::Relaxed) - atomic_load_u32(&sel, 11, AtomicOrdering::Relaxed);
          find_lane!(sel, 12, groups, 64, t, 0u32, need);
        }
        for t in 0..32 across lanes(1024) {
          let need: u32 = atomic_load_u32(&sel, 5, AtomicOrdering::Relaxed) - atomic_load_u32(&sel, 11, AtomicOrdering::Relaxed);
          let over: u32 = atomic_load_u32(&sel, 13, AtomicOrdering::Relaxed);
          let base: i32 = 32 * (atomic_load_u32(&sel, 12, AtomicOrdering::Relaxed) as i32);
          find_lane!(sel, 14, h3, base, t, over, need);
        }
        // Round two.
        for l in 0..1024 across lanes {
          let key_k: u32 = (sel[4] << 20u32) | ((32u32 * sel[8] + sel[10]) << 10u32) | (32u32 * sel[12] + sel[14]);
          if sel[7] != 0u32 {
            let n: i32 = sel[6] as i32;
            let key0: u32 = if l < n { ckey[l] } else { 0u32 };
            let pos0: i32 = if l < n { cpos[l] } else { 0 };
            let key1: u32 = if 1024 + l < n { ckey[1024 + l] } else { 0u32 };
            let pos1: i32 = if 1024 + l < n { cpos[1024 + l] } else { 0 };
            if l < n { round_two!(taken, ties, key0, pos0, key_k); }
            if 1024 + l < n { round_two!(taken, ties, key1, pos1, key_k); }
          } else {
            // Eight loads in flight a lane.
            let last: i32 = tokens - 1;
            let mut i: i32 = l;
            while i < tokens {
              let b0: i32 = scores[(i + 0).min(last)];
              let b1: i32 = scores[(i + 1024).min(last)];
              let b2: i32 = scores[(i + 2048).min(last)];
              let b3: i32 = scores[(i + 3072).min(last)];
              let b4: i32 = scores[(i + 4096).min(last)];
              let b5: i32 = scores[(i + 5120).min(last)];
              let b6: i32 = scores[(i + 6144).min(last)];
              let b7: i32 = scores[(i + 7168).min(last)];
              if i + 0 < tokens {
                let key: u32 = topk_key32!(b0);
                round_two!(taken, ties, key, i + 0, key_k);
              }
              if i + 1024 < tokens {
                let key: u32 = topk_key32!(b1);
                round_two!(taken, ties, key, i + 1024, key_k);
              }
              if i + 2048 < tokens {
                let key: u32 = topk_key32!(b2);
                round_two!(taken, ties, key, i + 2048, key_k);
              }
              if i + 3072 < tokens {
                let key: u32 = topk_key32!(b3);
                round_two!(taken, ties, key, i + 3072, key_k);
              }
              if i + 4096 < tokens {
                let key: u32 = topk_key32!(b4);
                round_two!(taken, ties, key, i + 4096, key_k);
              }
              if i + 5120 < tokens {
                let key: u32 = topk_key32!(b5);
                round_two!(taken, ties, key, i + 5120, key_k);
              }
              if i + 6144 < tokens {
                let key: u32 = topk_key32!(b6);
                round_two!(taken, ties, key, i + 6144, key_k);
              }
              if i + 7168 < tokens {
                let key: u32 = topk_key32!(b7);
                round_two!(taken, ties, key, i + 7168, key_k);
              }
              i = i + 8192;
            }
          }
        }
        // Each lane's counts, their sums over the lanes below it in its group of 32, then over the groups.
        for l in 0..1024 across lanes {
          quads[l] = ones(taken[2 * l]) + ones(taken[2 * l + 1]) + ((ones(ties[2 * l]) + ones(ties[2 * l + 1])) << 16u32);
        }
        for g in 0..32 across subgroups {
          for t in 0..32 across lanes {
            let below: u32 = sum32_below!(quads, 32 * g, t);
            h2[32 * g + t] = below;
            if t == 31 { groups[96 + g] = below + quads[32 * g + t]; }
          }
        }
        for t in 0..32 across lanes(1024) { h3[t] = sum32_below!(groups, 96, t); }
        for g in 0..32 across subgroups {
          for t in 0..32 across lanes {
            let l: i32 = 32 * g + t;
            let left: i32 = (sel[5] - sel[11] - sel[15]) as i32;
            let before: u32 = h3[g] + h2[l];
            let mut nt: i32 = (before & 65535u32) as i32;
            let mut ne: i32 = (before >> 16u32) as i32;
            for j in 0..2 {
              let w: i32 = 2 * l + j;
              let tw: u32 = taken[w];
              let ew: u32 = ties[w];
              let mut allowed: i32 = left - ne;
              if allowed < 0 { allowed = 0; }
              let mut slot: i32 = nt + ne.min(left);
              write_word!(out_ids, w, tw, ew, allowed, slot);
              nt = nt + ones(tw) as i32;
              ne = ne + ones(ew) as i32;
            }
          }
        }
      } else {
        // hist back to zero for the next layer's scores kernel.
        for l in 0..1024 across lanes {
          for j in 0..4 { hist[4 * l + j] = 0u32; }
        }
      }
    }
  }
  return;
}
