// glm_vx_spawn_iq_rows_prefill (#63, item 5b): the DSA indexer's queries of a prefill chunk, RoPE'd: q_out[t][h] is
// iq[t]'s head h with its first rot values rotated by token t's cos and sin (steps[t]) in glm_vx_gpu_rope_strided's
// packed order and the rest as they are: what _index_core's copy then rope_strided give one token.
// spawn-include: device.vx

pub fn glm_vx_spawn_iq_rows_prefill(q_out: &mut Tensor<f32, [?, ?, ?], Memory::HBM>, iq: &Tensor<f32, [?, ?], Memory::HBM>,
                                    steps: &Tensor<f32, [?, ?], Memory::HBM>, rows: i32, heads: i32, dim: i32, rot: i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..rows across blocks {
      for h in 0..heads across blocks {
        for d in 0..dim across lanes(128) {
          let pairs: i32 = rot / 2;
          let mut v: f32 = iq[t][h * dim + d];
          if d < rot && pairs > 0 && rot % 2 == 0 {
            let p: i32 = d % pairs;
            let a0: f32 = iq[t][h * dim + p * 2];
            let b0: f32 = iq[t][h * dim + p * 2 + 1];
            let c: f32 = steps[t][p];
            let s: f32 = steps[t][pairs + p];
            v = a0 * c - b0 * s;
            if d >= pairs { v = b0 * c + a0 * s; }
          }
          q_out[t][h][d] = v;
        }
      }
    }
  }
  return;
}
