// glm_vx_gpu_rmsnorm_rows (and glm_vx_gpu_rmsnorm, which is rows = 1) through Vx's own GPU
// path. One block per row: out = x / sqrt(mean(x^2) + eps) * weight, with a correctly rounded
// sqrt (needs Vx #1944) and the summation order of the hand kernel launched with `threads`
// threads (a multiple of 32 in [32, 1024]): thread t's partial over d = t, t + threads, ..,
// then device.vx's block_sum. out is [rows, dim].
// spawn-include: device.vx

pub fn glm_vx_spawn_rmsnorm_rows(out: &mut Tensor<f32, [?, ?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                 weight: &Tensor<f32, [?], Memory::HBM>, rows: i32, dim: i32, eps: f32,
                                 threads: i32) -> void {
  spawn on(Topology::Device) {
    for row in 0..rows across blocks {
      if dim > 0 && eps > 0.0 && threads >= 32 && threads <= 1024 && threads % 32 == 0 {
        let mut a = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
        let mut b = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
        let base: i32 = row * dim;
        for t in 0..1024 across lanes {
          let mut ss: f32 = 0.0;
          if t < threads {
            let mut d: i32 = t;
            while d < dim { ss = ss + x[base + d] * x[base + d]; d = d + threads; }
          }
          a[t] = ss;
        }
        block_sum!(b, a, threads);
        for d in 0..dim across lanes(256) {
          let inv: f32 = 1.0 / (b[0] / (dim as f32) + eps).sqrt();
          out[row][d] = x[base + d] * inv * weight[d];
        }
      }
    }
  }
  return;
}
