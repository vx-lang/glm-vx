// glm_vx_gpu_rmsnorm_rows (and glm_vx_gpu_rmsnorm, which is rows = 1) through Vx's own GPU
// path. One block per row: out = x / sqrt(mean(x^2) + eps) * weight, with a correctly rounded
// sqrt (needs Vx #1944) and the hand kernel's summation order.
// spawn-include: device.vx

pub fn glm_vx_spawn_rmsnorm_rows(out: &mut Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                 weight: &Tensor<f32, [?], Memory::HBM>, rows: i32, dim: i32, eps: f32) -> void {
  spawn on(Topology::Device) grid([rows]) block(256) {
    let mut shared = unsafe { Tensor<f32, [33], Memory::SMEM>::uninit() };
    let tid: i32 = thread_id();
    let block: i32 = block_dim();
    let row: i32 = block_id();
    // Uniform per block, so every thread of a running block reaches the barriers.
    if rows > 0 && dim > 0 && eps > 0.0 && row < rows && block >= 32 && block <= 1024 && block % 32 == 0 {
      let base: i32 = row * dim;
      let mut ss: f32 = 0.0;
      let mut d: i32 = tid;
      while d < dim { ss = ss + x[base + d] * x[base + d]; d = d + block; }
      let total: f32 = block_sum(ss, &mut shared);
      let inv: f32 = 1.0 / (total / (dim as f32) + eps).sqrt();
      d = tid;
      while d < dim { out[base + d] = x[base + d] * inv * weight[d]; d = d + block; }
    }
  }
  return;
}
