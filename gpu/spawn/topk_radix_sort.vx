// The stable top-k past 2048 tokens by radix select (#32), step 2 of 2, after round 8 of
// topk_radix_pass.vx: vals holds the min(k, tokens) selected values (the key above the position
// reversed), in an order that depends on timing. One block of 1024 lanes sorts them, descending,
// as topk_sort.vx does (the padding is the smallest i64), and writes their positions to out_ids:
// the first min(k, tokens) of np.argsort(-scores, kind='stable'), the same on every run. Then it
// sets count and hists ([8 * 256]) back to zero for the next call. k <= 2048.
// spawn-include: device.vx

// One compare-exchange of stage st of the descending bitonic sort, at position i of src.
macro_rules! bitonic_stage {
    ($src:ident, $i:expr, $st:expr, $stages:expr) => {
        unsafe {
          let dv_i: i32 = $i;
          let dv_st: i32 = $st;
          let dv_x: i64 = $src[dv_i];
          let mut dv_value: i64 = dv_x;
          if dv_st < $stages {
            let mut dv_m: i32 = 1;
            let mut dv_before: i32 = 0;
            while dv_before + dv_m <= dv_st { dv_before = dv_before + dv_m; dv_m = dv_m + 1; }
            let dv_size: i32 = 1 << dv_m;
            let dv_d: i32 = dv_size >> (dv_st - dv_before + 1);
            let dv_y: i64 = $src[dv_i ^ dv_d];
            let mut dv_larger: i64 = dv_x;
            let mut dv_smaller: i64 = dv_y;
            if dv_y > dv_x { dv_larger = dv_y; dv_smaller = dv_x; }
            dv_value = dv_smaller;
            if ((dv_i & dv_d) == 0) == ((dv_i & dv_size) == 0) { dv_value = dv_larger; }
          }
          dv_value
        }
    };
}

pub fn glm_vx_spawn_topk_radix_sort(out_ids: &mut Tensor<i32, [?], Memory::HBM>, vals: &Tensor<i64, [?], Memory::HBM>,
                                    count: &mut Tensor<u32, [?], Memory::HBM>, hists: &mut Tensor<u32, [?], Memory::HBM>,
                                    tokens: i32, k: i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut order_a = unsafe { Tensor<i64, [2048], Memory::SMEM>::uninit() };
      let mut order_b = unsafe { Tensor<i64, [2048], Memory::SMEM>::uninit() };
      for i in 0..2048 across lanes(1024) {
        let mut value: i64 = -9223372036854775807 - 1;
        if i < k.min(tokens) { value = vals[i]; }
        order_a[i] = value;
        hists[i] = 0u32;
      }
      // 2048 = 2^11: 66 stages.
      for round in 0..33 {
        for i in 0..2048 across lanes(1024) { order_b[i] = bitonic_stage!(order_a, i, round * 2, 66); }
        for i in 0..2048 across lanes(1024) { order_a[i] = bitonic_stage!(order_b, i, round * 2 + 1, 66); }
      }
      for r in 0..k.min(tokens).min(2048) across lanes(1024) { out_ids[r] = (4294967295 - (order_a[r] & 4294967295)) as i32; }
      for t in 0..1 across lanes(1024) { if b == 0 { count[0] = 0u32; } }
    }
  }
  return;
}
