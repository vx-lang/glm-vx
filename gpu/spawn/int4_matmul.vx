// glm_vx_gpu_int4_matmul through Vx's own GPU path: batched and grouped INT4 group-128
// projection, out[m, n] = sum_k W_e[n, k] * x[m, k]. experts == 0: packed[N, ceil(K/2)] and
// scales[N, ceil(K/128)] for all rows; experts > 0: stacked [E, ...] and expert_ids[M] picks
// each row's expert, an id outside [0, E) writing zeros. One warp per (n, m) task, n-major;
// each group's raw-code dot product is summed before its scale, as int4_matvec.
// spawn-include: device.vx

pub fn glm_vx_spawn_int4_matmul(out: &mut Tensor<f32, [?], Memory::HBM>, packed: &Tensor<u8, [?], Memory::HBM>,
                                scales: &Tensor<u16, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                expert_ids: &Tensor<i32, [?], Memory::HBM>, rows_m: i32, rows_n: i32, cols: i32,
                                experts: i32, scale_kind: i32) -> void {
  spawn on(Topology::Device) {
    let tid: i32 = thread_id();
    let lane: i32 = tid & 31;
    let block: i32 = block_dim();
    let warps: i32 = block / 32;
    let task: i64 = (block_id() as i64) * (warps as i64) + ((tid / 32) as i64);
    if rows_m > 0 && rows_n > 0 && cols >= 0 && experts >= 0 && block >= 32 && block <= 1024 && block % 32 == 0
       && task < (rows_m as i64) * (rows_n as i64) {
      let m_count: i64 = rows_m as i64;
      let n_count: i64 = rows_n as i64;
      let n: i64 = task / m_count;
      let m: i64 = task % m_count;
      let k: i64 = cols as i64;
      let groups: i64 = (k + 127) / 128;
      let row_bytes: i64 = (k + 1) / 2;
      let mut expert: i64 = 0;
      let mut valid: i32 = 1;
      if experts > 0 {
        let id: i32 = expert_ids[m];
        if id < 0 { valid = 0; }
        if id >= experts { valid = 0; }
        expert = id as i64;
      }
      let mut sum: f32 = 0.0;
      if valid != 0 {
        let row: i64 = expert * n_count + n;
        let mut group: i64 = 0;
        while group < groups {
          let scale: f32 = group_scale(scales[row * groups + group] as i32, scale_kind);
          let mut part: f32 = 0.0;
          let mut step: i32 = 0;
          while step < 2 {
            let byte_index: i64 = group * 64 + ((step * 32 + lane) as i64);
            let col: i64 = byte_index * 2;
            if col < k {
              let byte: i32 = packed[row * row_bytes + byte_index] as i32;
              part = part + int4_code(byte, 0) * x[m * k + col];
              if col + 1 < k { part = part + int4_code(byte, 1) * x[m * k + col + 1]; }
            }
            step = step + 1;
          }
          sum = sum + part * scale;
          group = group + 1;
        }
      }
      let total: f32 = warp_sum(sum);
      if lane == 0 { out[m * n_count + n] = total; }
    }
  }
  return;
}
