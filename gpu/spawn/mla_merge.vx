// glm_vx_gpu_mla_merge through Vx's own GPU path: the stable merge of the online-softmax
// partitions mla_partial writes, one block per head and a lane per latent element. exp is
// f32::fast_exp (see sigmoid in device.vx). out is [heads, rank].
// spawn-include: device.vx

pub fn glm_vx_spawn_mla_merge(out: &mut Tensor<f32, [?, ?], Memory::HBM>, numerator: &Tensor<f32, [?], Memory::HBM>,
                              stats: &Tensor<f32, [?], Memory::HBM>, heads: i32, rank: i32, splits: i32) -> void {
  spawn on(Topology::Device) {
    for h in 0..heads across blocks {
      for d in 0..rank across lanes(256) {
        if splits > 0 {
          let mut m: f32 = 0.0;
          let mut seen: i32 = 0;
          let mut s: i32 = 0;
          while s < splits {
            let task: i32 = h * splits + s;
            if stats[task * 2 + 1] > 0.0 {
              let v: f32 = stats[task * 2];
              if seen == 0 { m = v; seen = 1; }
              else { if v > m { m = v; } }
            }
            s = s + 1;
          }
          let mut sum: f32 = 0.0;
          let mut denominator: f32 = 0.0;
          let mut t: i32 = 0;
          while t < splits {
            let task: i32 = h * splits + t;
            let l: f32 = stats[task * 2 + 1];
            if l > 0.0 {
              let factor: f32 = (stats[task * 2] - m).fast_exp();
              sum = sum + numerator[task * rank + d] * factor;
              denominator = denominator + l * factor;
            }
            t = t + 1;
          }
          let mut result: f32 = 0.0;
          if denominator > 0.0 { result = sum / denominator; }
          out[h][d] = result;
        }
      }
    }
  }
  return;
}
