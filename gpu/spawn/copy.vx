// glm_vx_gpu_copy through Vx's own GPU path: out[i] = x[i] for i < n, grid-stride.
// spawn-include: device.vx

pub fn glm_vx_spawn_copy(out: &mut Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>, n: i32) -> void {
  spawn on(Topology::Device) {
    let stride: i32 = grid_dim() * block_dim();
    let mut i: i32 = block_id() * block_dim() + thread_id();
    while i < n {
      out[i] = x[i];
      i = i + stride;
    }
  }
  return;
}
