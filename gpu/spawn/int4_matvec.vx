// glm_vx_gpu_int4_matvec through Vx's own GPU path. Group-128 symmetric INT4 codes, two per
// byte (element 2i in the low nibble), one raw 16-bit scale per (row, group): binary16 for
// scale_kind 0, bfloat16 for 1. One warp per row; each 128-column group is 64 bytes, lane
// reads bytes lane and lane+32, sums the raw-code dot product, then applies the group scale,
// the order the hand kernel and glm_vx/quant.py use.
// spawn-include: device.vx
// spawn-kernel: glm_vx_spawn_int4_matvec(rows: i32, cols: i32, scales: u16[?], scale_kind: i32, packed: u8[?], x: f32[?], out: mut f32[?])

// IEEE binary16 bits to f32, exact for every encoding: gpu/int4.vx's glm_vx_i4_half.
fn half_decode(bits: i32) on Topology::Device -> f32 {
  let exponent: i32 = (bits >> 10) & 31;
  let mantissa: i32 = bits & 1023;
  let mut magnitude: f32 = (mantissa as f32) / 16777216.0;
  if exponent > 0 {
    let mut power: f32 = 1.0;
    if exponent >= 15 { power = ((1 << (exponent - 15)) as f32); }
    if exponent < 15 { power = 1.0 / ((1 << (15 - exponent)) as f32); }
    magnitude = ((1024 + mantissa) as f32) * power / 1024.0;
  }
  if exponent == 31 {
    if mantissa == 0 { magnitude = 1.0 / 0.0; }
    if mantissa != 0 { magnitude = 0.0 / 0.0; }
  }
  let mut sign: f32 = 1.0;
  if (bits & 32768) != 0 { sign = -1.0; }
  return magnitude * sign;
}

fn group_scale(bits: i32, kind: i32) on Topology::Device -> f32 {
  let mut scale: f32 = 0.0;
  if kind != 0 { scale = bf16_decode(bits); } else { scale = half_decode(bits); }
  return scale;
}

// Signed 4-bit code: high 0 is the low nibble, 1 the high nibble.
fn int4_code(byte: i32, high: i32) on Topology::Device -> f32 {
  let mut nibble: i32 = byte & 15;
  if high != 0 { nibble = (byte >> 4) & 15; }
  if nibble >= 8 { nibble = nibble - 16; }
  return nibble as f32;
}

pub fn int4_matvec(out: &mut Tensor<f32, [?], Memory::HBM>, packed: &Tensor<u8, [?], Memory::HBM>,
                   scales: &Tensor<u16, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                   rows: i32, cols: i32, scale_kind: i32) -> void {
  spawn on(Topology::Device) {
    let tid: i32 = thread_id();
    let lane: i32 = tid & 31;
    let block: i32 = block_dim();
    let warps: i32 = block / 32;
    let row: i64 = (block_id() as i64) * (warps as i64) + ((tid / 32) as i64);
    if rows > 0 && cols >= 0 && block >= 32 && block <= 1024 && block % 32 == 0 && row < (rows as i64) {
      let k: i64 = cols as i64;
      let groups: i64 = (k + 127) / 128;
      let row_bytes: i64 = (k + 1) / 2;
      let mut sum: f32 = 0.0;
      let mut group: i64 = 0;
      while group < groups {
        let scale: f32 = group_scale(scales[row * groups + group] as i32, scale_kind);
        let mut part: f32 = 0.0;
        let mut step: i32 = 0;
        while step < 2 {
          let byte_index: i64 = group * 64 + ((step * 32 + lane) as i64);
          let col: i64 = byte_index * 2;
          if col < k {
            let byte: i32 = packed[row * row_bytes + byte_index] as i32;
            part = part + int4_code(byte, 0) * x[col];
            if col + 1 < k { part = part + int4_code(byte, 1) * x[col + 1]; }
          }
          step = step + 1;
        }
        sum = sum + part * scale;
        group = group + 1;
      }
      let total: f32 = warp_sum(sum);
      if lane == 0 { out[row] = total; }
    }
  }
  return;
}
