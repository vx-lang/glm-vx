// glm_vx_gpu_swiglu through Vx's own GPU path: out = silu(gate) * up, a lane per element, with
// the hand kernel's two-branch sigmoid (exp argument never positive; device.vx).
// spawn-include: device.vx

pub fn glm_vx_spawn_swiglu(out: &mut Tensor<f32, [?], Memory::HBM>, gate: &Tensor<f32, [?], Memory::HBM>,
                           up: &Tensor<f32, [?], Memory::HBM>, n: i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..(n - 1) / 256 + 1 across blocks {
      for t in 0..256 across lanes {
        let i: i32 = blk * 256 + t;
        if i < n {
          let g: f32 = gate[i];
          out[i] = g * sigmoid!(g) * up[i];
        }
      }
    }
  }
  return;
}
