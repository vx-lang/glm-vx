// glm_vx_spawn_argmax_pair: a tensor-parallel rank's share of greedy decoding (#63). out[0] = the largest
// of x[0 .. dim], out[1] = offset + its index (the first on a tie) as float32 bits, so the ranks gather one
// pair each in place of the vocabulary's logits and take the largest pair, the lower rank on a tie: the
// index numpy.argmax gives on the whole vocabulary when no logit is NaN. One block: lane t < threads keeps
// the first largest of d = t, t + threads, .., then lanes::argmax combines the lanes (an empty lane, id -1,
// never wins; then the larger value; on a tie the lower id), as argmax_rows. A NaN never compares larger,
// so it is chosen only as x[0] with nothing larger after it. A bad dim or threads writes NaN and -1.
// spawn-include: device.vx

pub extern fn glm_vx_spawn_argmax_pair(out: &mut Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                       dim: i32, offset: i32, threads: i32) -> void {
  spawn on(Topology::Device) {
    for block in 0..1 across blocks {
      if dim > 0 && threads >= 32 && threads <= 1024 && threads % 32 == 0 {
        let mut sa = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
        let mut ia = unsafe { Tensor<i32, [1024], Memory::SMEM>::uninit() };
        for t in 0..1024 across lanes {
          let mut best_index: i32 = -1;
          let mut best: f32 = 0.0;
          if t < threads {
            let mut d: i32 = t;
            while d < dim {
              let value: f32 = x[d];
              if best_index < 0 { best_index = d; best = value; }
              else { if value > best { best_index = d; best = value; } }
              d = d + threads;
            }
          }
          sa[t] = best;
          ia[t] = best_index;
        }
        let chosen: i32 = lanes::argmax(&sa, &ia, threads);
        for t in 0..1 across lanes {
          out[block * 2] = x[chosen];
          out[block * 2 + 1] = f32::from_bits((chosen + offset) as u32);
        }
      } else {
        for t in 0..1 across lanes {
          out[block * 2] = f32::from_bits(2143289344u32);
          out[block * 2 + 1] = f32::from_bits(4294967295u32);
        }
      }
    }
  }
  return;
}
