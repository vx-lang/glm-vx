// glm_vx_spawn_moe_group_place (#63, item 5b): Vx's std::nn nn_moe_group_place: order[g] = the pair p at grouped row g,
// each expert's pairs in the order of p (pair p is slot p % kk of token p / kk).
// spawn-include: device.vx
// spawn-vxc: -fweak-relaxed-atomics
import core::sync::atomic;

pub extern fn glm_vx_spawn_moe_group_place(order : &mut Tensor<i32, [?], Memory::HBM>, ids : &Tensor<i32, [?], Memory::HBM>, base : &Tensor<i32, [?, ?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      let mut keys = unsafe { Tensor<i32, [256], Memory::SMEM>::uninit() };
      for l in 0..256 across lanes {
        let p = b * 256 + l;
        let mut id = -1;
        if p < n {
          id = ids[p];
        }
        keys[l] = id;
      }
      for l in 0..256 across lanes {
        let p = b * 256 + l;
        if p < n {
          let id = keys[l];
          let mut rank = 0;
          for j in 0..l {
            if keys[j] == id {
              rank = rank + 1;
            }
          }
          atomic_store_i32(order, base[b][id] + rank, p, AtomicOrdering::Relaxed);
        }
      }
    }
  }
  return;
}
