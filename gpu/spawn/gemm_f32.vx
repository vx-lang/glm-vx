// glm_vx_gpu_gemm_f32 through Vx's own GPU path: out[m, n] = a[m, k] b[k, n] in full f32, one
// lane per output: a block per row (grid-stride), 128 lanes over its columns. out is [m, n].
// spawn-include: device.vx

pub fn glm_vx_spawn_gemm_f32(out: &mut Tensor<f32, [?, ?], Memory::HBM>, a: &Tensor<f32, [?], Memory::HBM>,
                             b: &Tensor<f32, [?], Memory::HBM>, m: i32, n: i32, k: i32) -> void {
  spawn on(Topology::Device) {
    for row in 0..m across blocks {
      for col in 0..n across lanes(128) {
        let kk: i64 = k as i64;
        let mut sum: f32 = 0.0;
        let mut q: i64 = 0;
        while q < kk {
          sum = sum + a[(row as i64) * kk + q] * b[q * (n as i64) + (col as i64)];
          q = q + 1;
        }
        out[row][col] = sum;
      }
    }
  }
  return;
}
