// glm_vx_gpu_index_scores through Vx's own GPU path: DSA index scores, one warp of 32 lanes per
// token (four per block) and all heads in one launch. score = sum_h weights[h] *
// relu(dot(q_h, key) * scale); the caller supplies causal keys and weights already scaled by
// heads**-0.5. Each head is a warp sum (device.vx), then one lane per token adds its term.
// spawn-include: device.vx

pub fn glm_vx_spawn_index_scores(out: &mut Tensor<f32, [?], Memory::HBM>, q: &Tensor<f32, [?], Memory::HBM>,
                                 keys: &Tensor<f32, [?], Memory::HBM>, weights: &Tensor<f32, [?], Memory::HBM>,
                                 tokens: i32, heads: i32, dim: i32, scale: f32) -> void {
  spawn on(Topology::Device) {
    for tb in 0..(tokens - 1) / 4 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      let mut b = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      let mut score = unsafe { Tensor<f32, [4], Memory::SMEM>::uninit() };
      for w in 0..4 across lanes { score[w] = 0.0; }
      for head in 0..heads {
        for w in 0..4 across lanes { for lane in 0..32 across lanes {
          let token: i32 = tb * 4 + w;
          let mut dot: f32 = 0.0;
          if token < tokens {
            let mut d: i32 = lane;
            while d < dim {
              dot = dot + q[head * dim + d] * keys[token * dim + d];
              d = d + 32;
            }
          }
          a[w * 32 + lane] = dot;
        } }
        warp_sums!(b, a, 4);
        for w in 0..4 across lanes {
          let scaled: f32 = b[w * 32] * scale;
          let mut activated: f32 = scaled;
          if activated < 0.0 { activated = 0.0; }
          score[w] = score[w] + weights[head] * activated;
        }
      }
      for w in 0..4 across lanes {
        if tb * 4 + w < tokens && heads > 0 && dim > 0 { out[tb * 4 + w] = score[w]; }
      }
    }
  }
  return;
}
