// The multi-block top-k for long contexts (#32), launch 2 of 2 (after topk_mb_list_at): warp w of block b
// reads its 256 positions again, in order, and writes each taken position p at slot (keys above K before
// p) + min(keys equal to K before p, left), from its first slot in offs (offs[w], offs[4096 + w]) and K and
// left in sel, by vote.ballot and %lanemask_lt (topk_common.vx's place!). The last block to finish
// zeroes hist, the scores' bins, for the next layer's scores kernel; tokens <= k writes nothing else.
// Scores arrive as raw float32 bits in an i32 tensor. GPU only (inline PTX in mlir! blocks).
// spawn-include: ../device.vx
// spawn-include: topk_common.vx
// spawn-vxc: -fweak-relaxed-atomics

pub fn glm_vx_spawn_topk_mb_write_at(out_ids: &Tensor<i32, [?], Memory::HBM>, scores: &Tensor<i32, [?], Memory::HBM>,
                                     hist: &mut Tensor<u32, [?], Memory::HBM>, offs: &Tensor<i32, [?], Memory::HBM>,
                                     sel: &Tensor<u32, [?], Memory::HBM>, step: &Tensor<i32, [?], Memory::HBM>,
                                     max_tokens: i32, k: i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(max_tokens + 8191) / 8192 across blocks {
      for g in 0..32 across subgroups {
        for t in 0..32 across lanes {
          let tokens: i32 = step[1];
          if tokens > k && k > 0 {
            let key_k: u32 = sel[0];
            let left: i32 = sel[1] as i32;
            let last: i32 = tokens - 1;
            let w: i32 = b * 32 + g;
            let mut na: i32 = 0;
            let mut nt: i32 = 0;
            if w * 256 < tokens {
              na = offs[w];
              nt = offs[4096 + w];
            }
            for s in 0..2 {
              let p: i32 = w * 256 + s * 128 + t;
              let b0: i32 = scores[p.min(last)];
              let b1: i32 = scores[(p + 32).min(last)];
              let b2: i32 = scores[(p + 64).min(last)];
              let b3: i32 = scores[(p + 96).min(last)];
              let r0: i32 = place!(out_ids, b0, p, tokens, key_k, left, na, nt);
              na = na + (r0 & 65535); nt = nt + (r0 >> 16);
              let r1: i32 = place!(out_ids, b1, p + 32, tokens, key_k, left, na, nt);
              na = na + (r1 & 65535); nt = nt + (r1 >> 16);
              let r2: i32 = place!(out_ids, b2, p + 64, tokens, key_k, left, na, nt);
              na = na + (r2 & 65535); nt = nt + (r2 >> 16);
              let r3: i32 = place!(out_ids, b3, p + 96, tokens, key_k, left, na, nt);
              na = na + (r3 & 65535); nt = nt + (r3 >> 16);
            }
          }
        }
      }
    }
    // The last block to finish: hist back to zero.
    for l in 0..1024 across lanes {
      for j in 0..4 { hist[4 * l + j] = 0u32; }
    }
  }
  return;
}
