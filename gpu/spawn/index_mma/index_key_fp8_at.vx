// Generated by gen_index_mma.py: the indexer key row at step[0] (f32, from index_key_at or store_row) to
// FP8 E4M3 codes and a scale, for index_scores_fp8_at (#32), as SGLang 0.5.22's indexer_k.cuh does:
// each value rounded to bf16, scale = max(1e-4, amax) / 448, codes = e4m3(x * (1 / scale)), round to
// nearest, saturating. One warp; codes [max_tokens, 32] holds a row's 128 codes as 32 words.
// Needs dim == 128; otherwise it writes nothing.
// spawn-include: ../device.vx

fn address1(t: &Tensor<f32, [?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<?xf32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?xf32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

fn address2(t: &Tensor<f32, [?, ?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<?x?xf32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?x?xf32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

fn address2i(t: &Tensor<i32, [?, ?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<?x?xi32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?x?xi32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

fn index_key_fp8_lane(k: i64) on Topology::Device -> i64
ensures writes_only()
{
  // One lane's 4 dims at the byte address k to e4m3 codes, with the warp's amax by shfl.sync.bfly.
  // The result is the 4 codes (lower dim in the lower byte) | the scale's bits << 32.
  return mlir!( inputs : (%k = k : i64), returns : i64, dialects : ["llvm", "nvvm"], ensures : [writes_only()]) {
    %p = llvm.inttoptr %k : i64 to !llvm.ptr<1>
    %x = llvm.load %p {alignment = 16 : i64} : !llvm.ptr<1> -> vector<4xf32>
    %all = llvm.mlir.constant(-1 : i32) : i32
    %clamp = llvm.mlir.constant(31 : i32) : i32
    %i0 = llvm.mlir.constant(0 : i32) : i32
    %e0 = llvm.extractelement %x[%i0 : i32] : vector<4xf32>
    %h0 = llvm.fptrunc %e0 : f32 to bf16
    %x0 = llvm.fpext %h0 : bf16 to f32
    %a0 = llvm.call_intrinsic "llvm.fabs.f32"(%x0) : (f32) -> f32
    %i1 = llvm.mlir.constant(1 : i32) : i32
    %e1 = llvm.extractelement %x[%i1 : i32] : vector<4xf32>
    %h1 = llvm.fptrunc %e1 : f32 to bf16
    %x1 = llvm.fpext %h1 : bf16 to f32
    %a1 = llvm.call_intrinsic "llvm.fabs.f32"(%x1) : (f32) -> f32
    %i2 = llvm.mlir.constant(2 : i32) : i32
    %e2 = llvm.extractelement %x[%i2 : i32] : vector<4xf32>
    %h2 = llvm.fptrunc %e2 : f32 to bf16
    %x2 = llvm.fpext %h2 : bf16 to f32
    %a2 = llvm.call_intrinsic "llvm.fabs.f32"(%x2) : (f32) -> f32
    %i3 = llvm.mlir.constant(3 : i32) : i32
    %e3 = llvm.extractelement %x[%i3 : i32] : vector<4xf32>
    %h3 = llvm.fptrunc %e3 : f32 to bf16
    %x3 = llvm.fpext %h3 : bf16 to f32
    %a3 = llvm.call_intrinsic "llvm.fabs.f32"(%x3) : (f32) -> f32
    %m0 = llvm.intr.maxnum(%a0, %a1) : (f32, f32) -> f32
    %m1 = llvm.intr.maxnum(%m0, %a2) : (f32, f32) -> f32
    %m2 = llvm.intr.maxnum(%m1, %a3) : (f32, f32) -> f32
    %o16 = llvm.mlir.constant(16 : i32) : i32
    %t16 = nvvm.shfl.sync bfly %all, %m2, %o16, %clamp : f32 -> f32
    %n16 = llvm.intr.maxnum(%m2, %t16) : (f32, f32) -> f32
    %o8 = llvm.mlir.constant(8 : i32) : i32
    %t8 = nvvm.shfl.sync bfly %all, %n16, %o8, %clamp : f32 -> f32
    %n8 = llvm.intr.maxnum(%n16, %t8) : (f32, f32) -> f32
    %o4 = llvm.mlir.constant(4 : i32) : i32
    %t4 = nvvm.shfl.sync bfly %all, %n8, %o4, %clamp : f32 -> f32
    %n4 = llvm.intr.maxnum(%n8, %t4) : (f32, f32) -> f32
    %o2 = llvm.mlir.constant(2 : i32) : i32
    %t2 = nvvm.shfl.sync bfly %all, %n4, %o2, %clamp : f32 -> f32
    %n2 = llvm.intr.maxnum(%n4, %t2) : (f32, f32) -> f32
    %o1 = llvm.mlir.constant(1 : i32) : i32
    %t1 = nvvm.shfl.sync bfly %all, %n2, %o1, %clamp : f32 -> f32
    %n1 = llvm.intr.maxnum(%n2, %t1) : (f32, f32) -> f32
    %floor = llvm.mlir.constant(1.0e-4 : f32) : f32
    %c448 = llvm.mlir.constant(448.0 : f32) : f32
    %one = llvm.mlir.constant(1.0 : f32) : f32
    %amax = llvm.intr.maxnum(%n1, %floor) : (f32, f32) -> f32
    %s = llvm.fdiv %amax, %c448 : f32
    %inv = llvm.call_intrinsic "llvm.nvvm.div.rn.f"(%one, %s) : (f32, f32) -> f32
    %y0 = llvm.fmul %x0, %inv : f32
    %y1 = llvm.fmul %x1, %inv : f32
    %y2 = llvm.fmul %x2, %inv : f32
    %y3 = llvm.fmul %x3, %inv : f32
    %q0 = nvvm.convert.f32x2.to.f8x2 %y1, %y0 {rnd = #nvvm.fp_rnd_mode<rn>, sat = #nvvm.sat_mode<satfinite>} : i16 (f8E4M3FN)
    %q1 = nvvm.convert.f32x2.to.f8x2 %y3, %y2 {rnd = #nvvm.fp_rnd_mode<rn>, sat = #nvvm.sat_mode<satfinite>} : i16 (f8E4M3FN)
    %u0 = llvm.mlir.poison : vector<2xi16>
    %u1 = llvm.insertelement %q0, %u0[%i0 : i32] : vector<2xi16>
    %u2 = llvm.insertelement %q1, %u1[%i1 : i32] : vector<2xi16>
    %w = llvm.bitcast %u2 : vector<2xi16> to i32
    %sb = llvm.bitcast %s : f32 to i32
    %v0 = llvm.mlir.poison : vector<2xi32>
    %v1 = llvm.insertelement %w, %v0[%i0 : i32] : vector<2xi32>
    %v2 = llvm.insertelement %sb, %v1[%i1 : i32] : vector<2xi32>
    %r = llvm.bitcast %v2 : vector<2xi32> to i64
    macro.yield %r : i64
  };
}

pub fn glm_vx_spawn_index_key_fp8_at(codes: &mut Tensor<i32, [?, ?], Memory::HBM>, scales: &mut Tensor<f32, [?], Memory::HBM>,
                                     keys: &Tensor<f32, [?, ?], Memory::HBM>, step: &Tensor<i32, [?], Memory::HBM>,
                                     max_tokens: i32, dim: i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for lane in 0..32 across lanes {
        let pos: i32 = step[0];
        if dim == 128 && pos >= 0 && pos < max_tokens {
          let v: i64 = index_key_fp8_lane(address2(keys) + ((pos as i64) * 128 + 4 * (lane as i64)) * 4);
          codes[pos][lane] = (v & 4294967295) as i32;
          if lane == 0 { scales[pos] = f32::from_bits(((v >> 32) & 4294967295) as u32); }
        }
      }
    }
  }
  return;
}
