// Generated by gen_index_mma.py: index_scores_mma_at over bf16 key rows (index_key_bf16_at's words
// [max_tokens, 64]: half the bytes, the same scores bit for bit). The indexer's scores on the tensor cores (#32), a warp's work one
// mlir! block of llvm and nvvm ops; the layout is in the generator's docstring. Needs heads == 32 and dim == 128, keys with max_tokens
// rows; otherwise it writes nothing. A block of 4 warps takes 128 tokens.
// With hist: the top-k's first pass folded in (gen_index_mma.py's HIST_HELPERS): hist[4096]
// counts the keys' top 12 bits for topk_select_ilp_hist_at, which zeroes it after use.
// spawn-include: ../device.vx
// spawn-vxc: -fweak-relaxed-atomics
import core::sync::atomic;

// Order-preserving map from float32 bits to [0, 2^32), as topk_select_at's: bigger key == bigger score;
// NaN is 0, and -0.0 is +0.0's key.
macro_rules! topk_key32 {
    ($bits:expr) => {
        unsafe {
          let dv_b: u32 = $bits as u32;
          let mut dv_key: u32 = dv_b ^ 2147483648u32;
          if dv_b >= 2147483648u32 { dv_key = 4294967295u32 - dv_b; }
          if dv_b == 2147483648u32 { dv_key = 2147483648u32; }
          if (dv_b & 2147483647u32) > 2139095040u32 { dv_key = 0u32; }
          dv_key
        }
    };
}

// The lanes of this warp whose x equals this lane's (match.any.sync); all 32 lanes must call it.
fn match_any(x: i32) on Topology::Device -> i32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%x = x : i32), returns : i32, dialects : ["llvm", "nvvm"], ensures : [writes_only()]) {
    %all = llvm.mlir.constant(-1 : i32) : i32
    %r = nvvm.match.sync any %all, %x : i32 -> i32
    macro.yield %r : i32
  } };
}

fn popc(x: i32) on Topology::Device -> i32
ensures writes_only()
{
  return unsafe { mlir!( inputs : (%x = x : i32), returns : i32, dialects : ["llvm"], ensures : [writes_only()]) {
    %r = llvm.intr.ctpop(%x) : (i32) -> i32
    macro.yield %r : i32
  } };
}

fn address1(t: &Tensor<f32, [?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?xf32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?xf32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

fn address2i(t: &Tensor<i32, [?, ?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?x?xi32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?x?xi32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

fn address2(t: &Tensor<f32, [?, ?], Memory::HBM>) on Topology::Device -> i64
ensures reads_only(t)
{
  return unsafe { mlir!( inputs : (%t = t : memref<?x?xf32>), returns : i64, dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<?x?xf32> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  } };
}

// One lane's part of a warp's 32 scores (gen_index_mma.py's warp_mlir): the score of token first + lane.
// It reads the keys, q and weights through their addresses and writes no memory.
fn index_scores_mma16_warp(k0: i64, k1: i64, k2: i64, k3: i64, q: i64, w: i64, scale: f32) on Topology::Device -> f32
