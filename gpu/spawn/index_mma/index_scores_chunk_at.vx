    %i19 = arith.constant 19 : index
    %a19 = memref.load %a[%i19] : memref<64xi32>
    %i20 = arith.constant 20 : index
    %a20 = memref.load %a[%i20] : memref<64xi32>
    %i21 = arith.constant 21 : index
    %a21 = memref.load %a[%i21] : memref<64xi32>
    %i22 = arith.constant 22 : index
    %a22 = memref.load %a[%i22] : memref<64xi32>
    %i23 = arith.constant 23 : index
