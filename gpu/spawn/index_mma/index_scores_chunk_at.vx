    %a8 = memref.load %a[%i8] : memref<64xi32>
    %i9 = arith.constant 9 : index
    %a9 = memref.load %a[%i9] : memref<64xi32>
    %i10 = arith.constant 10 : index
    %a10 = memref.load %a[%i10] : memref<64xi32>
    %i11 = arith.constant 11 : index
    %a11 = memref.load %a[%i11] : memref<64xi32>
    %i12 = arith.constant 12 : index
    %a12 = memref.load %a[%i12] : memref<64xi32>
    %i13 = arith.constant 13 : index
    %a13 = memref.load %a[%i13] : memref<64xi32>
    %i14 = arith.constant 14 : index
    %a14 = memref.load %a[%i14] : memref<64xi32>
