    %b0_0 = llvm.load %b0_0p {alignment = 8 : i64} : !llvm.ptr<3> -> vector<2xi32>
    %b0_0x = llvm.extractelement %b0_0[%e0 : i32] : vector<2xi32>
    %b0_0y = llvm.extractelement %b0_0[%e1 : i32] : vector<2xi32>
    %d0_0_0 = nvvm.mma.sync A[%a0, %a1, %a2, %a3] B[%b0_0x, %b0_0y] C[%zero, %zero, %zero, %zero] {layoutA = #nvvm.mma_layout<row>, layoutB = #nvvm.mma_layout<col>, multiplicandAPtxType = #nvvm.mma_type<bf16>, multiplicandBPtxType = #nvvm.mma_type<bf16>, shape = #nvvm.shape<m = 16, n = 8, k = 16>} : (i32, i32, f32) -> !llvm.struct<(f32, f32, f32, f32)>
