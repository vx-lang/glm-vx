// Starts the copy of this thread's 8 words of a query's q into shared memory (cp.async).
fn index_chunk_copy(shared: i64, global: i64) on Topology::Device -> i32
ensures writes_only()
{
  return mlir!( inputs : (%s = shared : i64, %g = global : i64), returns : i32, dialects : ["llvm", "nvvm", "arith"], ensures : [writes_only()]) {
    %sp = llvm.inttoptr %s : i64 to !llvm.ptr<3>
    %gp = llvm.inttoptr %g : i64 to !llvm.ptr<1>
    %sp1 = llvm.getelementptr %sp[16] : (!llvm.ptr<3>) -> !llvm.ptr<3>, i8
    %gp1 = llvm.getelementptr %gp[16] : (!llvm.ptr<1>) -> !llvm.ptr<1>, i8
    nvvm.cp.async.shared.global %sp, %gp, 16, cache = cg : !llvm.ptr<3>, !llvm.ptr<1>
    nvvm.cp.async.shared.global %sp1, %gp1, 16, cache = cg : !llvm.ptr<3>, !llvm.ptr<1>
    nvvm.cp.async.commit.group
    %z = arith.constant 0 : i32
    macro.yield %z : i32
  };
}

// Waits for this thread's copies, then for the block (named barrier 1, all 256 threads).
fn index_chunk_wait(x: i32) on Topology::Device -> i32
ensures writes_only()
{
  return mlir!( inputs : (%x = x : i32), returns : i32, dialects : ["llvm", "nvvm"], ensures : [writes_only()]) {
    %id = llvm.mlir.constant(1 : i32) : i32
    %n = llvm.mlir.constant(256 : i32) : i32
    nvvm.cp.async.wait.group 0
    nvvm.barrier id = %id number_of_threads = %n
    macro.yield %x : i32
  };
}

pub fn glm_vx_spawn_index_scores_chunk_at(out: &mut Tensor<f32, [?, ?], Memory::HBM>,
                                          q: &Tensor<i32, [?, ?], Memory::HBM>, keys: &Tensor<i32, [?, ?], Memory::HBM>,
                                          weights: &Tensor<f32, [?, ?], Memory::HBM>, rows: i32, start: i32, max_tokens: i32,
                                          qtiles: i32, ktiles: i32, heads: i32, dim: i32, scale: f32) -> void {
  spawn on(Topology::Device) {
    for b in 0..qtiles * ktiles across blocks {
      let qbuf = unsafe { Tensor<i32, [4608], Memory::SMEM>::uninit() };
      for tid in 0..256 across lanes(256) {
        let i0: i32 = (b / ktiles) * 64;
        let k0: i32 = (b % ktiles) * 256;
        let last_query: i32 = if i0 + 64 < rows { i0 + 64 - 1 } else { rows - 1 };
        // The whole block takes this branch or not (its barriers need all 256 threads).
        if heads == 32 && dim == 128 && rows > 0 && start >= 0 && start + rows <= max_tokens && i0 < rows
           && k0 <= start + last_query {
          let lane: i32 = tid % 32;
          let first: i32 = k0 + 32 * (tid / 32);
          let g: i32 = lane / 4;
          let c: i64 = (lane % 4) as i64;
          let top: i32 = max_tokens - 1;
          let kb: i64 = address2i(keys);
          let r0: i64 = ((first + g).min(top)) as i64;
          let r1: i64 = ((first + g + 8).min(top)) as i64;
          let r2: i64 = ((first + g + 16).min(top)) as i64;
          let r3: i64 = ((first + g + 24).min(top)) as i64;
          let k_0: i64 = kb + (r0 * 64 + 2 * c) * 4;
          let k_1: i64 = kb + (r1 * 64 + 2 * c) * 4;
          let k_2: i64 = kb + (r2 * 64 + 2 * c) * 4;
          let k_3: i64 = kb + (r3 * 64 + 2 * c) * 4;
          // The A fragments of the warp's 32 keys (gen_index_chunk.py's key_loads), in registers for every query.
          let mut a = unsafe { Tensor<i32, [64], Memory::REG>::uninit() };
          let v0: i64 = index_chunk_load2(k_0 + 0);
          a[0] = (v0 & 4294967295) as i32;
          a[2] = ((v0 >> 32) & 4294967295) as i32;
          let v1: i64 = index_chunk_load2(k_1 + 0);
          a[1] = (v1 & 4294967295) as i32;
          a[3] = ((v1 >> 32) & 4294967295) as i32;
          let v2: i64 = index_chunk_load2(k_2 + 0);
          a[4] = (v2 & 4294967295) as i32;
          a[6] = ((v2 >> 32) & 4294967295) as i32;
          let v3: i64 = index_chunk_load2(k_3 + 0);
          a[5] = (v3 & 4294967295) as i32;
          a[7] = ((v3 >> 32) & 4294967295) as i32;
          let v4: i64 = index_chunk_load2(k_0 + 32);
          a[8] = (v4 & 4294967295) as i32;
          a[10] = ((v4 >> 32) & 4294967295) as i32;
          let v5: i64 = index_chunk_load2(k_1 + 32);
          a[9] = (v5 & 4294967295) as i32;
          a[11] = ((v5 >> 32) & 4294967295) as i32;
          let v6: i64 = index_chunk_load2(k_2 + 32);
          a[12] = (v6 & 4294967295) as i32;
          a[14] = ((v6 >> 32) & 4294967295) as i32;
          let v7: i64 = index_chunk_load2(k_3 + 32);
          a[13] = (v7 & 4294967295) as i32;
          a[15] = ((v7 >> 32) & 4294967295) as i32;
          let v8: i64 = index_chunk_load2(k_0 + 64);
          a[16] = (v8 & 4294967295) as i32;
          a[18] = ((v8 >> 32) & 4294967295) as i32;
          let v9: i64 = index_chunk_load2(k_1 + 64);
          a[17] = (v9 & 4294967295) as i32;
          a[19] = ((v9 >> 32) & 4294967295) as i32;
          let v10: i64 = index_chunk_load2(k_2 + 64);
          a[20] = (v10 & 4294967295) as i32;
          a[22] = ((v10 >> 32) & 4294967295) as i32;
          let v11: i64 = index_chunk_load2(k_3 + 64);
          a[21] = (v11 & 4294967295) as i32;
          a[23] = ((v11 >> 32) & 4294967295) as i32;
          let v12: i64 = index_chunk_load2(k_0 + 96);
          a[24] = (v12 & 4294967295) as i32;
          a[26] = ((v12 >> 32) & 4294967295) as i32;
          let v13: i64 = index_chunk_load2(k_1 + 96);
          a[25] = (v13 & 4294967295) as i32;
          a[27] = ((v13 >> 32) & 4294967295) as i32;
          let v14: i64 = index_chunk_load2(k_2 + 96);
          a[28] = (v14 & 4294967295) as i32;
          a[30] = ((v14 >> 32) & 4294967295) as i32;
          let v15: i64 = index_chunk_load2(k_3 + 96);
          a[29] = (v15 & 4294967295) as i32;
          a[31] = ((v15 >> 32) & 4294967295) as i32;
          let v16: i64 = index_chunk_load2(k_0 + 128);
          a[32] = (v16 & 4294967295) as i32;
          a[34] = ((v16 >> 32) & 4294967295) as i32;
          let v17: i64 = index_chunk_load2(k_1 + 128);
          a[33] = (v17 & 4294967295) as i32;
          a[35] = ((v17 >> 32) & 4294967295) as i32;
          let v18: i64 = index_chunk_load2(k_2 + 128);
          a[36] = (v18 & 4294967295) as i32;
          a[38] = ((v18 >> 32) & 4294967295) as i32;
          let v19: i64 = index_chunk_load2(k_3 + 128);
          a[37] = (v19 & 4294967295) as i32;
          a[39] = ((v19 >> 32) & 4294967295) as i32;
          let v20: i64 = index_chunk_load2(k_0 + 160);
          a[40] = (v20 & 4294967295) as i32;
          a[42] = ((v20 >> 32) & 4294967295) as i32;
          let v21: i64 = index_chunk_load2(k_1 + 160);
          a[41] = (v21 & 4294967295) as i32;
          a[43] = ((v21 >> 32) & 4294967295) as i32;
          let v22: i64 = index_chunk_load2(k_2 + 160);
          a[44] = (v22 & 4294967295) as i32;
          a[46] = ((v22 >> 32) & 4294967295) as i32;
          let v23: i64 = index_chunk_load2(k_3 + 160);
          a[45] = (v23 & 4294967295) as i32;
          a[47] = ((v23 >> 32) & 4294967295) as i32;
          let v24: i64 = index_chunk_load2(k_0 + 192);
          a[48] = (v24 & 4294967295) as i32;
          a[50] = ((v24 >> 32) & 4294967295) as i32;
          let v25: i64 = index_chunk_load2(k_1 + 192);
          a[49] = (v25 & 4294967295) as i32;
          a[51] = ((v25 >> 32) & 4294967295) as i32;
          let v26: i64 = index_chunk_load2(k_2 + 192);
          a[52] = (v26 & 4294967295) as i32;
          a[54] = ((v26 >> 32) & 4294967295) as i32;
          let v27: i64 = index_chunk_load2(k_3 + 192);
          a[53] = (v27 & 4294967295) as i32;
          a[55] = ((v27 >> 32) & 4294967295) as i32;
          let v28: i64 = index_chunk_load2(k_0 + 224);
          a[56] = (v28 & 4294967295) as i32;
          a[58] = ((v28 >> 32) & 4294967295) as i32;
          let v29: i64 = index_chunk_load2(k_1 + 224);
          a[57] = (v29 & 4294967295) as i32;
          a[59] = ((v29 >> 32) & 4294967295) as i32;
          let v30: i64 = index_chunk_load2(k_2 + 224);
          a[60] = (v30 & 4294967295) as i32;
          a[62] = ((v30 >> 32) & 4294967295) as i32;
          let v31: i64 = index_chunk_load2(k_3 + 224);
          a[61] = (v31 & 4294967295) as i32;
          a[63] = ((v31 >> 32) & 4294967295) as i32;
          let qb: i64 = address2i(q);
          let wb: i64 = address2(weights);
          let sb: i64 = address_shared(&qbuf);
          // This thread copies words 8 * (tid % 8) .. of head row tid / 8.
          let copy_to: i64 = sb + (((tid / 8) * 72 + 8 * (tid % 8)) as i64) * 4;
          let copy_from: i64 = ((tid / 8) * 64 + 8 * (tid % 8)) as i64 * 4;
          let read_at: i64 = sb + ((g * 72) as i64 + 2 * c) * 4;
          let _c0: i32 = index_chunk_copy(copy_to, qb + (i0 as i64) * 8192 + copy_from);
          let _w0: i32 = index_chunk_wait(0);
          for qi in 0..64 {
            let i: i32 = i0 + qi;
            let next: i32 = if i + 1 < rows { i + 1 } else { rows - 1 };
            let _c: i32 = index_chunk_copy(copy_to + (((qi + 1) % 2) as i64) * 9216,
                                           qb + (next as i64) * 8192 + copy_from);
            // Whole warps take this branch together (mma.sync and the shuffles need all 32 lanes).
            if i < rows && first <= start + i {
              let score: f32 = index_chunk_query!(a, read_at + ((qi % 2) as i64) * 9216,
                                                 wb + ((i as i64) * 32 + 2 * c) * 4, scale);
              let j: i32 = k0 + tid;
              let ok: bool = j <= start + i;
              if ok { out[i][j] = score; }
            }
            let _w: i32 = index_chunk_wait(qi);
          }
        }
      }
    }
  }
  return;
}
