// glm_vx_gpu_bf16_matmul through Vx's own GPU path: out[m, n] = sum_k W_e[n, k] * x[m, k] with
// raw bfloat16 weights. experts == 0: one weight[N, K] for all rows (expert_ids is not read);
// experts > 0: weight[E, N, K] and expert_ids[M] picks each row's expert, an id outside [0, E)
// writing zeros (an unrouted slot). One warp per (n, m) task, n-major.
// spawn-include: device.vx

pub fn glm_vx_spawn_bf16_matmul(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u16, [?], Memory::HBM>,
                                x: &Tensor<f32, [?], Memory::HBM>, expert_ids: &Tensor<i32, [?], Memory::HBM>,
                                rows_m: i32, rows_n: i32, cols: i32, experts: i32) -> void {
  spawn on(Topology::Device) {
    let tid: i32 = thread_id();
    let lane: i32 = tid & 31;
    let block: i32 = block_dim();
    let warps: i32 = block / 32;
    let task: i64 = (block_id() as i64) * (warps as i64) + ((tid / 32) as i64);
    if rows_m > 0 && rows_n > 0 && cols >= 0 && experts >= 0 && block >= 32 && block <= 1024 && block % 32 == 0
       && task < (rows_m as i64) * (rows_n as i64) {
      let m_count: i64 = rows_m as i64;
      let n_count: i64 = rows_n as i64;
      let n: i64 = task / m_count;
      let m: i64 = task % m_count;
      let k: i64 = cols as i64;
      let mut expert: i64 = 0;
      let mut valid: i32 = 1;
      if experts > 0 {
        let id: i32 = expert_ids[m];
        if id < 0 { valid = 0; }
        if id >= experts { valid = 0; }
        expert = id as i64;
      }
      let mut sum: f32 = 0.0;
      if valid != 0 {
        let row_base: i64 = (expert * n_count + n) * k;
        let mut col: i64 = lane as i64;
        while col < k {
          sum = sum + bf16_decode(weight[row_base + col] as i32) * x[m * k + col];
          col = col + 32;
        }
      }
      let total: f32 = warp_sum(sum);
      if lane == 0 { out[m * n_count + n] = total; }
    }
  }
  return;
}
