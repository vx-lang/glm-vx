// FP8 e4m3fn matvec with one fma a code, two rows a warp, x read whole sectors at a time (#30):
// fp8_matvec_fma's sums with another lane-to-column map. In fp8_matvec4's map a lane's sixteen
// columns are contiguous, so one 16-byte load of x across a warp touches sixteen 128-byte lines,
// and ncu on an H200 put fp8_matvec_fma's L1 at 74% busy. Here group j of a 512-column tile gives
// lane l columns tile * 512 + j * 128 + 4l .. + 3: x is one 512-byte run a load (four lines), and a
// lane reads one u32 of codes a group from each row (128 contiguous bytes across the warp).
//
// - Warp w of block b takes rows 8b + 2w and 8b + 2w + 1 (one scale row; a missing second row reads
//   the first again and is dropped). A whole tile loads its eight words, sixteen x and four scales
//   (group j is scale block tile * 4 + j) before any arithmetic; a last partial tile goes group by
//   group.
// - Each group of four codes is summed at 2^-80 scale, then sum = fma(p, scale * 2^80, sum).
//
// H200, CUDA events, L2 flushed: q_a_proj 2048 x 6144 in 14.5 us, kv_a_proj 576 x 6144 in 12.8 us
// (fp8_matvec4 19.2 and 16.8; cuBLASLt with its quantization 20.0 and 19.7), mlp.gate 39 us. On long
// rows (o_proj) fp8_matvec_fma is faster: 87 registers leave 23% occupancy, and it issues more.
//
// Error: each fma rounds once in float32, one rounding fewer a code than fp8_matvec4. Products sit
// at 2^-80 (x read at 2^40, from_bits(fp8_bits(code)) = code * 2^-120), so a group falls below
// float32's normal range only when |sum of code * x| < 2^-46; the PTX has no .ftz, so denormals stay
// (each rounding there at most 2^-150, i.e. 2^-70 * |scale| once scaled). At 2^-120 the error had
// reached 7e-5 at |x| ~ 1e-7. x * 2^40 overflows for |x| >= 2^88 (3e26): that row is inf or NaN.
// A group with a NaN code or |scale| >= 256 takes fp8_word_terms!, exact per code, so a NaN still
// makes the row NaN. Other widths (cols % 16 != 0) write zeros, as fp8_matvec4 does.
// spawn-include: device.vx

pub extern fn glm_vx_spawn_fp8_matvec_fma_tiles(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u32, [?], Memory::HBM>,
                                     scales: &Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                     rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 8 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for lane in 0..32 across lanes {
          let row: i64 = (rb * 8 + w * 2) as i64;
          let mut sum: f32 = 0.0;
          let mut sum2: f32 = 0.0;
          fp8_tiles_pair_rows!(sum, sum2, weight, scales, x, row, rows, cols, lane);
          a[w * 2][lane] = sum;
          a[w * 2 + 1][lane] = sum2;
        }
        let total: f32 = lanes::sum(&a[w * 2], 32);
        let total2: f32 = lanes::sum(&a[w * 2 + 1], 32);
        if rb * 8 + w * 2 < rows && cols >= 0 { out[rb * 8 + w * 2] = total; }
        if rb * 8 + w * 2 + 1 < rows && cols >= 0 { out[rb * 8 + w * 2 + 1] = total2; }
      }
    }
  }
  return;
}
