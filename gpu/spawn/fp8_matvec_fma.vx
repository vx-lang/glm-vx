// FP8 e4m3fn matvec with one FMA a code (#30): out[r] = sum over columns of
// decode(w[r, c]) * scale[r / 128, c / 128] * x[c], fp8_matvec4's layout and lanes (one warp of 32
// lanes a row, four rows a block, lane l reading words 4l .. 4l + 3 of every 128-word tile, one
// 16-byte load), but not its bits. On an H200 ncu found fp8_matvec instruction-bound (60-65% SM
// throughput at 10% of DRAM bandwidth); fp8_matvec4 spends two multiplies and an add on each code.
// Here each code costs one fma and its 2-3 integer instructions of fp8_bits!:
//
// - A lane step's sixteen codes are summed at 2^-80 scale: p = fma(from_bits(fp8_bits(code)),
//   x[c] * 2^40, p), from_bits(...) being code * 2^-120 exactly (no NaN codes on this path). Then
//   sum = fma(p, scale * 2^80, sum) once a step; both power-of-two products are exact. The
//   multiply of x is one instruction a code; without it products sit at 2^-120 and steps whose
//   |sum of code * x| is below 2^-6 fall to denormals (7e-5 relative error at |x| ~ 1e-7).
// - Two lane steps a turn while both fit (columns 512 apart, two scale blocks), each checked
//   with fp8_fast4!; a step with a NaN code or |scale| >= 256 takes fp8_word_terms!, exact per
//   code, so a NaN still makes the row NaN.
//
// Error: each fma rounds once in float32, one rounding fewer a code than fp8_matvec4. A step falls
// below float32's normal range only when |sum of code * x| < 2^-46 (the PTX has no .ftz, so it keeps
// denormals; each rounding there is at most 2^-150, i.e. 2^-70 * |scale| once scaled): a row is
// within float32 accumulation error of the exact sum plus cols * 2^-70 * max |scale|. x * 2^40
// overflows for |x| >= 2^88 (3e26), where the row comes out infinite or NaN.
// Other widths (cols % 16 != 0) write zeros, as fp8_matvec4 does.
// spawn-include: device.vx

// 2^40, which x is multiplied by as it is read, and 2^80, which a step's sum is multiplied by with
// its scale: from_bits(fp8_bits(code)) is code * 2^-120, so a product is code * x * 2^-80.
macro_rules! X_SCALE { () => { f32::from_bits(1400897536u32) }; }
macro_rules! STEP_SCALE { () => { f32::from_bits(1736441856u32) }; }

// Sixteen codes of one lane step at 2^-80 scale: the sum of from_bits(fp8_bits(code)) * (x[col + i] *
// 2^40), one fma each, in column order. No code may be a NaN (fp8_fast4! said so).
macro_rules! fp8_step_fma {
    ($w0:expr, $w1:expr, $w2:expr, $w3:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_p: f32 = 0.0;
          let mut dv_j: i32 = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w0, dv_j)), $x[$col + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w1, dv_j)), $x[$col + 4 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w2, dv_j)), $x[$col + 8 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w3, dv_j)), $x[$col + 12 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_p
        }
    };
}

// One lane step of sixteen codes into $sum: the fma path, or the exact one for a NaN code or a
// scale of 256 or more.
macro_rules! fp8_step_into {
    ($sum:expr, $w0:expr, $w1:expr, $w2:expr, $w3:expr, $scale:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_s: f32 = $sum;
          if fp8_fast4!($w0, $w1, $w2, $w3, $scale) {
            let dv_step: f32 = fp8_step_fma!($w0, $w1, $w2, $w3, $x, $col);
            dv_s = fma32!(dv_step, $scale * STEP_SCALE!(), dv_s);
          } else {
            let dv_i0: i32 = $w0 as i32;
            let dv_i1: i32 = $w1 as i32;
            let dv_i2: i32 = $w2 as i32;
            let dv_i3: i32 = $w3 as i32;
            dv_s = fp8_word_terms!(dv_s, dv_i0, $scale, $x, $col);
            dv_s = fp8_word_terms!(dv_s, dv_i1, $scale, $x, $col + 4);
            dv_s = fp8_word_terms!(dv_s, dv_i2, $scale, $x, $col + 8);
            dv_s = fp8_word_terms!(dv_s, dv_i3, $scale, $x, $col + 12);
          }
          dv_s
        }
    };
}

pub fn glm_vx_spawn_fp8_matvec_fma(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u32, [?], Memory::HBM>,
                                   scales: &Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                   rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 4 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for lane in 0..32 across lanes {
          let row: i64 = (rb * 4 + w) as i64;
          let mut sum: f32 = 0.0;
          if row < (rows as i64) && cols % 16 == 0 {
            let n: i64 = cols as i64;
            let tiles: i64 = (n + 127) / 128;
            let words: i64 = n / 4;
            // row * words, written with its factor 4 (Vx #2362), as fp8_row_dot4! does.
            let row_words: i64 = row * (n / 16) * 4;
            let scale_base: i64 = (row / 128) * tiles;
            let mut at: i64 = (lane as i64) * 4;
            // Two lane steps a turn while both fit: their eight words load before either is used.
            while at + 128 < words {
              let u0: u32 = weight[row_words + at];
              let u1: u32 = weight[row_words + at + 1];
              let u2: u32 = weight[row_words + at + 2];
              let u3: u32 = weight[row_words + at + 3];
              let v0: u32 = weight[row_words + at + 128];
              let v1: u32 = weight[row_words + at + 129];
              let v2: u32 = weight[row_words + at + 130];
              let v3: u32 = weight[row_words + at + 131];
              let scale: f32 = scales[scale_base + at / 32];
              let scale2: f32 = scales[scale_base + at / 32 + 4];
              let col: i64 = at * 4;
              if fp8_fast4!(u0, u1, u2, u3, scale) && fp8_fast4!(v0, v1, v2, v3, scale2) {
                let p: f32 = fp8_step_fma!(u0, u1, u2, u3, x, col);
                let q: f32 = fp8_step_fma!(v0, v1, v2, v3, x, col + 512);
                sum = fma32!(p, scale * STEP_SCALE!(), sum);
                sum = fma32!(q, scale2 * STEP_SCALE!(), sum);
              } else {
                sum = fp8_step_into!(sum, u0, u1, u2, u3, scale, x, col);
                sum = fp8_step_into!(sum, v0, v1, v2, v3, scale2, x, col + 512);
              }
              at = at + 256;
            }
            while at < words {
              let u0: u32 = weight[row_words + at];
              let u1: u32 = weight[row_words + at + 1];
              let u2: u32 = weight[row_words + at + 2];
              let u3: u32 = weight[row_words + at + 3];
              let scale: f32 = scales[scale_base + at / 32];
              sum = fp8_step_into!(sum, u0, u1, u2, u3, scale, x, at * 4);
              at = at + 128;
            }
          }
          a[w][lane] = sum;
        }
        let total: f32 = lanes::sum(&a[w], 32);
        if rb * 4 + w < rows && cols >= 0 { out[rb * 4 + w] = total; }
      }
    }
  }
  return;
}
