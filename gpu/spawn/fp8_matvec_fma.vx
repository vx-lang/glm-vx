// FP8 e4m3fn matvec with one fma a code, two rows a warp (#30): out[r] = sum over columns of
// decode(w[r, c]) * scale[r / 128, c / 128] * x[c]. On an H200 ncu found fp8_matvec instruction-bound
// (60-65% SM throughput at 10% of DRAM bandwidth), and then fp8_matvec4 and a one-row fma kernel
// waiting on L1: a lane reads sixteen x (64 bytes) for every sixteen codes (16 bytes) of its row.
//
// - Warp w of block b takes rows 8b + 2w and 8b + 2w + 1 (one scale row: the first is even); lane l
//   reads words 4l .. 4l + 3 of every 128-word tile of both rows, fp8_matvec4's layout, two 16-byte
//   loads, and each x it reads (times 2^40) feeds one fma of each row.
// - A lane step's sixteen codes of a row are summed at 2^-80 scale, then
//   sum = fma(p, scale * 2^80, sum) (device.vx's fp8_step_fma! and fp8_step_into! for a last odd row).
//
// H200, CUDA events, L2 flushed: o_proj 6144 x 16384 in 51 us (41% of DRAM peak; fp8_matvec4 118,
// cuBLASLt with its activation quantization 43), mlp.down 42 us. Rows that are few against a long k
// fill too few blocks: fp8_matvec_fma_tiles is faster there (ResidentGLM picks by width).
//
// Error: each fma rounds once in float32, one rounding fewer a code than fp8_matvec4. Products sit
// at 2^-80 (x read at 2^40, from_bits(fp8_bits(code)) = code * 2^-120), so a group falls below
// float32's normal range only when |sum of code * x| < 2^-46; the PTX has no .ftz, so denormals stay
// (each rounding there at most 2^-150, i.e. 2^-70 * |scale| once scaled). At 2^-120 the error had
// reached 7e-5 at |x| ~ 1e-7. x * 2^40 overflows for |x| >= 2^88 (3e26): that row is inf or NaN.
// A group with a NaN code or |scale| >= 256 takes fp8_word_terms!, exact per code, so a NaN still
// makes the row NaN. Other widths (cols % 16 != 0) write zeros, as fp8_matvec4 does.
// spawn-include: device.vx

// Codes j of word $u (row r) and of word $v (row r + 1) against one x: two fmas, one read of x.
macro_rules! fp8_pair_word {
    ($p:ident, $q:ident, $u:expr, $v:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_j: i32 = 0;
          while dv_j < 4 {
            let dv_x: f32 = $x[$col + (dv_j as i64)] * X_SCALE!();
            $p = fma32!(f32::from_bits(fp8_bits!($u, dv_j)), dv_x, $p);
            $q = fma32!(f32::from_bits(fp8_bits!($v, dv_j)), dv_x, $q);
            dv_j = dv_j + 1;
          }
        }
    };
}

pub fn glm_vx_spawn_fp8_matvec_fma(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u32, [?], Memory::HBM>,
                                   scales: &Tensor<f32, [?], Memory::HBM>, x: &Tensor<f32, [?], Memory::HBM>,
                                   rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 8 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for lane in 0..32 across lanes {
          let row: i64 = (rb * 8 + w * 2) as i64;
          let mut sum: f32 = 0.0;
          let mut sum2: f32 = 0.0;
          if row < (rows as i64) && cols % 16 == 0 {
            let n: i64 = cols as i64;
            let tiles: i64 = (n + 127) / 128;
            let words: i64 = n / 4;
            let row_words: i64 = row * (n / 16) * 4;
            let next_words: i64 = row_words + (n / 16) * 4;
            // row is even, so row + 1 is in row's 128-row scale block.
            let scale_base: i64 = (row / 128) * tiles;
            let mut at: i64 = (lane as i64) * 4;
            if row + 1 < (rows as i64) {
              while at < words {
                let u0: u32 = weight[row_words + at];
                let u1: u32 = weight[row_words + at + 1];
                let u2: u32 = weight[row_words + at + 2];
                let u3: u32 = weight[row_words + at + 3];
                let v0: u32 = weight[next_words + at];
                let v1: u32 = weight[next_words + at + 1];
                let v2: u32 = weight[next_words + at + 2];
                let v3: u32 = weight[next_words + at + 3];
                let scale: f32 = scales[scale_base + at / 32];
                let col: i64 = at * 4;
                if fp8_fast4!(u0, u1, u2, u3, scale) && fp8_fast4!(v0, v1, v2, v3, scale) {
                  let mut p: f32 = 0.0;
                  let mut q: f32 = 0.0;
                  fp8_pair_word!(p, q, u0, v0, x, col);
                  fp8_pair_word!(p, q, u1, v1, x, col + 4);
                  fp8_pair_word!(p, q, u2, v2, x, col + 8);
                  fp8_pair_word!(p, q, u3, v3, x, col + 12);
                  sum = fma32!(p, scale * STEP_SCALE!(), sum);
                  sum2 = fma32!(q, scale * STEP_SCALE!(), sum2);
                } else {
                  sum = fp8_step_into!(sum, u0, u1, u2, u3, scale, x, col);
                  sum2 = fp8_step_into!(sum2, v0, v1, v2, v3, scale, x, col);
                }
                at = at + 128;
              }
            } else {
              while at < words {
                let u0: u32 = weight[row_words + at];
                let u1: u32 = weight[row_words + at + 1];
                let u2: u32 = weight[row_words + at + 2];
                let u3: u32 = weight[row_words + at + 3];
                let scale: f32 = scales[scale_base + at / 32];
                sum = fp8_step_into!(sum, u0, u1, u2, u3, scale, x, at * 4);
                at = at + 128;
              }
            }
          }
          a[w * 2][lane] = sum;
          a[w * 2 + 1][lane] = sum2;
        }
        let total: f32 = lanes::sum(&a[w * 2], 32);
        let total2: f32 = lanes::sum(&a[w * 2 + 1], 32);
        if rb * 8 + w * 2 < rows && cols >= 0 { out[rb * 8 + w * 2] = total; }
        if rb * 8 + w * 2 + 1 < rows && cols >= 0 { out[rb * 8 + w * 2 + 1] = total2; }
      }
    }
  }
  return;
}
