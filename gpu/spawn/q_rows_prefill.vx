// glm_vx_spawn_q_rows_prefill (#63, item 5b): prefill_chunk's queries per (token, head) for mha_prefill: q_out[t][h]
// is query[t]'s head h, its first nope values as they are and its rope values RoPE'd with token t's
// cos and sin (steps[t]) in glm_vx_gpu_rope_strided's packed order, as the rope cache's keys are.
// spawn-include: device.vx

pub extern fn glm_vx_spawn_q_rows_prefill(q_out: &mut Tensor<f32, [?, ?, ?], Memory::HBM>, query: &Tensor<f32, [?, ?], Memory::HBM>,
                                          steps: &Tensor<f32, [?, ?], Memory::HBM>, rows: i32, heads: i32, nope: i32, rot: i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..rows across blocks {
      for h in 0..heads across blocks {
        for d in 0..nope + rot across lanes(256) {
          let qk: i32 = nope + rot;
          let pairs: i32 = rot / 2;
          let mut v: f32 = 0.0;
          if d < nope {
            v = query[t][h * qk + d];
          } else if pairs > 0 && rot % 2 == 0 {
            let j: i32 = d - nope;
            let p: i32 = j % pairs;
            let a0: f32 = query[t][h * qk + nope + p * 2];
            let b0: f32 = query[t][h * qk + nope + p * 2 + 1];
            let c: f32 = steps[t][p];
            let s: f32 = steps[t][pairs + p];
            v = a0 * c - b0 * s;
            if j >= pairs { v = b0 * c + a0 * s; }
          }
          q_out[t][h][d] = v;
        }
      }
    }
  }
  return;
}
