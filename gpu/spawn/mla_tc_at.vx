// MLA decode on the tensor cores with a bf16 cache (#33). Block b = group * splits_max + split takes
// heads 16 * group .. + 15 and the 32 selected tokens split * 32 .. + 31 (one chunk: GLM-5.3 selects
// at most 2048 tokens, so 64 splits cover them). Its eight subgroups each:
//   1. copy their query tiles (bf16, transposed, from mla_q_bf16_at) and gather, with
//      lanes::copy_rows_async (Vx #3487, cp.async), latent columns 64 * w .. + 63 of the chunk's tokens
//      (and subgroups 0 and 1 the rope of tokens 16 * w .. + 15);
//   2. compute with mma.sync the scores of tokens 16 * ((w / 2) % 2) .. + 15 for heads
//      8 * (w % 2) .. + 7 over latent columns 256 * (w / 4) .. + 255 (and the rope, for w < 4);
//   3. for heads 2 * w and 2 * w + 1, add the two halves of the scores, take the chunk's max m and
//      P[head][token] = exp(score * scale - m) (bf16 for the next product, f32 for l, its sum);
//   4. compute O = P @ latent rows for columns 64 * w .. + 63 with mma.sync, and copy it from the
//      registers to numerator, with no rescaling: each block sees one chunk.
// mla_flash_merge_at then merges the splits: numerator [heads / 16 * splits_max * 16, rank] and stats
// [heads / 16 * splits_max, 32] are its [heads / 16, splits_max, 16 * rank] and [.., 32].
//
// The scores and P @ V are bf16 products with f32 sums, as SGLang's FlashMLA, so out agrees with the
// f32 kernels to bf16 rounding, not to f32 rounding. Needs heads % 16 == 0, rank == 512, rope_dim
// == 64, selection_stride 0 and count <= 32 * splits; otherwise, and for splits past step's, it
// writes nothing, and blocks past step's splits return at once.
// spawn-maxnreg: 128 (build.py: two blocks of 256 threads an SM)
// spawn-include: device.vx

pub extern fn glm_vx_spawn_mla_tc_at(numerator: &mut Tensor<f32, [?, ?], Memory::HBM>, stats: &mut Tensor<f32, [?, ?], Memory::HBM>,
                                     q_t: &Tensor<bf16, [?, ?], Memory::HBM>, qr_t: &Tensor<bf16, [?, ?], Memory::HBM>,
                                     cache_latent: &Tensor<bf16, [?, ?], Memory::HBM>, cache_rope: &Tensor<bf16, [?, ?], Memory::HBM>,
                                     selected: &Tensor<i32, [?], Memory::HBM>, step: &Tensor<i32, [?], Memory::HBM>,
                                     heads: i32, rank: i32, rope_dim: i32, selection_stride: i32, splits_max: i32, scale: f32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(heads / 16) * splits_max across blocks {
      let hg: i32 = b / splits_max;
      let split: i32 = b % splits_max;
      let tokens: i32 = step[1];
      let count: i32 = step[2];
      let splits: i32 = step[3];
      let ok: bool = split < splits && heads % 16 == 0 && rank == 512 && rope_dim == 64 && selection_stride == 0
                     && tokens > 0 && count >= 0 && splits > 0 && count <= 32 * splits;
      // sl[th][c][t][k]: latent element 64 * c + k of token 16 * th + t of the chunk; sr[th] the rope.
      let mut sl = unsafe { Tensor<bf16, [2, 8, 16, 64], Memory::SMEM>::uninit() };
      let mut sr = unsafe { Tensor<bf16, [2, 16, 64], Memory::SMEM>::uninit() };
      // qt[c][hh][k][h]: head 16 * hg + 8 * hh + h's latent query at 64 * c + k; qrt[w] the rope query of
      // heads 8 * (w % 2) .. + 7.
      let mut qt = unsafe { Tensor<bf16, [8, 2, 64, 8], Memory::SMEM>::uninit() };
      let mut qrt = unsafe { Tensor<bf16, [8, 64, 8], Memory::SMEM>::uninit() };
      // s[w]: subgroup w's part of the scores (see 2. above).
      let mut s = unsafe { Tensor<f32, [8, 16, 8], Memory::SMEM>::uninit() };
      // p[th][h][t]: P of head h and token 16 * th + t, for the product with the latent rows.
      let mut p = unsafe { Tensor<bf16, [2, 16, 16], Memory::SMEM>::uninit() };
      let mut xs = unsafe { Tensor<f32, [8, 2, 32], Memory::SMEM>::uninit() };
      let mut pf = unsafe { Tensor<f32, [8, 2, 32], Memory::SMEM>::uninit() };
      let mut o = unsafe { Tensor<f32, [8, 16, 64], Memory::SMEM>::uninit() };
      let mut ids = unsafe { Tensor<i32, [8, 32], Memory::SMEM>::uninit() };
      if ok {
      for w in 0..8 across subgroups {
        // mla_q_bf16_at's rows: (2 * (128-column block) + hh) * 128 + k.
        let q0 = lanes::copy_async(&mut qt[w][0], q_t, [((hg * 4 + w / 2) * 2) * 128 + (w % 2) * 64, 0]);
        let q1 = lanes::copy_async(&mut qt[w][1], q_t, [((hg * 4 + w / 2) * 2 + 1) * 128 + (w % 2) * 64, 0]);
        let q2 = lanes::copy_async(&mut qrt[w], qr_t, [(hg * 2 + w % 2) * 64, 0]);
        // The chunk's ids, lane t token t's (-1 for one out of range, which gathers a zero row).
        for t in 0..32 across lanes {
          let j: i32 = split * 32 + t;
          let jc: i32 = if j < count { j } else { 0 };
          let id: i32 = selected[jc];
          let none: i32 = -1;
          ids[w][t] = if j < count && id >= 0 && id < tokens { id } else { none };
        }
        let g0 = lanes::copy_rows_async(&mut sl[0][w], cache_latent, &ids[w], [0, 64 * w]);
        let g1 = lanes::copy_rows_async(&mut sl[1][w], cache_latent, &ids[w], [16, 64 * w]);
        if w < 2 {
          let g2 = lanes::copy_rows_async(&mut sr[w], cache_rope, &ids[w], [16 * w, 0]);
          g2.wait();
        }
        g0.wait();
        g1.wait();
        q0.wait();
        q1.wait();
        q2.wait();
      }
      for w in 0..8 across subgroups {
        let th: i32 = (w / 2) % 2;
        let hh: i32 = w % 2;
        let c0: i32 = (w / 4) * 4;
        s[w] = (sl[th][c0] as f32) @ (qt[c0][hh] as f32);
        s[w] = s[w] + (sl[th][c0 + 1] as f32) @ (qt[c0 + 1][hh] as f32);
        s[w] = s[w] + (sl[th][c0 + 2] as f32) @ (qt[c0 + 2][hh] as f32);
        s[w] = s[w] + (sl[th][c0 + 3] as f32) @ (qt[c0 + 3][hh] as f32);
        if w < 4 {
          s[w] = s[w] + (sr[th] as f32) @ (qrt[hh] as f32);
        }
      }
      for w in 0..8 across subgroups {
        // Heads 2 * w and 2 * w + 1; lane t is token t of the chunk.
        for t in 0..32 across lanes {
          let j: i32 = split * 32 + t;
          let jc: i32 = if j < count { j } else { 0 };
          let id: i32 = selected[jc];
          let valid: bool = j < count && id >= 0 && id < tokens;
          for hq in 0..2 {
            let h: i32 = w * 2 + hq;
            let i: i32 = (t / 16) * 2 + h / 8;
            let x: f32 = (s[i][t % 16][h % 8] + s[i + 4][t % 16][h % 8]) * scale;
            xs[w][hq][t] = if valid { x } else { -3.0e38 };
          }
        }
        let m0: f32 = lanes::max(&xs[w][0], 32);
        let m1: f32 = lanes::max(&xs[w][1], 32);
        for t in 0..32 across lanes {
          for hq in 0..2 {
            let m: f32 = if hq == 0 { m0 } else { m1 };
            let x: f32 = xs[w][hq][t];
            let e: f32 = (x - m).fast_exp();
            pf[w][hq][t] = if x > -1.0e38 { e } else { 0.0 };
          }
        }
        for t in 0..32 across lanes {
          if t < 16 {
            for th in 0..2 {
              for hq in 0..2 {
                p[th][w * 2 + hq][t] = pf[w][hq][th * 16 + t] as bf16;
              }
            }
          }
        }
        let l0: f32 = lanes::sum(&pf[w][0], 32);
        let l1: f32 = lanes::sum(&pf[w][1], 32);
        for t in 0..32 across lanes {
          if t == 0 {
            stats[b][w * 4] = m0;
            stats[b][w * 4 + 1] = l0;
            stats[b][w * 4 + 2] = m1;
            stats[b][w * 4 + 3] = l1;
          }
        }
      }
      for w in 0..8 across subgroups {
        lanes::fill(&mut o[w], 0.0);
        o[w] = o[w] + (p[0] as f32) @ (sl[0][w] as f32);
        o[w] = o[w] + (p[1] as f32) @ (sl[1][w] as f32);
        lanes::copy(numerator, &o[w], [b * 16, 64 * w]);
      }
      }
    }
  }
  return;
}
