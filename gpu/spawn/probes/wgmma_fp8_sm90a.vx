// Probe (glm-vx #10, plan #2): the block-FP8 GEMM tile of GLM's FP8 weights on sm_90a, through
// Vx's own GPU path. Built by gpu/spawn/probes/build.sh with machine-sm90a.vx; not one of the 25
// kernels. wgmma_bf16_sm90a.vx explains the shared memory layout, the descriptors and the
// accumulator layout; this file differs only where it says so.
//
//   out[m, n] = sum_kb a_scale[m, kb] * b_scale[n / 128, kb] * sum_{k in block kb} A[m, k] * B[n, k]
//
// A is [M, K] and B is [N, K], e4m3 (fp8, OCP E4M3FN) bytes, row-major, passed as i32 words of four
// bytes (k % 4 == i in byte i, little-endian). a_scale is f32 [M, K / 128] (one scale per row and
// 128-k block: the activation's 1 x 128 tiles), b_scale is f32 [N / 128, K / 128] (the weight's
// 128 x 128 blocks). M % 64 == 0, N % 64 == 0, K % 128 == 0. One warpgroup owns a 64 x 64 tile, so
// one b_scale per k block; each thread's accumulator rows are r_lo = 16w + g and r_hi = r_lo + 8.
//
// Per 128-k block: the block of A and of B is 64 rows x 128 bytes, the same bytes and the same
// core-matrix layout as a 64-k bf16 block (a core matrix is 8 rows x 16 bytes = 16 e4m3 of k), so
// staging and descriptors are those of wgmma_bf16_sm90a.vx. wgmma m64n64k32 .e4m3.e4m3 (PTX ISA
// 9.7.15.5: K-major only, so there is no imm-trans operand) steps 32 k = 32 bytes = 2 core matrices,
// 256 bytes, as the bf16 k16 step does. The first of the four steps has scale-d = 0, so `part` gets
// this block's A_kb B_kb^T alone; then the epilogue of the block multiplies it by its scales:
//     acc[4j + q] += part[4j + q] * a_scale[row_q, kb] * b_scale[n0 / 128, kb],   row_q = q < 2 ? r_lo : r_hi
// (D register i is row r_lo + 8 * ((i >> 1) & 1): PTX ISA 9.7.15.5.2.)
// spawn-include: ../device.vx

// The shared::cta byte address of a shared tensor. Its memref type in an mlir! block has memory
// space 3 (memref<2048xi32> fails with "'memref.cast' op operand type 'memref<2048xi32, 3>' and
// result type 'memref<2048xi32>' are cast incompatible").
fn smem_address(tile: &mut Tensor<i32, [2048], Memory::SMEM>) on Topology::Device -> i64 {
  return mlir!( inputs : (%t = tile : memref<2048xi32, 3>), returns : i64, dialects : ["memref", "arith"]) {
    %p = memref.extract_aligned_pointer_as_index %t : memref<2048xi32, 3> -> index
    %r = arith.index_cast %p : index to i64
    macro.yield %r : i64
  };
}

// Make this thread's shared-memory stores visible to the async proxy (wgmma operand reads).
fn fence_proxy_async() on Topology::Device -> i32 {
  return mlir!( inputs : (), returns : i32, dialects : ["llvm", "arith"]) {
    llvm.inline_asm has_side_effects "fence.proxy.async.shared::cta;", "" : () -> ()
    %z = arith.constant 0 : i32
    macro.yield %z : i32
  };
}

// The no-swizzle K-major descriptor of a 64-row block at shared byte address addr.
fn kmajor_desc(addr: i64) on Topology::Device -> i64 {
  return ((addr & 262143) >> 4) | (8 << 16) | (64 << 32);
}

// Copy rows row0 .. row0 + 63, words kw .. kw + 31 of src (words_per_row words a row) into tile in
// the core-matrix layout above. 2048 words, 16 for each of the 128 threads, coalesced in w.
fn stage_block(tile: &mut Tensor<i32, [2048], Memory::SMEM>, src: &Tensor<i32, [?], Memory::HBM>, row0: i32,
               words_per_row: i64, kw: i64, tid: i32) on Topology::Device -> void {
  for p in 0..16 {
    let idx: i32 = tid + 128 * (p as i32);
    let r: i32 = idx >> 5;
    let w: i32 = idx & 31;
    tile[((r >> 3) * 8 + (w >> 2)) * 32 + (r & 7) * 4 + (w & 3)] = src[((row0 + r) as i64) * words_per_row + kw + (w as i64)];
  }
  return;
}

