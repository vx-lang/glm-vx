    memref.store %d30, %acc[%i30] : memref<32xf32>
    %d31 = llvm.extractvalue %d[31] : !llvm.struct<(f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32)>
    memref.store %d31, %acc[%i31] : memref<32xf32>
    %z = arith.constant 0 : i32
    macro.yield %z : i32
  };
}

pub fn glm_vx_probe_wgmma_fp8(out: &mut Tensor<f32, [?], Memory::HBM>, a: &Tensor<i32, [?], Memory::HBM>,
                              b: &Tensor<i32, [?], Memory::HBM>, a_scale: &Tensor<f32, [?], Memory::HBM>,
                              b_scale: &Tensor<f32, [?], Memory::HBM>, rows_m: i32, rows_n: i32, cols: i32) -> void {
  spawn on(Topology::Device) grid([(rows_m / 64) * (rows_n / 64)]) block(128) {
    let tid: i32 = thread_id();
    let tile: i32 = block_id();
    let tiles_n: i32 = rows_n / 64;
    let mut acc = Tensor<f32, [32], Memory::REG>::fill(0.0);
    let mut part = Tensor<f32, [32], Memory::REG>::fill(0.0);
    let mut a_tile = unsafe { Tensor<i32, [2048], Memory::SMEM>::uninit() };
    let mut b_tile = unsafe { Tensor<i32, [2048], Memory::SMEM>::uninit() };
    // Declared before the `if`, as in wgmma_bf16_sm90a.vx: the k-block counter.
    let mut kb: i64 = 0;
    if rows_m % 64 == 0 && rows_n % 64 == 0 && cols % 128 == 0 && tiles_n > 0 && tile < (rows_m / 64) * tiles_n {
      let m0: i32 = (tile / tiles_n) * 64;
      let n0: i32 = (tile % tiles_n) * 64;
      let words: i64 = (cols / 4) as i64;
      let blocks: i64 = (cols / 128) as i64;
      let lane: i32 = tid & 31;
      let r_lo: i64 = (m0 + 16 * (tid >> 5) + (lane >> 2)) as i64;
      let b_row: i64 = ((n0 / 128) as i64) * blocks;
      let a_desc: i64 = kmajor_desc(smem_address(&mut a_tile));
      let b_desc: i64 = kmajor_desc(smem_address(&mut b_tile));
      while kb < blocks {
        let kw: i64 = kb * 32;
        stage_block(&mut a_tile, a, m0, words, kw, tid);
        stage_block(&mut b_tile, b, n0, words, kw, tid);
        let _f: i32 = fence_proxy_async();
        barrier();
        let _z: i32 = wgmma_fp8_k128(&mut part, a_desc, b_desc);
        barrier();
        let sb: f32 = b_scale[b_row + kb];
        let s_lo: f32 = a_scale[r_lo * blocks + kb] * sb;
        let s_hi: f32 = a_scale[(r_lo + 8) * blocks + kb] * sb;
        // The block-FP8 epilogue: a plain loop over the REG tensors, unrolled by Vx.
        for j in 0..8 {
          acc[4 * j] = acc[4 * j] + part[4 * j] * s_lo;
          acc[4 * j + 1] = acc[4 * j + 1] + part[4 * j + 1] * s_lo;
          acc[4 * j + 2] = acc[4 * j + 2] + part[4 * j + 2] * s_hi;
          acc[4 * j + 3] = acc[4 * j + 3] + part[4 * j + 3] * s_hi;
        }
        kb = kb + 1;
      }
      let t: i32 = lane & 3;
      let n_count: i64 = rows_n as i64;
      let out_lo: i64 = r_lo * n_count + ((n0 + 2 * t) as i64);
      let out_hi: i64 = out_lo + 8 * n_count;
      for j in 0..8 {
        let col: i64 = 8 * (j as i64);
        out[out_lo + col] = acc[4 * j];
        out[out_lo + col + 1] = acc[4 * j + 1];
        out[out_hi + col] = acc[4 * j + 2];
        out[out_hi + col + 1] = acc[4 * j + 3];
      }
    }
  }
  return;
}
