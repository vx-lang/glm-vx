// glm_vx_gpu_bf16_matvec through Vx's own GPU path: out[rows] = W[rows, cols] x[cols] with W
// raw bfloat16 bits, one warp of 32 lanes per row (four per block), i64 indexing, float32
// accumulation, and lanes::sum over the subgroup.
// spawn-include: device.vx

pub fn glm_vx_spawn_bf16_matvec(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u16, [?], Memory::HBM>,
                                x: &Tensor<f32, [?], Memory::HBM>, rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..(rows - 1) / 4 + 1 across blocks {
      let mut a = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for lane in 0..32 across lanes {
          let row: i64 = ((rb * 4 + w) as i64);
          let mut sum: f32 = 0.0;
          if row < (rows as i64) {
            let k: i64 = cols as i64;
            let row_base: i64 = row * k;
            let mut col: i64 = lane as i64;
            while col < k {
              sum = sum + bf16_decode!(weight[row_base + col] as i32) * x[col];
              col = col + 32;
            }
          }
          a[w][lane] = sum;
        }
        let total: f32 = lanes::sum(&a[w], 32);
        if rb * 4 + w < rows && cols >= 0 { out[rb * 4 + w] = total; }
      }
    }
  }
  return;
}
