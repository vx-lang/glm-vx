// glm_vx_gpu_bf16_matvec through Vx's own GPU path: out[rows] = W[rows, cols] x[cols] with W
// raw bfloat16 bits, one warp per row, i64 indexing, float32 accumulation.
// spawn-include: device.vx
// spawn-kernel: glm_vx_spawn_bf16_matvec(rows: i32, cols: i32, weight: u16[?], x: f32[?], out: mut f32[?])

// gpu/bf16.vx's glm_vx_bf16_decode unchanged, as a device function: exact for all 65,536
// encodings from power-of-two products. A bit cast would be shorter, but f32::from_bits
// crashes vxc in device code (#1943).
fn bf16_decode(bits: i32) on Topology::Device -> f32 {
  let exponent: i32 = (bits >> 7) & 255;
  let mantissa: i32 = bits & 127;
  let mut magnitude: f32 = (mantissa as f32) / 128.0;
  let mut shift: i32 = -126;
  if exponent > 0 {
    magnitude = ((128 + mantissa) as f32) / 128.0;
    shift = exponent - 127;
  }
  let mut power: f32 = 1.0;
  while shift > 30 { power = power * 1073741824.0; shift = shift - 30; }
  while shift < -30 { power = power / 1073741824.0; shift = shift + 30; }
  if shift >= 0 { power = power * ((1 << shift) as f32); }
  if shift < 0 { power = power / ((1 << (0 - shift)) as f32); }
  magnitude = magnitude * power;
  if exponent == 255 {
    if mantissa == 0 { magnitude = 1.0 / 0.0; }
    if mantissa != 0 { magnitude = 0.0 / 0.0; }
  }
  let mut sign: f32 = 1.0;
  if (bits & 32768) != 0 { sign = -1.0; }
  return magnitude * sign;
}

pub fn bf16_matvec(out: &mut Tensor<f32, [?], Memory::HBM>, weight: &Tensor<u16, [?], Memory::HBM>,
                   x: &Tensor<f32, [?], Memory::HBM>, rows: i32, cols: i32) -> void {
  spawn on(Topology::Device) {
    let tid: i32 = thread_id();
    let lane: i32 = tid & 31;
    let block: i32 = block_dim();
    let warps: i32 = block / 32;
    let row: i64 = (block_id() as i64) * (warps as i64) + ((tid / 32) as i64);
    if rows > 0 && cols >= 0 && block >= 32 && block <= 1024 && block % 32 == 0 && row < (rows as i64) {
      let k: i64 = cols as i64;
      let row_base: i64 = row * k;
      let mut sum: f32 = 0.0;
      let mut col: i64 = lane as i64;
      while col < k {
        sum = sum + bf16_decode(weight[row_base + col] as i32) * x[col];
        col = col + 32;
      }
      let total: f32 = warp_sum(sum);
      if lane == 0 { out[row] = total; }
    }
  }
  return;
}
