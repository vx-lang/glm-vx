// The router's projection and the router in one launch (fuse_router).
//   - logits = W x, W the [experts, cols] BF16 gate (raw bits viewed as u32, cols % 8 == 0), one block of
//     1024 lanes a row, as matvec_rows (gpu/matvec_rows.vx) for float32: every lane loads its 16-byte run
//     of the row at once and stores the exact products to shared memory, then lanes 0..31 add them in the
//     hand bf16_matvec's order (lane l: columns l, l + 32, .. in turn, then the warp tree). So the logits
//     are glm_vx_gpu_bf16_matvec's bit for bit, which are the float32 matvec's on the same values. (One
//     warp a row, as bf16_matvec4, walks a 6144-column row in 24 steps: 9 us for 16 rows on the H200.)
//   - The last block to finish picks k <= 8 of experts <= 256 by score = sigmoid(logit) + bias, highest
//     first, ties to the lower id: router.vx's choice and order. One warp runs k rounds: lane l holds
//     experts l, l + 32, .. in registers, offers the best still in, and lanes::argmax (the higher score,
//     or the same and the lower id: the router's order) picks round r's, the expert of rank r, for slot r.
//     (Two passes of ranks with shared-memory atomics in the block took 5.5 us of the launch's 12.2 on the
//     H200, ncu, evidence/h200-20261119-z26; one pass over all 256, 7.7 us.) Its weight is the expert's
//     sigmoid, normalized over the k (lanes::sum, the same order in a subgroup as in a block) and scaled
//     as router.vx does. A NaN score is where the two may differ (it never wins a round here). sigmoid! is libdevice's expf (device.vx), the hand router's ex2.approx: on the GPU the weights
//     are gpu/spawn router's, not the hand router's, to the last bits.
// Slots k and above of indices and weights are not written (fold_shared's shared-expert slot). arrivals:
// one u32, zero before the first launch; the last block puts it back to zero.
// spawn-include: device.vx
// spawn-maxnreg: 32 (1024-lane blocks: two an SM, the 256 rows in one wave; the tail's registers would raise it to 61)

// 1 if expert `o` (score `other`) beats expert `e` (score `mine`): a higher score, or the same and a lower
// id; an id at or past `experts` never does.
macro_rules! beats {
    ($other:expr, $o:expr, $mine:expr, $e:expr, $experts:expr) => {
        unsafe {
          let dv_other: f32 = $other;
          let dv_o: i32 = $o;
          if dv_o < $experts && (dv_other > $mine || (dv_other == $mine && dv_o < $e)) { 1 } else { 0 }
        }
    };
}

pub extern fn glm_vx_spawn_router_bf16(indices: &mut Tensor<i32, [?], Memory::HBM>, weights: &mut Tensor<f32, [?], Memory::HBM>,
                                       logits: &mut Tensor<f32, [?], Memory::HBM>, gate: &Tensor<u32, [?], Memory::HBM>,
                                       x: &Tensor<f32, [?], Memory::HBM>, bias: &Tensor<f32, [?], Memory::HBM>,
                                       experts: i32, cols: i32, k: i32, scale: f32) -> void {
  spawn on(Topology::Device) {
    for row in 0..experts across blocks {
      let mut products = unsafe { Tensor<f32, [8192], Memory::SMEM>::uninit() };
      let mut part = unsafe { Tensor<f32, [32], Memory::SMEM>::uninit() };
      // Runs of eight columns (four words): 768 of them in a 6144-column row, one a lane.
      for q in 0..1024 across lanes {
        if cols % 8 == 0 && cols <= 8192 {
          let runs: i32 = cols / 8;
          // row * words, written with its factor 4 so that LLVM sees a 16-byte-aligned row (Vx #2362).
          let row_words: i64 = (row as i64) * (runs as i64) * 4;
          if q < runs {
            let at: i64 = row_words + (q as i64) * 4;
            let w0: i32 = gate[at] as i32;
            let w1: i32 = gate[at + 1] as i32;
            let w2: i32 = gate[at + 2] as i32;
            let w3: i32 = gate[at + 3] as i32;
            let c: i32 = 8 * q;
            products[c] = bf16_decode!(w0) * x[c];
            products[c + 1] = bf16_decode!(w0 >> 16) * x[c + 1];
            products[c + 2] = bf16_decode!(w1) * x[c + 2];
            products[c + 3] = bf16_decode!(w1 >> 16) * x[c + 3];
            products[c + 4] = bf16_decode!(w2) * x[c + 4];
            products[c + 5] = bf16_decode!(w2 >> 16) * x[c + 5];
            products[c + 6] = bf16_decode!(w3) * x[c + 6];
            products[c + 7] = bf16_decode!(w3 >> 16) * x[c + 7];
          }
        }
      }
      // The hand bf16_matvec's order, eight loads before their adds (one load, then its add, cost about
      // 4 us a 6144-column row). A term past the row is +0.0, and sum starts at +0.0, so is never -0.0:
      // adding it changes nothing.
      for lane in 0..32 across lanes {
        let mut sum: f32 = 0.0;
        if cols % 8 == 0 && cols <= 8192 {
          for batch in 0..(cols + 255) / 256 {
            let d: i32 = lane + 256 * batch;
            let p0: f32 = if d < cols { products[d] } else { 0.0 };
            let p1: f32 = if d + 32 < cols { products[d + 32] } else { 0.0 };
            let p2: f32 = if d + 64 < cols { products[d + 64] } else { 0.0 };
            let p3: f32 = if d + 96 < cols { products[d + 96] } else { 0.0 };
            let p4: f32 = if d + 128 < cols { products[d + 128] } else { 0.0 };
            let p5: f32 = if d + 160 < cols { products[d + 160] } else { 0.0 };
            let p6: f32 = if d + 192 < cols { products[d + 192] } else { 0.0 };
            let p7: f32 = if d + 224 < cols { products[d + 224] } else { 0.0 };
            sum = sum + p0;
            sum = sum + p1;
            sum = sum + p2;
            sum = sum + p3;
            sum = sum + p4;
            sum = sum + p5;
            sum = sum + p6;
            sum = sum + p7;
          }
        }
        part[lane] = sum;
      }
      let total: f32 = lanes::sum(&part, 32);
      if cols >= 0 { logits[row] = total; }
    }
    // The last block to finish. Each part is a loop of one trip or none, not an `if` around lane loops.
    let mut sg = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
    let mut sc = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
    for once in 0..(if experts > 0 && experts <= 256 && k > 0 && k <= 8 && k <= experts && cols % 8 == 0 { 1 } else { 0 }) {
      for e in 0..256 across lanes {
        if e < experts {
          let s: f32 = sigmoid!(logits[e]);
          sg[e] = s;
          sc[e] = s + bias[e];
        }
      }
      // One warp, k rounds: each lane offers the best of its experts l, l + 32, .. still in, and lanes::argmax
      // (the higher score, the same and the lower id) picks round r's, the expert of rank r: slot r.
      let mut ms = unsafe { Tensor<f32, [1, 8, 32], Memory::SMEM>::uninit() };
      let mut mi = unsafe { Tensor<i32, [1, 8, 32], Memory::SMEM>::uninit() };
      let mut bv = unsafe { Tensor<f32, [1, 32], Memory::SMEM>::uninit() };
      let mut bi = unsafe { Tensor<i32, [1, 32], Memory::SMEM>::uninit() };
      let mut sel = unsafe { Tensor<i32, [1, 32], Memory::SMEM>::uninit() };
      let mut sa = unsafe { Tensor<f32, [1, 32], Memory::SMEM>::uninit() };
      for w in 0..1 across subgroups {
        for l in 0..32 across lanes {
          for j in 0..8 {
            let e: i32 = l + 32 * j;
            ms[w][j][l] = if e < experts { sc[e] } else { 0.0 };
            mi[w][j][l] = if e < experts { e } else { -1 };
          }
          sel[w][l] = -1;
        }
        for r in 0..8 {
          if r < k {
            for l in 0..32 across lanes {
              let mut best: f32 = 0.0;
              let mut best_id: i32 = -1;
              for j in 0..8 {
                let c: i32 = mi[w][j][l];
                let x: f32 = ms[w][j][l];
                let take: bool = c >= 0 && (best_id < 0 || x > best || (x == best && c < best_id));
                best = if take { x } else { best };
                best_id = if take { c } else { best_id };
              }
              bv[w][l] = best;
              bi[w][l] = best_id;
            }
            let win: i32 = lanes::argmax(&bv[w], &bi[w], 32);
            for l in 0..32 across lanes {
              for j in 0..8 {
                if mi[w][j][l] == win { mi[w][j][l] = -1; }
              }
              if l == r { sel[w][l] = win; }
            }
          }
        }
        for l in 0..32 across lanes {
          sa[w][l] = if l < k { sg[sel[w][l].max(0).min(255)] } else { 0.0 };
        }
        let total: f32 = lanes::sum(&sa[w], 32);
        for l in 0..32 across lanes {
          if l < k {
            let e: i32 = sel[w][l].max(0).min(255);
            indices[l] = e;
            weights[l] = sg[e] / (total + 0.00000000000000000001) * scale;
          }
        }
      }
    }
  }
  return;
}
