import core::num;
// Device helpers shared by the gpu/spawn kernels; build.py pastes this file in front of a
// kernel that declares `// spawn-include: device.vx`. They are macros, not functions: the race
// proof of an `across` loop refuses a call to a function whose body it does not read, so each
// helper expands in the loop. A macro expands to an expression, so a helper with statements is
// an `unsafe { .. }` block. Names inside start with `dv_`, so they do not hide the caller's.

// bfloat16 bits to f32, exact for all 65,536 encodings: gpu/bf16.vx's glm_vx_bf16_decode
// unchanged. f32::from_bits is not one of the calls the race proof takes as pure.
macro_rules! bf16_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          let dv_exponent: i32 = (dv_bits >> 7) & 255;
          let dv_mantissa: i32 = dv_bits & 127;
          let mut dv_magnitude: f32 = (dv_mantissa as f32) / 128.0;
          let mut dv_shift: i32 = -126;
          if dv_exponent > 0 {
            dv_magnitude = ((128 + dv_mantissa) as f32) / 128.0;
            dv_shift = dv_exponent - 127;
          }
          let mut dv_power: f32 = 1.0;
          while dv_shift > 30 { dv_power = dv_power * 1073741824.0; dv_shift = dv_shift - 30; }
          while dv_shift < -30 { dv_power = dv_power / 1073741824.0; dv_shift = dv_shift + 30; }
          if dv_shift >= 0 { dv_power = dv_power * ((1 << dv_shift) as f32); }
          if dv_shift < 0 { dv_power = dv_power / ((1 << (0 - dv_shift)) as f32); }
          dv_magnitude = dv_magnitude * dv_power;
          if dv_exponent == 255 {
            if dv_mantissa == 0 { dv_magnitude = 1.0 / 0.0; }
            if dv_mantissa != 0 { dv_magnitude = 0.0 / 0.0; }
          }
          let mut dv_sign: f32 = 1.0;
          if (dv_bits & 32768) != 0 { dv_sign = -1.0; }
          dv_magnitude * dv_sign
        }
    };
}

// IEEE binary16 bits to f32, exact for every encoding: gpu/int4.vx's glm_vx_i4_half.
macro_rules! half_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          let dv_exponent: i32 = (dv_bits >> 10) & 31;
          let dv_mantissa: i32 = dv_bits & 1023;
          let mut dv_magnitude: f32 = (dv_mantissa as f32) / 16777216.0;
          if dv_exponent > 0 {
            let mut dv_power: f32 = 1.0;
            if dv_exponent >= 15 { dv_power = ((1 << (dv_exponent - 15)) as f32); }
            if dv_exponent < 15 { dv_power = 1.0 / ((1 << (15 - dv_exponent)) as f32); }
            dv_magnitude = ((1024 + dv_mantissa) as f32) * dv_power / 1024.0;
          }
          if dv_exponent == 31 {
            if dv_mantissa == 0 { dv_magnitude = 1.0 / 0.0; }
            if dv_mantissa != 0 { dv_magnitude = 0.0 / 0.0; }
          }
          let mut dv_sign: f32 = 1.0;
          if (dv_bits & 32768) != 0 { dv_sign = -1.0; }
          dv_magnitude * dv_sign
        }
    };
}

// A raw 16-bit group scale: bfloat16 when kind != 0, binary16 otherwise.
macro_rules! group_scale {
    ($bits:expr, $kind:expr) => {
        unsafe {
          let dv_scale_bits: i32 = $bits;
          let mut dv_scale: f32 = 0.0;
          if $kind != 0 { dv_scale = bf16_decode!(dv_scale_bits); } else { dv_scale = half_decode!(dv_scale_bits); }
          dv_scale
        }
    };
}

// Signed 4-bit code: high 0 is the low nibble, 1 the high nibble.
macro_rules! int4_code {
    ($byte:expr, $high:expr) => {
        unsafe {
          let dv_byte: i32 = $byte;
          let mut dv_nibble: i32 = dv_byte & 15;
          if $high != 0 { dv_nibble = (dv_byte >> 4) & 15; }
          if dv_nibble >= 8 { dv_nibble = dv_nibble - 16; }
          dv_nibble as f32
        }
    };
}

// e4m3fn byte to f32, exact: gpu/fp8.vx's glm_vx_fp8_decode (= fp8_batched.vx's
// glm_vx_fp8m_decode). No infinity; S.1111.111 is NaN.
macro_rules! fp8_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          let dv_exponent: i32 = (dv_bits >> 3) & 15;
          let dv_mantissa: i32 = dv_bits & 7;
          let mut dv_magnitude: f32 = (dv_mantissa as f32) / 512.0;
          if dv_exponent > 0 {
            let dv_power: i32 = 1 << (dv_exponent - 1);
            dv_magnitude = ((8 + dv_mantissa) as f32) * (dv_power as f32) / 512.0;
          }
          if dv_exponent == 15 { if dv_mantissa == 7 { dv_magnitude = 0.0 / 0.0; } }
          let mut dv_sign: f32 = 1.0;
          if (dv_bits & 128) != 0 { dv_sign = -1.0; }
          dv_magnitude * dv_sign
        }
    };
}

// The hand kernels' vxk_sigmoid: the exp argument is never positive, so it cannot overflow.
// exp is f32::fast_exp (libdevice's expf), not the hand kernels' ex2.approx.ftz(x * log2 e):
// that one needs an `mlir!` block, which an `across` loop takes only from Vx #2076 D1-D3 on.
macro_rules! sigmoid {
    ($x:expr) => {
        unsafe {
          let dv_x: f32 = $x;
          let mut dv_result: f32 = 0.0;
          if dv_x >= 0.0 { dv_result = 1.0 / (1.0 + (0.0 - dv_x).fast_exp()); }
          else { let dv_z: f32 = dv_x.fast_exp(); dv_result = dv_z / (1.0 + dv_z); }
          dv_result
        }
    };
}

// The router slot that holds the slot-th smallest of the k expert ids in ids[0..k]: the order the
// official Experts sums in (ascending id, whatever the top-k order), found on the device so the
// host never reads the ids. The router's ids are distinct.
macro_rules! ascending_slot {
    ($ids:ident, $k:expr, $slot:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_slot: i32 = $slot;
          let mut dv_found: i32 = 0;
          let mut dv_c: i32 = 0;
          while dv_c < dv_k {
            let mut dv_rank: i32 = 0;
            let mut dv_o: i32 = 0;
            while dv_o < dv_k { if $ids[dv_o] < $ids[dv_c] { dv_rank = dv_rank + 1; } dv_o = dv_o + 1; }
            if dv_rank == dv_slot { dv_found = dv_c; }
            dv_c = dv_c + 1;
          }
          dv_found
        }
    };
}

// The rank of router slot `lane` among ids[0..k] (how many ids are smaller), or 0 for a lane at
// or past k: the fused MoE kernels keep each lane's rank in shared memory, then find the slot
// whose rank is s with slot_of_rank!, k loads where ascending_slot! takes k * k.
macro_rules! id_rank {
    ($ids:ident, $k:expr, $lane:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_lane: i32 = $lane;
          let mut dv_rank: i32 = 0;
          if dv_lane < dv_k {
            let mut dv_o: i32 = 0;
            while dv_o < dv_k { if $ids[dv_o] < $ids[dv_lane] { dv_rank = dv_rank + 1; } dv_o = dv_o + 1; }
          }
          dv_rank
        }
    };
}

// The router slot j < k with ranks[w][j] == s: ascending_slot!(ids, k, s) from id_rank!'s ranks.
macro_rules! slot_of_rank {
    ($ranks:ident, $w:expr, $k:expr, $s:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_s: i32 = $s;
          let mut dv_found: i32 = 0;
          let mut dv_j: i32 = 0;
          while dv_j < dv_k { if $ranks[$w][dv_j] == dv_s { dv_found = dv_j; } dv_j = dv_j + 1; }
          dv_found
        }
    };
}

// One lane's share of row `row` of expert `expert`'s [rows, n] matrix dotted with x[xo..xo + n]:
// columns lane, lane + 32, .., as expert_matvec.vx and its formats, so lanes::sum of the 32
// shares is the expert kernels' result to the last bit. The fused MoE kernels use these.
macro_rules! f32_row_dot {
    ($weight:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + $row) * dv_n;
          let mut dv_sum: f32 = 0.0;
          let mut dv_c: i64 = $lane as i64;
          while dv_c < dv_n {
            dv_sum = dv_sum + $weight[dv_base + dv_c] * $x[dv_xo + dv_c];
            dv_c = dv_c + 32;
          }
          dv_sum
        }
    };
}

macro_rules! bf16_row_dot {
    ($weight:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + $row) * dv_n;
          let mut dv_sum: f32 = 0.0;
          let mut dv_c: i64 = $lane as i64;
          while dv_c < dv_n {
            dv_sum = dv_sum + bf16_decode!($weight[dv_base + dv_c] as i32) * $x[dv_xo + dv_c];
            dv_c = dv_c + 32;
          }
          dv_sum
        }
    };
}

// 128x128 blocks: the scale of (row, column tile) is scales[(expert * scale_rows + row / 128) *
// scale_cols + tile].
macro_rules! fp8_row_dot {
    ($weight:ident, $scales:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_row: i64 = $row;
          let dv_scale_cols: i64 = (dv_n + 127) / 128;
          let dv_scale_rows: i64 = (($rows as i64) + 127) / 128;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + dv_row) * dv_n;
          let dv_scale_base: i64 = (($expert as i64) * dv_scale_rows + dv_row / 128) * dv_scale_cols;
          let mut dv_sum: f32 = 0.0;
          let mut dv_tile: i64 = 0;
          while dv_tile < dv_scale_cols {
            let dv_scale: f32 = $scales[dv_scale_base + dv_tile];
            let dv_tile_base: i64 = dv_tile * 128 + ($lane as i64);
            let mut dv_step: i32 = 0;
            while dv_step < 4 {
              let dv_col: i64 = dv_tile_base + ((dv_step * 32) as i64);
              if dv_col < dv_n {
                let dv_value: f32 = fp8_decode!($weight[dv_base + dv_col] as i32);
                dv_sum = dv_sum + (dv_value * dv_scale) * $x[dv_xo + dv_col];
              }
              dv_step = dv_step + 1;
            }
            dv_tile = dv_tile + 1;
          }
          dv_sum
        }
    };
}

// Groups of 128 columns, two codes a byte (low nibble first), a 16-bit scale a group.
macro_rules! int4_row_dot {
    ($packed:ident, $scales:ident, $kind:expr, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_lane: i32 = $lane;
          let dv_groups: i64 = (dv_n + 127) / 128;
          let dv_row_bytes: i64 = (dv_n + 1) / 2;
          let dv_expert_row: i64 = ($expert as i64) * ($rows as i64) + $row;
          let mut dv_sum: f32 = 0.0;
          let mut dv_group: i64 = 0;
          while dv_group < dv_groups {
            let dv_scale: f32 = group_scale!($scales[dv_expert_row * dv_groups + dv_group] as i32, $kind);
            let mut dv_part: f32 = 0.0;
            let mut dv_step: i32 = 0;
            while dv_step < 2 {
              let dv_byte_index: i64 = dv_group * 64 + ((dv_step * 32 + dv_lane) as i64);
              let dv_col: i64 = dv_byte_index * 2;
              if dv_col < dv_n {
                let dv_byte: i32 = $packed[dv_expert_row * dv_row_bytes + dv_byte_index] as i32;
                dv_part = dv_part + int4_code!(dv_byte, 0) * $x[dv_xo + dv_col];
                if dv_col + 1 < dv_n { dv_part = dv_part + int4_code!(dv_byte, 1) * $x[dv_xo + dv_col + 1]; }
              }
              dv_step = dv_step + 1;
            }
            dv_sum = dv_sum + dv_part * dv_scale;
            dv_group = dv_group + 1;
          }
          dv_sum
        }
    };
}
