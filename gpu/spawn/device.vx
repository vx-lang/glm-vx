import core::num;
// Device helpers shared by the gpu/spawn kernels; build.py pastes this file in front of a
// kernel that declares `// spawn-include: device.vx`. They are macros, not functions: the race
// proof of an `across` loop refuses a call to a function whose body it does not read, so each
// helper expands in the loop. A macro expands to an expression, so a helper with statements is
// an `unsafe { .. }` block. Names inside start with `dv_`, so they do not hide the caller's.

// bfloat16 bits to f32: the bits are the top half of the binary32, so one shift and a bit cast.
// Equal to gpu/bf16.vx's glm_vx_bf16_decode for every encoding but NaN, whose payload it keeps.
// Several f32::from_bits calls in one across loop need Vx c1dc2752 or later (#2363, Vx #2361).
macro_rules! bf16_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          f32::from_bits(((dv_bits & 65535) as u32) << 16u32)
        }
    };
}

// IEEE binary16 bits to f32, exact for every encoding: gpu/int4.vx's glm_vx_i4_half. Exponent and
// mantissa moved to binary32's place give the value times 2^-112 (a subnormal one stays exact: the
// multiply does not flush); exponent 31 is infinity or NaN, rebuilt with binary32's.
macro_rules! half_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          let dv_sign: u32 = ((dv_bits & 32768) as u32) << 16u32;
          let dv_body: u32 = ((dv_bits & 32767) as u32) << 13u32;
          let mut dv_value: f32 = f32::from_bits(dv_sign | dv_body) * f32::from_bits(2004877312u32);
          if (dv_bits & 31744) == 31744 { dv_value = f32::from_bits(dv_sign | 2139095040u32 | dv_body); }
          dv_value
        }
    };
}

// A raw 16-bit group scale: bfloat16 when kind != 0, binary16 otherwise.
macro_rules! group_scale {
    ($bits:expr, $kind:expr) => {
        unsafe {
          let dv_scale_bits: i32 = $bits;
          let mut dv_scale: f32 = 0.0;
          if $kind != 0 { dv_scale = bf16_decode!(dv_scale_bits); } else { dv_scale = half_decode!(dv_scale_bits); }
          dv_scale
        }
    };
}

// Signed 4-bit code: high 0 is the low nibble, 1 the high nibble.
macro_rules! int4_code {
    ($byte:expr, $high:expr) => {
        unsafe {
          let dv_byte: i32 = $byte;
          let mut dv_nibble: i32 = dv_byte & 15;
          if $high != 0 { dv_nibble = (dv_byte >> 4) & 15; }
          if dv_nibble >= 8 { dv_nibble = dv_nibble - 16; }
          dv_nibble as f32
        }
    };
}

// e4m3fn byte to f32, exact: gpu/fp8.vx's glm_vx_fp8_decode (= fp8_batched.vx's
// glm_vx_fp8m_decode). No infinity; S.1111.111 is NaN. Exponent and mantissa moved to binary32's
// place give the value times 2^-120 (subnormal codes too: the multiply does not flush).
macro_rules! fp8_decode {
    ($bits:expr) => {
        unsafe {
          let dv_bits: i32 = $bits;
          let dv_value: u32 = (((dv_bits & 128) as u32) << 24u32) | (((dv_bits & 127) as u32) << 20u32);
          let mut dv_decoded: f32 = f32::from_bits(dv_value) * f32::from_bits(2071986176u32);
          if (dv_bits & 127) == 127 { dv_decoded = 0.0 / 0.0; }
          dv_decoded
        }
    };
}

// $a * $b + $c rounded once (math.fma, PTX fma.rn.f32). Vx writes every other float op with its own
// rounding (.rn), so ptxas never fuses a multiply and an add; this is the only way to get FFMA. The
// block says writes_only(), so an `across` loop may hold it (Vx #2552); a call to f32::mul_add may
// not (E6032).
macro_rules! fma32 {
    ($a:expr, $b:expr, $c:expr) => {
        unsafe {
          let dv_fa: f32 = $a;
          let dv_fb: f32 = $b;
          let dv_fc: f32 = $c;
          let dv_fr: f32 = mlir!( inputs : (%x = dv_fa : f32, %y = dv_fb : f32, %z = dv_fc : f32), returns : f32,
                                  dialects : ["math"], ensures : [writes_only()]) {
            %r = math.fma %x, %y, %z : f32
            macro.yield %r : f32
          };
          dv_fr
        }
    };
}

// The hand kernels' vxk_sigmoid: the exp argument is never positive, so it cannot overflow.
// exp is f32::fast_exp (libdevice's expf), not the hand kernels' ex2.approx.ftz(x * log2 e):
// that one needs an `mlir!` block, which an `across` loop takes only from Vx #2076 D1-D3 on.
macro_rules! sigmoid {
    ($x:expr) => {
        unsafe {
          let dv_x: f32 = $x;
          let mut dv_result: f32 = 0.0;
          if dv_x >= 0.0 { dv_result = 1.0 / (1.0 + (0.0 - dv_x).fast_exp()); }
          else { let dv_z: f32 = dv_x.fast_exp(); dv_result = dv_z / (1.0 + dv_z); }
          dv_result
        }
    };
}

// The router slot that holds the slot-th smallest of the k expert ids in ids[0..k]: the order the
// official Experts sums in (ascending id, whatever the top-k order), found on the device so the
// host never reads the ids. The router's ids are distinct.
macro_rules! ascending_slot {
    ($ids:ident, $k:expr, $slot:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_slot: i32 = $slot;
          let mut dv_found: i32 = 0;
          let mut dv_c: i32 = 0;
          while dv_c < dv_k {
            let mut dv_rank: i32 = 0;
            let mut dv_o: i32 = 0;
            while dv_o < dv_k { if $ids[dv_o] < $ids[dv_c] { dv_rank = dv_rank + 1; } dv_o = dv_o + 1; }
            if dv_rank == dv_slot { dv_found = dv_c; }
            dv_c = dv_c + 1;
          }
          dv_found
        }
    };
}

// The rank of router slot `lane` among ids[0..k] (how many ids are smaller), or 0 for a lane at
// or past k: the fused MoE kernels keep each lane's rank in shared memory, then find the slot
// whose rank is s with slot_of_rank!, k loads where ascending_slot! takes k * k.
macro_rules! id_rank {
    ($ids:ident, $k:expr, $lane:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_lane: i32 = $lane;
          let mut dv_rank: i32 = 0;
          if dv_lane < dv_k {
            let mut dv_o: i32 = 0;
            while dv_o < dv_k { if $ids[dv_o] < $ids[dv_lane] { dv_rank = dv_rank + 1; } dv_o = dv_o + 1; }
          }
          dv_rank
        }
    };
}

// The router slot j < k with ranks[w][j] == s: ascending_slot!(ids, k, s) from id_rank!'s ranks.
macro_rules! slot_of_rank {
    ($ranks:ident, $w:expr, $k:expr, $s:expr) => {
        unsafe {
          let dv_k: i32 = $k;
          let dv_s: i32 = $s;
          let mut dv_found: i32 = 0;
          let mut dv_j: i32 = 0;
          while dv_j < dv_k { if $ranks[$w][dv_j] == dv_s { dv_found = dv_j; } dv_j = dv_j + 1; }
          dv_found
        }
    };
}

// One lane's share of row `row` of expert `expert`'s [rows, n] matrix dotted with x[xo..xo + n]:
// columns lane, lane + 32, .., as expert_matvec.vx and its formats, so lanes::sum of the 32
// shares is the expert kernels' result to the last bit. The fused MoE kernels use these.
macro_rules! f32_row_dot {
    ($weight:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + $row) * dv_n;
          let mut dv_sum: f32 = 0.0;
          let mut dv_c: i64 = $lane as i64;
          while dv_c < dv_n {
            dv_sum = dv_sum + $weight[dv_base + dv_c] * $x[dv_xo + dv_c];
            dv_c = dv_c + 32;
          }
          dv_sum
        }
    };
}

macro_rules! bf16_row_dot {
    ($weight:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + $row) * dv_n;
          let mut dv_sum: f32 = 0.0;
          let mut dv_c: i64 = $lane as i64;
          while dv_c < dv_n {
            dv_sum = dv_sum + bf16_decode!($weight[dv_base + dv_c] as i32) * $x[dv_xo + dv_c];
            dv_c = dv_c + 32;
          }
          dv_sum
        }
    };
}

// 128x128 blocks: the scale of (row, column tile) is scales[(expert * scale_rows + row / 128) *
// scale_cols + tile].
macro_rules! fp8_row_dot {
    ($weight:ident, $scales:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_row: i64 = $row;
          let dv_scale_cols: i64 = (dv_n + 127) / 128;
          let dv_scale_rows: i64 = (($rows as i64) + 127) / 128;
          let dv_base: i64 = (($expert as i64) * ($rows as i64) + dv_row) * dv_n;
          let dv_scale_base: i64 = (($expert as i64) * dv_scale_rows + dv_row / 128) * dv_scale_cols;
          let mut dv_sum: f32 = 0.0;
          let mut dv_tile: i64 = 0;
          while dv_tile < dv_scale_cols {
            let dv_scale: f32 = $scales[dv_scale_base + dv_tile];
            let dv_tile_base: i64 = dv_tile * 128 + ($lane as i64);
            let mut dv_step: i32 = 0;
            while dv_step < 4 {
              let dv_col: i64 = dv_tile_base + ((dv_step * 32) as i64);
              if dv_col < dv_n {
                let dv_value: f32 = fp8_decode!($weight[dv_base + dv_col] as i32);
                dv_sum = dv_sum + (dv_value * dv_scale) * $x[dv_xo + dv_col];
              }
              dv_step = dv_step + 1;
            }
            dv_tile = dv_tile + 1;
          }
          dv_sum
        }
    };
}

// sum plus the word's four terms in column order, (decode(code) * scale) * x[col + j].
macro_rules! fp8_word_terms {
    ($sum:expr, $word:expr, $scale:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_sum: f32 = $sum;
          let mut dv_j: i32 = 0;
          while dv_j < 4 {
            dv_sum = dv_sum + (fp8_decode!($word >> (dv_j * 8)) * $scale) * $x[$col + (dv_j as i64)];
            dv_j = dv_j + 1;
          }
          dv_sum
        }
    };
}

// The bits fp8_decode! builds for byte $j of $word, without its NaN check: the sign to bit 31,
// exponent and mantissa to bits 26 .. 20, in two or three integer instructions (byte j moved to the
// top, an arithmetic shift by 4, one mask) where fp8_decode! takes about six and a select (#30).
// f32::from_bits of them times 2^120 is the code's value, for every code but the NaNs.
macro_rules! fp8_bits {
    ($word:expr, $j:expr) => {
        unsafe {
          let dv_shift: u32 = 8u32 * ($j as u32);
          let dv_top: u32 = ($word & (255u32 << dv_shift)) << (24u32 - dv_shift);
          (((dv_top as i32) >> 4) as u32) & 2280652800u32
        }
    };
}

// Whether none of the sixteen codes in four words is a NaN (S.1111.111): a byte's low seven bits
// plus one reach its bit 7 only when they are all ones, and never carry into the next byte.
macro_rules! fp8_no_nan4 {
    ($w0:expr, $w1:expr, $w2:expr, $w3:expr) => {
        unsafe {
          ((((($w0 & 2139062143u32) + 16843009u32) | (($w1 & 2139062143u32) + 16843009u32)
            | (($w2 & 2139062143u32) + 16843009u32) | (($w3 & 2139062143u32) + 16843009u32))
            & 2155905152u32) == 0u32)
        }
    };
}

// fp8_word_terms! for a word with no NaN code and a scale with |scale| < 256, bit for bit: with
// $scale120 = scale * 2^120 (exact, as |scale| < 2^8), from_bits(b) * $scale120 is the same real
// number as (from_bits(b) * 2^120) * scale, whose first product is exact, so both round once to
// the same float. One multiply a code fewer, and no NaN select (#30).
macro_rules! fp8_word_terms_fast {
    ($sum:expr, $word:expr, $scale120:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_sum: f32 = $sum;
          let mut dv_j: i32 = 0;
          while dv_j < 4 {
            dv_sum = dv_sum + (f32::from_bits(fp8_bits!($word, dv_j)) * $scale120) * $x[$col + (dv_j as i64)];
            dv_j = dv_j + 1;
          }
          dv_sum
        }
    };
}

// Whether a lane step of sixteen codes may take the fast terms: no NaN code, and |scale| < 256 (a
// NaN or infinite scale fails too). The other steps keep fp8_word_terms!, so every result is the
// same bits either way.
macro_rules! fp8_fast4 {
    ($w0:expr, $w1:expr, $w2:expr, $w3:expr, $scale:expr) => {
        unsafe { (fp8_no_nan4!($w0, $w1, $w2, $w3)) && $scale < 256.0 && $scale > -256.0 }
    };
}

// fp8_row_dot! reading sixteen codes a lane step (#30, #31): the weight bytes viewed as u32, each
// expert's [rows, n] matrix back to back (n % 16 == 0, so every row starts on 16 bytes). Lane l
// reads words 4l .. 4l + 3 of every 128-word tile (columns tile * 512 + 16l .. + 15, all in one
// 128-column scale block), four consecutive words at a multiple of 4: one ld.global.nc.v4 (Vx
// #2375). It adds them in column order, tile by tile. $xo must be a multiple of 4 too for x's
// sixteen floats to load four at a time.
macro_rules! fp8_row_dot4 {
    ($weight:ident, $scales:ident, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv4_k: i64 = $n;
          let dv4_xo: i64 = $xo;
          let dv4_tiles: i64 = (dv4_k + 127) / 128;
          let dv4_words: i64 = dv4_k / 4;
          let dv4_scale_rows: i64 = (($rows as i64) + 127) / 128;
          // (expert * rows + row) * words, written with its factor 4 (Vx #2362).
          let dv4_row_words: i64 = (($expert as i64) * ($rows as i64) + $row) * (dv4_k / 16) * 4;
          let dv4_scale_base: i64 = (($expert as i64) * dv4_scale_rows + $row / 128) * dv4_tiles;
          let mut dv4_sum: f32 = 0.0;
          let mut dv4_at: i64 = ($lane as i64) * 4;
          while dv4_at < dv4_words {
            let dv4_w0: u32 = $weight[dv4_row_words + dv4_at];
            let dv4_w1: u32 = $weight[dv4_row_words + dv4_at + 1];
            let dv4_w2: u32 = $weight[dv4_row_words + dv4_at + 2];
            let dv4_w3: u32 = $weight[dv4_row_words + dv4_at + 3];
            let dv4_scale: f32 = $scales[dv4_scale_base + dv4_at / 32];
            let dv4_col: i64 = dv4_xo + dv4_at * 4;
            if fp8_fast4!(dv4_w0, dv4_w1, dv4_w2, dv4_w3, dv4_scale) {
              let dv4_s120: f32 = dv4_scale * f32::from_bits(2071986176u32);
              dv4_sum = fp8_word_terms_fast!(dv4_sum, dv4_w0, dv4_s120, $x, dv4_col);
              dv4_sum = fp8_word_terms_fast!(dv4_sum, dv4_w1, dv4_s120, $x, dv4_col + 4);
              dv4_sum = fp8_word_terms_fast!(dv4_sum, dv4_w2, dv4_s120, $x, dv4_col + 8);
              dv4_sum = fp8_word_terms_fast!(dv4_sum, dv4_w3, dv4_s120, $x, dv4_col + 12);
            } else {
              let dv4_i0: i32 = dv4_w0 as i32;
              let dv4_i1: i32 = dv4_w1 as i32;
              let dv4_i2: i32 = dv4_w2 as i32;
              let dv4_i3: i32 = dv4_w3 as i32;
              dv4_sum = fp8_word_terms!(dv4_sum, dv4_i0, dv4_scale, $x, dv4_col);
              dv4_sum = fp8_word_terms!(dv4_sum, dv4_i1, dv4_scale, $x, dv4_col + 4);
              dv4_sum = fp8_word_terms!(dv4_sum, dv4_i2, dv4_scale, $x, dv4_col + 8);
              dv4_sum = fp8_word_terms!(dv4_sum, dv4_i3, dv4_scale, $x, dv4_col + 12);
            }
            dv4_at = dv4_at + 128;
          }
          dv4_sum
        }
    };
}

// Groups of 128 columns, two codes a byte (low nibble first), a 16-bit scale a group.
macro_rules! int4_row_dot {
    ($packed:ident, $scales:ident, $kind:expr, $x:ident, $xo:expr, $expert:expr, $row:expr, $rows:expr, $n:expr, $lane:expr) => {
        unsafe {
          let dv_n: i64 = $n;
          let dv_xo: i64 = $xo;
          let dv_lane: i32 = $lane;
          let dv_groups: i64 = (dv_n + 127) / 128;
          let dv_row_bytes: i64 = (dv_n + 1) / 2;
          let dv_expert_row: i64 = ($expert as i64) * ($rows as i64) + $row;
          let mut dv_sum: f32 = 0.0;
          let mut dv_group: i64 = 0;
          while dv_group < dv_groups {
            let dv_scale: f32 = group_scale!($scales[dv_expert_row * dv_groups + dv_group] as i32, $kind);
            let mut dv_part: f32 = 0.0;
            let mut dv_step: i32 = 0;
            while dv_step < 2 {
              let dv_byte_index: i64 = dv_group * 64 + ((dv_step * 32 + dv_lane) as i64);
              let dv_col: i64 = dv_byte_index * 2;
              if dv_col < dv_n {
                let dv_byte: i32 = $packed[dv_expert_row * dv_row_bytes + dv_byte_index] as i32;
                dv_part = dv_part + int4_code!(dv_byte, 0) * $x[dv_xo + dv_col];
                if dv_col + 1 < dv_n { dv_part = dv_part + int4_code!(dv_byte, 1) * $x[dv_xo + dv_col + 1]; }
              }
              dv_step = dv_step + 1;
            }
            dv_sum = dv_sum + dv_part * dv_scale;
            dv_group = dv_group + 1;
          }
          dv_sum
        }
    };
}

// --- One fma a code (fp8_matvec_fma, fp8_matvec_fma_tiles, #30) ---

// 2^40, which x is multiplied by as it is read, and 2^80, which a step's sum is multiplied by with
// its scale: from_bits(fp8_bits(code)) is code * 2^-120, so a product is code * x * 2^-80.
macro_rules! X_SCALE { () => { f32::from_bits(1400897536u32) }; }
macro_rules! STEP_SCALE { () => { f32::from_bits(1736441856u32) }; }

// fp8_matvec_fma and fp8_matvec_fma_tiles (#30). Sixteen codes of one lane step at 2^-80 scale: the sum of from_bits(fp8_bits(code)) * (x[col + i] *
// 2^40), one fma each, in column order. No code may be a NaN (fp8_fast4! said so).
macro_rules! fp8_step_fma {
    ($w0:expr, $w1:expr, $w2:expr, $w3:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_p: f32 = 0.0;
          let mut dv_j: i32 = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w0, dv_j)), $x[$col + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w1, dv_j)), $x[$col + 4 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w2, dv_j)), $x[$col + 8 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_j = 0;
          while dv_j < 4 {
            dv_p = fma32!(f32::from_bits(fp8_bits!($w3, dv_j)), $x[$col + 12 + (dv_j as i64)] * X_SCALE!(), dv_p);
            dv_j = dv_j + 1;
          }
          dv_p
        }
    };
}

// One lane step of sixteen codes into $sum: the fma path, or the exact one for a NaN code or a
// scale of 256 or more.
macro_rules! fp8_step_into {
    ($sum:expr, $w0:expr, $w1:expr, $w2:expr, $w3:expr, $scale:expr, $x:ident, $col:expr) => {
        unsafe {
          let mut dv_s: f32 = $sum;
          if fp8_fast4!($w0, $w1, $w2, $w3, $scale) {
            let dv_step: f32 = fp8_step_fma!($w0, $w1, $w2, $w3, $x, $col);
            dv_s = fma32!(dv_step, $scale * STEP_SCALE!(), dv_s);
          } else {
            let dv_i0: i32 = $w0 as i32;
            let dv_i1: i32 = $w1 as i32;
            let dv_i2: i32 = $w2 as i32;
            let dv_i3: i32 = $w3 as i32;
            dv_s = fp8_word_terms!(dv_s, dv_i0, $scale, $x, $col);
            dv_s = fp8_word_terms!(dv_s, dv_i1, $scale, $x, $col + 4);
            dv_s = fp8_word_terms!(dv_s, dv_i2, $scale, $x, $col + 8);
            dv_s = fp8_word_terms!(dv_s, dv_i3, $scale, $x, $col + 12);
          }
          dv_s
        }
    };
}

// --- Two rows against one x, whole-sector loads (fp8_matvec_fma_tiles, fp8_moe_fma_*, #30, #31) ---

// Word $u of row r and word $v of row r + 1 (four codes each) against x0 .. x3, already read:
// two partials of four fmas each.
macro_rules! fp8_pair_word4 {
    ($p:ident, $q:ident, $u:expr, $v:expr, $x0:expr, $x1:expr, $x2:expr, $x3:expr) => {
        unsafe {
          let dv_a: f32 = $x0 * X_SCALE!();
          let dv_b: f32 = $x1 * X_SCALE!();
          let dv_c: f32 = $x2 * X_SCALE!();
          let dv_d: f32 = $x3 * X_SCALE!();
          $p = fma32!(f32::from_bits(fp8_bits!($u, 0)), dv_a, $p);
          $q = fma32!(f32::from_bits(fp8_bits!($v, 0)), dv_a, $q);
          $p = fma32!(f32::from_bits(fp8_bits!($u, 1)), dv_b, $p);
          $q = fma32!(f32::from_bits(fp8_bits!($v, 1)), dv_b, $q);
          $p = fma32!(f32::from_bits(fp8_bits!($u, 2)), dv_c, $p);
          $q = fma32!(f32::from_bits(fp8_bits!($v, 2)), dv_c, $q);
          $p = fma32!(f32::from_bits(fp8_bits!($u, 3)), dv_d, $p);
          $q = fma32!(f32::from_bits(fp8_bits!($v, 3)), dv_d, $q);
        }
    };
}

// Group j of a 512-column tile for row a (word offset $ra in $wa, scales from $sca[$sba ..]) and
// row b ($rb in $wb, $scb[$sbb ..]), both against x[$xo ..]: lane l's word tile * 128 + j * 32 + l
// of each row (codes at columns tile * 512 + j * 128 + 4l .. + 3, in scale block tile * 4 + j).
// The rows may be of one matrix (fp8_matvec_fma_tiles) or two (fp8_moe_fma_gate_up's gate and up).
// $xo must be a multiple of 4, written so, for x's 16-byte loads.
macro_rules! fp8_pair_group {
    ($sa:ident, $sb:ident, $wa:ident, $sca:ident, $wb:ident, $scb:ident, $x:ident, $xo:expr, $ra:expr, $rb:expr, $sba:expr, $sbb:expr, $word:expr, $words:expr) => {
        unsafe {
          let dv_w: i64 = $word;
          if dv_w < $words {
            let dv_u: u32 = $wa[$ra + dv_w];
            let dv_v: u32 = $wb[$rb + dv_w];
            let dv_scale: f32 = $sca[$sba + dv_w / 32];
            let dv_scale_b: f32 = $scb[$sbb + dv_w / 32];
            let dv_col: i64 = $xo + dv_w * 4;
            // The four x of these columns in one 16-byte load, read before the branch.
            let dv_x0: f32 = $x[dv_col];
            let dv_x1: f32 = $x[dv_col + 1];
            let dv_x2: f32 = $x[dv_col + 2];
            let dv_x3: f32 = $x[dv_col + 3];
            if fp8_no_nan4!(dv_u, dv_v, 0u32, 0u32) && dv_scale < 256.0 && dv_scale > -256.0
               && dv_scale_b < 256.0 && dv_scale_b > -256.0 {
              let mut dv_p: f32 = 0.0;
              let mut dv_q: f32 = 0.0;
              fp8_pair_word4!(dv_p, dv_q, dv_u, dv_v, dv_x0, dv_x1, dv_x2, dv_x3);
              $sa = fma32!(dv_p, dv_scale * STEP_SCALE!(), $sa);
              $sb = fma32!(dv_q, dv_scale_b * STEP_SCALE!(), $sb);
            } else {
              let dv_iu: i32 = dv_u as i32;
              let dv_iv: i32 = dv_v as i32;
              $sa = fp8_word_terms!($sa, dv_iu, dv_scale, $x, dv_col);
              $sb = fp8_word_terms!($sb, dv_iv, dv_scale_b, $x, dv_col);
            }
          }
        }
    };
}

// A whole 512-column tile of rows a and b (fp8_pair_group!'s), every load first: lane l's words
// tile * 128 + j * 32 + l of both rows, the four x of each group, both rows' four scales; then the
// fmas, or group by group the exact terms where a code is NaN or a scale 256 or more.
macro_rules! fp8_pair_tile {
    ($sa:ident, $sb:ident, $wa:ident, $sca:ident, $wb:ident, $scb:ident, $x:ident, $xo:expr, $ra:expr, $rb:expr, $sba:expr, $sbb:expr, $word:expr) => {
        unsafe {
          let dv_w: i64 = $word;
          let dv_u0: u32 = $wa[$ra + dv_w];
          let dv_u1: u32 = $wa[$ra + dv_w + 32];
          let dv_u2: u32 = $wa[$ra + dv_w + 64];
          let dv_u3: u32 = $wa[$ra + dv_w + 96];
          let dv_v0: u32 = $wb[$rb + dv_w];
          let dv_v1: u32 = $wb[$rb + dv_w + 32];
          let dv_v2: u32 = $wb[$rb + dv_w + 64];
          let dv_v3: u32 = $wb[$rb + dv_w + 96];
          let dv_c: i64 = $xo + dv_w * 4;
          let dv_x00: f32 = $x[dv_c];
          let dv_x01: f32 = $x[dv_c + 1];
          let dv_x02: f32 = $x[dv_c + 2];
          let dv_x03: f32 = $x[dv_c + 3];
          let dv_x10: f32 = $x[dv_c + 128];
          let dv_x11: f32 = $x[dv_c + 129];
          let dv_x12: f32 = $x[dv_c + 130];
          let dv_x13: f32 = $x[dv_c + 131];
          let dv_x20: f32 = $x[dv_c + 256];
          let dv_x21: f32 = $x[dv_c + 257];
          let dv_x22: f32 = $x[dv_c + 258];
          let dv_x23: f32 = $x[dv_c + 259];
          let dv_x30: f32 = $x[dv_c + 384];
          let dv_x31: f32 = $x[dv_c + 385];
          let dv_x32: f32 = $x[dv_c + 386];
          let dv_x33: f32 = $x[dv_c + 387];
          let dv_s0: f32 = $sca[$sba + dv_w / 32];
          let dv_s1: f32 = $sca[$sba + dv_w / 32 + 1];
          let dv_s2: f32 = $sca[$sba + dv_w / 32 + 2];
          let dv_s3: f32 = $sca[$sba + dv_w / 32 + 3];
          let dv_t0: f32 = $scb[$sbb + dv_w / 32];
          let dv_t1: f32 = $scb[$sbb + dv_w / 32 + 1];
          let dv_t2: f32 = $scb[$sbb + dv_w / 32 + 2];
          let dv_t3: f32 = $scb[$sbb + dv_w / 32 + 3];
          if fp8_no_nan4!(dv_u0, dv_u1, dv_u2, dv_u3) && fp8_no_nan4!(dv_v0, dv_v1, dv_v2, dv_v3)
             && dv_s0 < 256.0 && dv_s0 > -256.0 && dv_s1 < 256.0 && dv_s1 > -256.0
             && dv_s2 < 256.0 && dv_s2 > -256.0 && dv_s3 < 256.0 && dv_s3 > -256.0
             && dv_t0 < 256.0 && dv_t0 > -256.0 && dv_t1 < 256.0 && dv_t1 > -256.0
             && dv_t2 < 256.0 && dv_t2 > -256.0 && dv_t3 < 256.0 && dv_t3 > -256.0 {
            let mut dv_p: f32 = 0.0;
            let mut dv_q: f32 = 0.0;
            fp8_pair_word4!(dv_p, dv_q, dv_u0, dv_v0, dv_x00, dv_x01, dv_x02, dv_x03);
            $sa = fma32!(dv_p, dv_s0 * STEP_SCALE!(), $sa);
            $sb = fma32!(dv_q, dv_t0 * STEP_SCALE!(), $sb);
            dv_p = 0.0;
            dv_q = 0.0;
            fp8_pair_word4!(dv_p, dv_q, dv_u1, dv_v1, dv_x10, dv_x11, dv_x12, dv_x13);
            $sa = fma32!(dv_p, dv_s1 * STEP_SCALE!(), $sa);
            $sb = fma32!(dv_q, dv_t1 * STEP_SCALE!(), $sb);
            dv_p = 0.0;
            dv_q = 0.0;
            fp8_pair_word4!(dv_p, dv_q, dv_u2, dv_v2, dv_x20, dv_x21, dv_x22, dv_x23);
            $sa = fma32!(dv_p, dv_s2 * STEP_SCALE!(), $sa);
            $sb = fma32!(dv_q, dv_t2 * STEP_SCALE!(), $sb);
            dv_p = 0.0;
            dv_q = 0.0;
            fp8_pair_word4!(dv_p, dv_q, dv_u3, dv_v3, dv_x30, dv_x31, dv_x32, dv_x33);
            $sa = fma32!(dv_p, dv_s3 * STEP_SCALE!(), $sa);
            $sb = fma32!(dv_q, dv_t3 * STEP_SCALE!(), $sb);
          } else {
            let dv_words: i64 = dv_w + 128;
            fp8_pair_group!($sa, $sb, $wa, $sca, $wb, $scb, $x, $xo, $ra, $rb, $sba, $sbb, dv_w, dv_words);
            fp8_pair_group!($sa, $sb, $wa, $sca, $wb, $scb, $x, $xo, $ra, $rb, $sba, $sbb, dv_w + 32, dv_words);
            fp8_pair_group!($sa, $sb, $wa, $sca, $wb, $scb, $x, $xo, $ra, $rb, $sba, $sbb, dv_w + 64, dv_words);
            fp8_pair_group!($sa, $sb, $wa, $sca, $wb, $scb, $x, $xo, $ra, $rb, $sba, $sbb, dv_w + 96, dv_words);
          }
        }
    };
}

// Rows row and row + 1 of a [rows, cols] FP8 matrix against x, fp8_matvec_fma_tiles' lane share:
// ($sum, $sum2) for lanes::sum. A missing row + 1 reads row again (its sum is dropped by the caller);
// cols % 16 != 0 or row >= rows leaves both zero.
macro_rules! fp8_tiles_pair_rows {
    ($sum:ident, $sum2:ident, $weight:ident, $scales:ident, $x:ident, $row:expr, $rows:expr, $cols:expr, $lane:expr) => {
        unsafe {
          let dv_row: i64 = $row;
          let dv_rows: i64 = $rows as i64;
          let dv_cols: i32 = $cols;
          if dv_row < dv_rows && dv_cols % 16 == 0 {
            let dv_n: i64 = dv_cols as i64;
            let dv_tiles: i64 = (dv_n + 127) / 128;
            let dv_words: i64 = dv_n / 4;
            let dv_rw: i64 = (dv_n / 16) * 4;
            let dv_ra: i64 = dv_row * dv_rw;
            let dv_rb: i64 = if dv_row + 1 < dv_rows { dv_ra + dv_rw } else { dv_ra };
            let dv_sbase: i64 = (dv_row / 128) * dv_tiles;
            let mut dv_word: i64 = $lane as i64;
            // Whole tiles: word + 96 is the tile's last group of this lane.
            while dv_word + 96 < dv_words {
              fp8_pair_tile!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word);
              dv_word = dv_word + 128;
            }
            while dv_word < dv_words {
              fp8_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word, dv_words);
              fp8_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 32, dv_words);
              fp8_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 64, dv_words);
              fp8_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 96, dv_words);
              dv_word = dv_word + 128;
            }
          }
        }
    };
}

// --- FP8 codes at their true values, two rows against one x (glm-vx #38) ---
// The FP8 conversion kernels (fp8_*_cvt*): fp8_word_f32x4!, which the kernel's variant include defines
// (fp8_cvt_sm90.vx with Hopper's conversion, fp8_cvt_ref.vx with an exact integer decode), gives each
// code's exact float32 value, NaN codes NaN. So a product is code * x at its own scale: no fast-path
// check, no exact fallback, no 2^-80 / 2^40 scaling as fp8_pair_tile! needs. A NaN code makes its
// row NaN by arithmetic. Lanes, loads and the order of the fmas are fp8_pair_tile!'s.

// Word $u of row a and word $v of row b (four codes each) against x0 .. x3: two partials of four fmas.
macro_rules! fp8t_pair_word4 {
    ($p:ident, $q:ident, $u:expr, $v:expr, $x0:expr, $x1:expr, $x2:expr, $x3:expr) => {
        unsafe {
          let mut dv_a0: f32 = 0.0;
          let mut dv_a1: f32 = 0.0;
          let mut dv_a2: f32 = 0.0;
          let mut dv_a3: f32 = 0.0;
          let mut dv_b0: f32 = 0.0;
          let mut dv_b1: f32 = 0.0;
          let mut dv_b2: f32 = 0.0;
          let mut dv_b3: f32 = 0.0;
          fp8_word_f32x4!($u, dv_a0, dv_a1, dv_a2, dv_a3);
          fp8_word_f32x4!($v, dv_b0, dv_b1, dv_b2, dv_b3);
          $p = fma32!(dv_a0, $x0, $p);
          $q = fma32!(dv_b0, $x0, $q);
          $p = fma32!(dv_a1, $x1, $p);
          $q = fma32!(dv_b1, $x1, $q);
          $p = fma32!(dv_a2, $x2, $p);
          $q = fma32!(dv_b2, $x2, $q);
          $p = fma32!(dv_a3, $x3, $p);
          $q = fma32!(dv_b3, $x3, $q);
        }
    };
}

// fp8_pair_group! at true values: group j of a 512-column tile of rows a and b, guarded by $words.
macro_rules! fp8t_pair_group {
    ($sa:ident, $sb:ident, $wa:ident, $sca:ident, $wb:ident, $scb:ident, $x:ident, $xo:expr, $ra:expr, $rb:expr, $sba:expr, $sbb:expr, $word:expr, $words:expr) => {
        unsafe {
          let dv_w: i64 = $word;
          if dv_w < $words {
            let dv_u: u32 = $wa[$ra + dv_w];
            let dv_v: u32 = $wb[$rb + dv_w];
            let dv_scale: f32 = $sca[$sba + dv_w / 32];
            let dv_scale_b: f32 = $scb[$sbb + dv_w / 32];
            let dv_col: i64 = $xo + dv_w * 4;
            let dv_x0: f32 = $x[dv_col];
            let dv_x1: f32 = $x[dv_col + 1];
            let dv_x2: f32 = $x[dv_col + 2];
            let dv_x3: f32 = $x[dv_col + 3];
            let mut dv_p: f32 = 0.0;
            let mut dv_q: f32 = 0.0;
            fp8t_pair_word4!(dv_p, dv_q, dv_u, dv_v, dv_x0, dv_x1, dv_x2, dv_x3);
            $sa = fma32!(dv_p, dv_scale, $sa);
            $sb = fma32!(dv_q, dv_scale_b, $sb);
          }
        }
    };
}

// fp8_pair_tile! at true values: a whole tile of rows a and b, every load first, then four groups.
macro_rules! fp8t_pair_tile {
    ($sa:ident, $sb:ident, $wa:ident, $sca:ident, $wb:ident, $scb:ident, $x:ident, $xo:expr, $ra:expr, $rb:expr, $sba:expr, $sbb:expr, $word:expr) => {
        unsafe {
          let dv_w: i64 = $word;
          let dv_u0: u32 = $wa[$ra + dv_w];
          let dv_u1: u32 = $wa[$ra + dv_w + 32];
          let dv_u2: u32 = $wa[$ra + dv_w + 64];
          let dv_u3: u32 = $wa[$ra + dv_w + 96];
          let dv_v0: u32 = $wb[$rb + dv_w];
          let dv_v1: u32 = $wb[$rb + dv_w + 32];
          let dv_v2: u32 = $wb[$rb + dv_w + 64];
          let dv_v3: u32 = $wb[$rb + dv_w + 96];
          let dv_c: i64 = $xo + dv_w * 4;
          let dv_x00: f32 = $x[dv_c];
          let dv_x01: f32 = $x[dv_c + 1];
          let dv_x02: f32 = $x[dv_c + 2];
          let dv_x03: f32 = $x[dv_c + 3];
          let dv_x10: f32 = $x[dv_c + 128];
          let dv_x11: f32 = $x[dv_c + 129];
          let dv_x12: f32 = $x[dv_c + 130];
          let dv_x13: f32 = $x[dv_c + 131];
          let dv_x20: f32 = $x[dv_c + 256];
          let dv_x21: f32 = $x[dv_c + 257];
          let dv_x22: f32 = $x[dv_c + 258];
          let dv_x23: f32 = $x[dv_c + 259];
          let dv_x30: f32 = $x[dv_c + 384];
          let dv_x31: f32 = $x[dv_c + 385];
          let dv_x32: f32 = $x[dv_c + 386];
          let dv_x33: f32 = $x[dv_c + 387];
          let dv_s0: f32 = $sca[$sba + dv_w / 32];
          let dv_s1: f32 = $sca[$sba + dv_w / 32 + 1];
          let dv_s2: f32 = $sca[$sba + dv_w / 32 + 2];
          let dv_s3: f32 = $sca[$sba + dv_w / 32 + 3];
          let dv_t0: f32 = $scb[$sbb + dv_w / 32];
          let dv_t1: f32 = $scb[$sbb + dv_w / 32 + 1];
          let dv_t2: f32 = $scb[$sbb + dv_w / 32 + 2];
          let dv_t3: f32 = $scb[$sbb + dv_w / 32 + 3];
          let mut dv_p: f32 = 0.0;
          let mut dv_q: f32 = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u0, dv_v0, dv_x00, dv_x01, dv_x02, dv_x03);
          $sa = fma32!(dv_p, dv_s0, $sa);
          $sb = fma32!(dv_q, dv_t0, $sb);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u1, dv_v1, dv_x10, dv_x11, dv_x12, dv_x13);
          $sa = fma32!(dv_p, dv_s1, $sa);
          $sb = fma32!(dv_q, dv_t1, $sb);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u2, dv_v2, dv_x20, dv_x21, dv_x22, dv_x23);
          $sa = fma32!(dv_p, dv_s2, $sa);
          $sb = fma32!(dv_q, dv_t2, $sb);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u3, dv_v3, dv_x30, dv_x31, dv_x32, dv_x33);
          $sa = fma32!(dv_p, dv_s3, $sa);
          $sb = fma32!(dv_q, dv_t3, $sb);
        }
    };
}

// fp8t_pair_tile! for four rows a, b, c, d of one matrix (glm-vx #38): the tile's x and scales load once
// for the four, so a lane has 16 words of weights in flight against 16 x values. Each row's fmas are
// fp8t_pair_tile!'s, in the same order. The four rows share their 128-row block of scales ($sb).
macro_rules! fp8t_quad_tile {
    ($sa:ident, $sb2:ident, $sc:ident, $sd:ident, $w:ident, $scales:ident, $x:ident, $xo:expr, $ra:expr, $rb:expr, $rc:expr, $rd:expr, $sbase:expr, $word:expr) => {
        unsafe {
          let dv_w: i64 = $word;
          let dv_u0: u32 = $w[$ra + dv_w];
          let dv_u1: u32 = $w[$ra + dv_w + 32];
          let dv_u2: u32 = $w[$ra + dv_w + 64];
          let dv_u3: u32 = $w[$ra + dv_w + 96];
          let dv_v0: u32 = $w[$rb + dv_w];
          let dv_v1: u32 = $w[$rb + dv_w + 32];
          let dv_v2: u32 = $w[$rb + dv_w + 64];
          let dv_v3: u32 = $w[$rb + dv_w + 96];
          let dv_y0: u32 = $w[$rc + dv_w];
          let dv_y1: u32 = $w[$rc + dv_w + 32];
          let dv_y2: u32 = $w[$rc + dv_w + 64];
          let dv_y3: u32 = $w[$rc + dv_w + 96];
          let dv_z0: u32 = $w[$rd + dv_w];
          let dv_z1: u32 = $w[$rd + dv_w + 32];
          let dv_z2: u32 = $w[$rd + dv_w + 64];
          let dv_z3: u32 = $w[$rd + dv_w + 96];
          let dv_c: i64 = $xo + dv_w * 4;
          let dv_x00: f32 = $x[dv_c];
          let dv_x01: f32 = $x[dv_c + 1];
          let dv_x02: f32 = $x[dv_c + 2];
          let dv_x03: f32 = $x[dv_c + 3];
          let dv_x10: f32 = $x[dv_c + 128];
          let dv_x11: f32 = $x[dv_c + 129];
          let dv_x12: f32 = $x[dv_c + 130];
          let dv_x13: f32 = $x[dv_c + 131];
          let dv_x20: f32 = $x[dv_c + 256];
          let dv_x21: f32 = $x[dv_c + 257];
          let dv_x22: f32 = $x[dv_c + 258];
          let dv_x23: f32 = $x[dv_c + 259];
          let dv_x30: f32 = $x[dv_c + 384];
          let dv_x31: f32 = $x[dv_c + 385];
          let dv_x32: f32 = $x[dv_c + 386];
          let dv_x33: f32 = $x[dv_c + 387];
          let dv_s0: f32 = $scales[$sbase + dv_w / 32];
          let dv_s1: f32 = $scales[$sbase + dv_w / 32 + 1];
          let dv_s2: f32 = $scales[$sbase + dv_w / 32 + 2];
          let dv_s3: f32 = $scales[$sbase + dv_w / 32 + 3];
          let mut dv_p: f32 = 0.0;
          let mut dv_q: f32 = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u0, dv_v0, dv_x00, dv_x01, dv_x02, dv_x03);
          $sa = fma32!(dv_p, dv_s0, $sa);
          $sb2 = fma32!(dv_q, dv_s0, $sb2);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_y0, dv_z0, dv_x00, dv_x01, dv_x02, dv_x03);
          $sc = fma32!(dv_p, dv_s0, $sc);
          $sd = fma32!(dv_q, dv_s0, $sd);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u1, dv_v1, dv_x10, dv_x11, dv_x12, dv_x13);
          $sa = fma32!(dv_p, dv_s1, $sa);
          $sb2 = fma32!(dv_q, dv_s1, $sb2);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_y1, dv_z1, dv_x10, dv_x11, dv_x12, dv_x13);
          $sc = fma32!(dv_p, dv_s1, $sc);
          $sd = fma32!(dv_q, dv_s1, $sd);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u2, dv_v2, dv_x20, dv_x21, dv_x22, dv_x23);
          $sa = fma32!(dv_p, dv_s2, $sa);
          $sb2 = fma32!(dv_q, dv_s2, $sb2);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_y2, dv_z2, dv_x20, dv_x21, dv_x22, dv_x23);
          $sc = fma32!(dv_p, dv_s2, $sc);
          $sd = fma32!(dv_q, dv_s2, $sd);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_u3, dv_v3, dv_x30, dv_x31, dv_x32, dv_x33);
          $sa = fma32!(dv_p, dv_s3, $sa);
          $sb2 = fma32!(dv_q, dv_s3, $sb2);
          dv_p = 0.0;
          dv_q = 0.0;
          fp8t_pair_word4!(dv_p, dv_q, dv_y3, dv_z3, dv_x30, dv_x31, dv_x32, dv_x33);
          $sc = fma32!(dv_p, dv_s3, $sc);
          $sd = fma32!(dv_q, dv_s3, $sd);
        }
    };
}

// fp8_tiles_pair_rows! at true values: rows row and row + 1 of one [rows, cols] matrix.
macro_rules! fp8t_tiles_pair_rows {
    ($sum:ident, $sum2:ident, $weight:ident, $scales:ident, $x:ident, $row:expr, $rows:expr, $cols:expr, $lane:expr) => {
        unsafe {
          let dv_row: i64 = $row;
          let dv_rows: i64 = $rows as i64;
          let dv_cols: i32 = $cols;
          if dv_row < dv_rows && dv_cols % 16 == 0 {
            let dv_n: i64 = dv_cols as i64;
            let dv_tiles: i64 = (dv_n + 127) / 128;
            let dv_words: i64 = dv_n / 4;
            let dv_rw: i64 = (dv_n / 16) * 4;
            let dv_ra: i64 = dv_row * dv_rw;
            let dv_rb: i64 = if dv_row + 1 < dv_rows { dv_ra + dv_rw } else { dv_ra };
            let dv_sbase: i64 = (dv_row / 128) * dv_tiles;
            let mut dv_word: i64 = $lane as i64;
            while dv_word + 96 < dv_words {
              fp8t_pair_tile!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word);
              dv_word = dv_word + 128;
            }
            while dv_word < dv_words {
              fp8t_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word, dv_words);
              fp8t_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 32, dv_words);
              fp8t_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 64, dv_words);
              fp8t_pair_group!($sum, $sum2, $weight, $scales, $weight, $scales, $x, 0, dv_ra, dv_rb, dv_sbase, dv_sbase, dv_word + 96, dv_words);
              dv_word = dv_word + 128;
            }
          }
        }
    };
}
