// Device helpers shared by the gpu/spawn kernels; build.py pastes this file in front of a
// kernel that declares `// spawn-include: device.vx`. Thread ids and warp shuffles are
// gpu-dialect mlir! blocks until Vx has builtins for them (#260).
fn thread_id() on Topology::Device -> i32 {
  return mlir!( inputs : (), returns : i32, dialects : ["gpu", "arith"]) {
    %t = gpu.thread_id x
    %r = "arith.index_cast"(%t) : (index) -> i32
    macro.yield %r : i32
  };
}
fn block_id() on Topology::Device -> i32 {
  return mlir!( inputs : (), returns : i32, dialects : ["gpu", "arith"]) {
    %t = gpu.block_id x
    %r = "arith.index_cast"(%t) : (index) -> i32
    macro.yield %r : i32
  };
}
fn block_dim() on Topology::Device -> i32 {
  return mlir!( inputs : (), returns : i32, dialects : ["gpu", "arith"]) {
    %t = gpu.block_dim x
    %r = "arith.index_cast"(%t) : (index) -> i32
    macro.yield %r : i32
  };
}
fn grid_dim() on Topology::Device -> i32 {
  return mlir!( inputs : (), returns : i32, dialects : ["gpu", "arith"]) {
    %t = gpu.grid_dim x
    %r = "arith.index_cast"(%t) : (index) -> i32
    macro.yield %r : i32
  };
}
// Full-warp shfl.sync.down with clamp 31; a lane past the warp gets its own value back.
fn shuffle_down(value: f32, delta: i32) on Topology::Device -> f32 {
  return mlir!( inputs : (%v = value : f32, %d = delta : i32), returns : f32, dialects : ["gpu", "arith"]) {
    %w = "arith.constant"() {value = 32 : i32} : () -> i32
    %r, %ok = gpu.shuffle down %v, %d, %w : f32
    macro.yield %r : f32
  };
}
// The hand kernels' vxk_warp_sum, in the same order, so lane 0 gets a bitwise-equal total.
fn warp_sum(value: f32) on Topology::Device -> f32 {
  let mut sum: f32 = value;
  sum = sum + shuffle_down(sum, 16);
  sum = sum + shuffle_down(sum, 8);
  sum = sum + shuffle_down(sum, 4);
  sum = sum + shuffle_down(sum, 2);
  sum = sum + shuffle_down(sum, 1);
  return sum;
}

// bfloat16 bits to f32, exact for all 65,536 encodings: gpu/bf16.vx's glm_vx_bf16_decode
// unchanged. A bit cast would be shorter, but f32::from_bits crashes vxc in device code (#1943).
fn bf16_decode(bits: i32) on Topology::Device -> f32 {
  let exponent: i32 = (bits >> 7) & 255;
  let mantissa: i32 = bits & 127;
  let mut magnitude: f32 = (mantissa as f32) / 128.0;
  let mut shift: i32 = -126;
  if exponent > 0 {
    magnitude = ((128 + mantissa) as f32) / 128.0;
    shift = exponent - 127;
  }
  let mut power: f32 = 1.0;
  while shift > 30 { power = power * 1073741824.0; shift = shift - 30; }
  while shift < -30 { power = power / 1073741824.0; shift = shift + 30; }
  if shift >= 0 { power = power * ((1 << shift) as f32); }
  if shift < 0 { power = power / ((1 << (0 - shift)) as f32); }
  magnitude = magnitude * power;
  if exponent == 255 {
    if mantissa == 0 { magnitude = 1.0 / 0.0; }
    if mantissa != 0 { magnitude = 0.0 / 0.0; }
  }
  let mut sign: f32 = 1.0;
  if (bits & 32768) != 0 { sign = -1.0; }
  return magnitude * sign;
}
