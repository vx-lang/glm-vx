// Parallel f32 NVIDIA kernels written in Vx. ABI/launch contracts: kernels.h.
// The compiler adapter replaces only these hardware/math externs with NVVM.
extern "C" {
  fn vx_gpu_thread_idx_x() -> i32;
  fn vx_gpu_block_idx_x() -> i32;
  fn vx_gpu_block_dim_x() -> i32;
  fn vx_gpu_grid_dim_x() -> i32;
  fn vx_gpu_shuffle_down_f32(value: f32, delta: i32) -> f32;
  fn vx_gpu_shuffle_idx_f32(value: f32, source: i32) -> f32;
  fn vx_gpu_barrier() -> void;
  fn vx_gpu_shared_f32() -> *mut f32;
  fn expf(x: f32) -> f32;
  fn sqrtf(x: f32) -> f32;
}

// All 32 lanes participate; only lane zero holds the full sum.
fn vxk_warp_sum(value: f32) -> f32 {
  let mut result: f32 = 0.0;
  unsafe {
    let mut sum: f32 = value;
    sum = sum + vx_gpu_shuffle_down_f32(sum, 16);
    sum = sum + vx_gpu_shuffle_down_f32(sum, 8);
    sum = sum + vx_gpu_shuffle_down_f32(sum, 4);
    sum = sum + vx_gpu_shuffle_down_f32(sum, 2);
    sum = sum + vx_gpu_shuffle_down_f32(sum, 1);
    result = sum;
  }
  return result;
}

// Uniform call by every thread, block.x is a multiple of 32 in [32,1024].
// 33 shared floats: one partial per warp and a separate broadcast slot.
fn vxk_block_sum(value: f32) -> f32 {
  let mut result: f32 = 0.0;
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let lane: i32 = tid % 32;
    let warp: i32 = tid / 32;
    let warps: i32 = vx_gpu_block_dim_x() / 32;
    let shared: *mut f32 = vx_gpu_shared_f32();
    let partial: f32 = vxk_warp_sum(value);
    if lane == 0 { shared[warp] = partial; }
    vx_gpu_barrier();
    if warp == 0 {
      let mut v: f32 = 0.0;
      if lane < warps { v = shared[lane]; }
      let total: f32 = vxk_warp_sum(v);
      if lane == 0 { shared[32] = total; }
    }
    vx_gpu_barrier();
    result = shared[32];
  }
  return result;
}

// One CTA per row. Materialize the residual once, then normalize it.
pub extern fn glm_vx_gpu_residual_rmsnorm(out: *mut f32, residual_out: *mut f32, x: *const f32, residual: *const f32, weight: *const f32, rows: i32, dim: i32, eps: f32) -> void {
  if rows <= 0 { return; }
  if dim <= 0 { return; }
  if eps <= 0.0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let row: i32 = vx_gpu_block_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if row >= rows { return; }
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let base: i32 = row * dim;
    let mut ss: f32 = 0.0;
    let mut d: i32 = tid;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim {
        let v: f32 = x[base + d] + residual[base + d];
        residual_out[base + d] = v;
        ss = ss + v * v;
      }
    }
    let total: f32 = vxk_block_sum(ss);
    let inv: f32 = 1.0 / sqrtf(total / (dim as f32) + eps);
    d = tid;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim {
        out[base + d] = residual_out[base + d] * inv * weight[d];
      }
    }
    return;
  }
}

pub extern fn glm_vx_gpu_swiglu(out: *mut f32, gate: *const f32, up: *const f32, n: i32) -> void {
  unsafe {
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((n + stride - 1) / stride) {
      if i < n {
        let g: f32 = gate[i];
        let mut sigmoid: f32 = 0.0;
        if g >= 0.0 { sigmoid = 1.0 / (1.0 + expf(0.0 - g)); }
        else { let z: f32 = expf(g); sigmoid = z / (1.0 + z); }
        out[i] = g * sigmoid * up[i];
      }
      i = i + stride;
    }
    return;
  }
}

// GLM interleaved input -> packed [rotated even, rotated odd] per head.
// cosine/sine contain dim/2 values for the caller's query position.
pub extern fn glm_vx_gpu_rope_glm(out: *mut f32, x: *const f32, cosine: *const f32, sine: *const f32, heads: i32, dim: i32) -> void {
  if heads <= 0 { return; }
  if dim <= 0 { return; }
  if dim % 2 != 0 { return; }
  unsafe {
    let pairs: i32 = dim / 2;
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((heads * pairs + stride - 1) / stride) {
      if i < heads * pairs {
        let h: i32 = i / pairs;
        let p: i32 = i % pairs;
        let base: i32 = h * dim;
        let a: f32 = x[base + p * 2];
        let b: f32 = x[base + p * 2 + 1];
        let c: f32 = cosine[p];
        let s: f32 = sine[p];
        out[base + p] = a * c - b * s;
        out[base + pairs + p] = b * c + a * s;
      }
      i = i + stride;
    }
    return;
  }
}

// A warp computes one row; adjacent lanes load adjacent matrix columns.
pub extern fn glm_vx_gpu_matvec(out: *mut f32, weight: *const f32, x: *const f32, rows: i32, cols: i32) -> void {
  if rows <= 0 { return; }
  if cols < 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let lane: i32 = tid % 32;
    let row: i32 = vx_gpu_block_idx_x() * (block / 32) + tid / 32;
    if row >= rows { return; }
    // Eight steps a batch: their sixteen loads first, then their terms added in step order, the
    // same sum as one step at a time (a term past the row is +0.0, and sum starts at +0.0, so is
    // never -0.0). ptxas kept four steps in flight, so a 6144-column row was 48 memory round
    // trips in a row, and a matvec of few rows (the router's 256, the indexer's 32) could not
    // hide them (#29); eight halve that.
    let mut sum: f32 = 0.0;
    let row_base: i64 = (row as i64) * (cols as i64);
    let mut c: i32 = lane;
    for batch in 0..((cols + 255) / 256) {
      let t0: f32 = if c < cols { weight[row_base + (c as i64)] * x[c] } else { 0.0 };
      let t1: f32 = if c + 32 < cols { weight[row_base + ((c + 32) as i64)] * x[c + 32] } else { 0.0 };
      let t2: f32 = if c + 64 < cols { weight[row_base + ((c + 64) as i64)] * x[c + 64] } else { 0.0 };
      let t3: f32 = if c + 96 < cols { weight[row_base + ((c + 96) as i64)] * x[c + 96] } else { 0.0 };
      let t4: f32 = if c + 128 < cols { weight[row_base + ((c + 128) as i64)] * x[c + 128] } else { 0.0 };
      let t5: f32 = if c + 160 < cols { weight[row_base + ((c + 160) as i64)] * x[c + 160] } else { 0.0 };
      let t6: f32 = if c + 192 < cols { weight[row_base + ((c + 192) as i64)] * x[c + 192] } else { 0.0 };
      let t7: f32 = if c + 224 < cols { weight[row_base + ((c + 224) as i64)] * x[c + 224] } else { 0.0 };
      sum = sum + t0;
      sum = sum + t1;
      sum = sum + t2;
      sum = sum + t3;
      sum = sum + t4;
      sum = sum + t5;
      sum = sum + t6;
      sum = sum + t7;
      c = c + 256;
    }
    let total: f32 = vxk_warp_sum(sum);
    if lane == 0 { out[row] = total; }
    return;
  }
}

// DSA index scores, one warp per token and all heads in one launch.
// Caller supplies causal keys and head weights already scaled by heads**-0.5.
// No head-by-token score matrix; signed weights apply AFTER the ReLU.
fn vxk_index_scores(out: *mut f32, q: *const f32, keys: *const f32, weights: *const f32, tokens: i32, heads: i32, dim: i32, scale: f32) -> void {
  if tokens <= 0 { return; }
  if heads <= 0 { return; }
  if dim <= 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let lane: i32 = tid % 32;
    let token: i32 = vx_gpu_block_idx_x() * (block / 32) + tid / 32;
    // Whole warps exit together, including tail warps, before full-mask shuffles.
    if token >= tokens { return; }
    // Eight heads a group: their dot products side by side, each in its own order (lane l adds
    // d = l, l + 32, ..), then their eight warp sums, which do not wait on one another, and lane 0
    // adds the weighted heads in head order, so the score is the one-head-at-a-time loop's bit for
    // bit. That loop ran 32 dependent shuffle trees and q loads back to back per token (#29). A
    // head past the end reads the last head's q row and is not added.
    let mut score: f32 = 0.0;
    let mut h0: i32 = 0;
    for group in 0..((heads + 7) / 8) {
      let q0: i32 = h0 * dim;
      let q1: i32 = (if h0 + 1 < heads { h0 + 1 } else { heads - 1 }) * dim;
      let q2: i32 = (if h0 + 2 < heads { h0 + 2 } else { heads - 1 }) * dim;
      let q3: i32 = (if h0 + 3 < heads { h0 + 3 } else { heads - 1 }) * dim;
      let q4: i32 = (if h0 + 4 < heads { h0 + 4 } else { heads - 1 }) * dim;
      let q5: i32 = (if h0 + 5 < heads { h0 + 5 } else { heads - 1 }) * dim;
      let q6: i32 = (if h0 + 6 < heads { h0 + 6 } else { heads - 1 }) * dim;
      let q7: i32 = (if h0 + 7 < heads { h0 + 7 } else { heads - 1 }) * dim;
      let mut dot0: f32 = 0.0;
      let mut dot1: f32 = 0.0;
      let mut dot2: f32 = 0.0;
      let mut dot3: f32 = 0.0;
      let mut dot4: f32 = 0.0;
      let mut dot5: f32 = 0.0;
      let mut dot6: f32 = 0.0;
      let mut dot7: f32 = 0.0;
      let mut d: i32 = lane;
      for iteration in 0..((dim + 31) / 32) {
        if d < dim {
          let key: f32 = keys[token * dim + d];
          dot0 = dot0 + q[q0 + d] * key;
          dot1 = dot1 + q[q1 + d] * key;
          dot2 = dot2 + q[q2 + d] * key;
          dot3 = dot3 + q[q3 + d] * key;
          dot4 = dot4 + q[q4 + d] * key;
          dot5 = dot5 + q[q5 + d] * key;
          dot6 = dot6 + q[q6 + d] * key;
          dot7 = dot7 + q[q7 + d] * key;
        }
        d = d + 32;
      }
      let scaled0: f32 = vxk_warp_sum(dot0) * scale;
      let scaled1: f32 = vxk_warp_sum(dot1) * scale;
      let scaled2: f32 = vxk_warp_sum(dot2) * scale;
      let scaled3: f32 = vxk_warp_sum(dot3) * scale;
      let scaled4: f32 = vxk_warp_sum(dot4) * scale;
      let scaled5: f32 = vxk_warp_sum(dot5) * scale;
      let scaled6: f32 = vxk_warp_sum(dot6) * scale;
      let scaled7: f32 = vxk_warp_sum(dot7) * scale;
      if lane == 0 {
        if h0 + 0 < heads { let mut a: f32 = scaled0; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 0] * a; }
        if h0 + 1 < heads { let mut a: f32 = scaled1; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 1] * a; }
        if h0 + 2 < heads { let mut a: f32 = scaled2; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 2] * a; }
        if h0 + 3 < heads { let mut a: f32 = scaled3; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 3] * a; }
        if h0 + 4 < heads { let mut a: f32 = scaled4; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 4] * a; }
        if h0 + 5 < heads { let mut a: f32 = scaled5; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 5] * a; }
        if h0 + 6 < heads { let mut a: f32 = scaled6; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 6] * a; }
        if h0 + 7 < heads { let mut a: f32 = scaled7; if a < 0.0 { a = 0.0; } score = score + weights[h0 + 7] * a; }
      }
      h0 = h0 + 8;
    }
    if lane == 0 { out[token] = score; }
    return;
  }
}

pub extern fn glm_vx_gpu_index_scores(out: *mut f32, q: *const f32, keys: *const f32, weights: *const f32, tokens: i32, heads: i32, dim: i32, scale: f32) -> void {
  vxk_index_scores(out, q, keys, weights, tokens, heads, dim, scale);
  return;
}

// A graph-captured decode step's arguments that change every token: step[0] the position,
// step[1] the causal tokens, step[2] the selected count, step[3] the MLA splits. The `_at`
// entries read them on the device and run the same code as their plain entries; launch them
// with the grid for the most tokens (or splits), and the blocks past the step's value exit.
pub extern fn glm_vx_gpu_index_scores_at(out: *mut f32, q: *const f32, keys: *const f32, weights: *const f32, step: *const i32, heads: i32, dim: i32, scale: f32) -> void {
  unsafe {
    let tokens: i32 = step[1];
    vxk_index_scores(out, q, keys, weights, tokens, heads, dim, scale);
    return;
  }
}

// Absorbed MLA: dot(q_latent,cache_latent) + dot(q_rope,cache_rope).
// Cache latent is also the value. One CTA per (head, split), one value/thread.
// Online softmax keeps O(rank) state without materializing scores/probabilities.
fn vxk_mla_partial(numerator: *mut f32, stats: *mut f32, q_latent: *const f32, q_rope: *const f32, cache_latent: *const f32, cache_rope: *const f32, selected: *const i32, heads: i32, rank: i32, rope_dim: i32, tokens: i32, count: i32, selection_stride: i32, splits: i32, scale: f32) -> void {
  if heads <= 0 { return; }
  if rank <= 0 { return; }
  if rope_dim < 0 { return; }
  if tokens < 0 { return; }
  if count < 0 { return; }
  if selection_stride < 0 { return; }
  if splits <= 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    let task: i32 = vx_gpu_block_idx_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    if block < rank { return; }
    if task >= heads * splits { return; }
    let h: i32 = task / splits;
    let split: i32 = task % splits;
    let mut m: f32 = 0.0;
    let mut l: f32 = 0.0;
    let mut acc: f32 = 0.0;
    let mut j: i32 = split;
    for iteration in 0..((count + splits - 1) / splits) {
      if j < count {
        let token: i32 = selected[h * selection_stride + j];
        // Padding/out-of-range IDs are masked uniformly across the CTA.
        if token >= 0 {
          if token < tokens {
            let mut dot: f32 = 0.0;
            let mut value: f32 = 0.0;
            if tid < rank {
              value = cache_latent[token * rank + tid];
              dot = q_latent[h * rank + tid] * value;
            }
            let mut d: i32 = tid;
            for iteration in 0..((rope_dim + block - 1) / block) {
              if d < rope_dim {
                dot = dot + q_rope[h * rope_dim + d] * cache_rope[token * rope_dim + d];
              }
              d = d + block;
            }
            let score: f32 = vxk_block_sum(dot) * scale;
            let mut next_m: f32 = score;
            let mut alpha: f32 = 0.0;
            let mut beta: f32 = 1.0;
            if l > 0.0 {
              if m > score { next_m = m; }
              alpha = expf(m - next_m);
              beta = expf(score - next_m);
            }
            acc = acc * alpha + beta * value;
            l = l * alpha + beta;
            m = next_m;
          }
        }
      }
      j = j + splits;
    }
    if tid < rank { numerator[task * rank + tid] = acc; }
    if tid == 0 { stats[task * 2] = m; stats[task * 2 + 1] = l; }
    return;
  }
}

pub extern fn glm_vx_gpu_mla_partial(numerator: *mut f32, stats: *mut f32, q_latent: *const f32, q_rope: *const f32, cache_latent: *const f32, cache_rope: *const f32, selected: *const i32, heads: i32, rank: i32, rope_dim: i32, tokens: i32, count: i32, selection_stride: i32, splits: i32, scale: f32) -> void {
  vxk_mla_partial(numerator, stats, q_latent, q_rope, cache_latent, cache_rope, selected, heads, rank, rope_dim, tokens, count, selection_stride, splits, scale);
  return;
}

// mla_partial with tokens, count and splits from step (see index_scores_at); grid heads * the most splits.
pub extern fn glm_vx_gpu_mla_partial_at(numerator: *mut f32, stats: *mut f32, q_latent: *const f32, q_rope: *const f32, cache_latent: *const f32, cache_rope: *const f32, selected: *const i32, step: *const i32, heads: i32, rank: i32, rope_dim: i32, selection_stride: i32, scale: f32) -> void {
  unsafe {
    let tokens: i32 = step[1];
    let count: i32 = step[2];
    let splits: i32 = step[3];
    vxk_mla_partial(numerator, stats, q_latent, q_rope, cache_latent, cache_rope, selected, heads, rank, rope_dim, tokens, count, selection_stride, splits, scale);
    return;
  }
}

// Stable merge of independent online-softmax partitions, one CTA/head.
fn vxk_mla_merge(out: *mut f32, numerator: *const f32, stats: *const f32, heads: i32, rank: i32, splits: i32) -> void {
  if heads <= 0 { return; }
  if rank <= 0 { return; }
  if splits <= 0 { return; }
  unsafe {
    let h: i32 = vx_gpu_block_idx_x();
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if h >= heads { return; }
    let mut m: f32 = 0.0;
    let mut seen: i32 = 0;
    for s in 0..splits {
      let task: i32 = h * splits + s;
      if stats[task * 2 + 1] > 0.0 {
        let v: f32 = stats[task * 2];
        if seen == 0 { m = v; seen = 1; }
        else { if v > m { m = v; } }
      }
    }
    let mut d: i32 = tid;
    for iteration in 0..((rank + block - 1) / block) {
      d = tid + iteration * block;
      if d < rank {
        let mut sum: f32 = 0.0;
        let mut denominator: f32 = 0.0;
        for s in 0..splits {
          let task: i32 = h * splits + s;
          let l: f32 = stats[task * 2 + 1];
          if l > 0.0 {
            let factor: f32 = expf(stats[task * 2] - m);
            sum = sum + numerator[task * rank + d] * factor;
            denominator = denominator + l * factor;
          }
        }
        let mut result: f32 = 0.0;
        if denominator > 0.0 { result = sum / denominator; }
        out[h * rank + d] = result;
      }
    }
    return;
  }
}

pub extern fn glm_vx_gpu_mla_merge(out: *mut f32, numerator: *const f32, stats: *const f32, heads: i32, rank: i32, splits: i32) -> void {
  vxk_mla_merge(out, numerator, stats, heads, rank, splits);
  return;
}

// mla_merge with splits from step (see index_scores_at).
pub extern fn glm_vx_gpu_mla_merge_at(out: *mut f32, numerator: *const f32, stats: *const f32, step: *const i32, heads: i32, rank: i32) -> void {
  unsafe {
    let splits: i32 = step[3];
    vxk_mla_merge(out, numerator, stats, heads, rank, splits);
    return;
  }
}

fn vxk_sigmoid(x: f32) -> f32 {
  let mut result: f32 = 0.0;
  unsafe {
    if x >= 0.0 { result = 1.0 / (1.0 + expf(0.0 - x)); }
    else { let z: f32 = expf(x); result = z / (1.0 + z); }
  }
  return result;
}

fn vxk_warp_max(value: f32) -> f32 {
  let mut result: f32 = value;
  unsafe {
    let mut delta: i32 = 16;
    for step in 0..5 {
      let other: f32 = vx_gpu_shuffle_down_f32(result, delta);
      if other > result { result = other; }
      delta = delta / 2;
    }
  }
  return result;
}

fn vxk_block_max(value: f32) -> f32 {
  let mut result: f32 = value;
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let lane: i32 = tid % 32;
    let warp: i32 = tid / 32;
    let warps: i32 = vx_gpu_block_dim_x() / 32;
    let shared: *mut f32 = vx_gpu_shared_f32();
    let partial: f32 = vxk_warp_max(value);
    if lane == 0 { shared[warp] = partial; }
    vx_gpu_barrier();
    if warp == 0 {
      let mut v: f32 = shared[0];
      if lane < warps { v = shared[lane]; }
      let total: f32 = vxk_warp_max(v);
      if lane == 0 { shared[32] = total; }
    }
    vx_gpu_barrier();
    result = shared[32];
  }
  return result;
}

// Standalone batched-row forms for compatibility with existing model operators.
fn vxk_rmsnorm_rows(out: *mut f32, x: *const f32, weight: *const f32, rows: i32, dim: i32, eps: f32) -> void {
  if rows <= 0 { return; }
  unsafe {
    let row: i32 = vx_gpu_block_idx_x();
    if row >= rows { return; }
    vxk_rmsnorm_row(out, x, weight, row * dim, dim, eps);
    return;
  }
}

// One block's RMSNorm of the row at x[base ..] into out[base ..] (vxk_rmsnorm_rows' row, and each
// of glm_vx_gpu_rmsnorm_pair's two).
fn vxk_rmsnorm_row(out: *mut f32, x: *const f32, weight: *const f32, base: i32, dim: i32, eps: f32) -> void {
  if dim <= 0 { return; }
  if eps <= 0.0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    // Eight steps a batch, their loads first (as glm_vx_gpu_matvec): one block reads the whole
    // row, so a step's memory round trip was the kernel's time (#29). The same sums: a square past
    // the row is +0.0 and ss starts at +0.0.
    let mut ss: f32 = 0.0;
    for batch in 0..((dim + 8 * block - 1) / (8 * block)) {
      let d: i32 = tid + batch * 8 * block;
      let q0: f32 = if d < dim { x[base + d] * x[base + d] } else { 0.0 };
      let q1: f32 = if d + 1 * block < dim { x[base + d + 1 * block] * x[base + d + 1 * block] } else { 0.0 };
      let q2: f32 = if d + 2 * block < dim { x[base + d + 2 * block] * x[base + d + 2 * block] } else { 0.0 };
      let q3: f32 = if d + 3 * block < dim { x[base + d + 3 * block] * x[base + d + 3 * block] } else { 0.0 };
      let q4: f32 = if d + 4 * block < dim { x[base + d + 4 * block] * x[base + d + 4 * block] } else { 0.0 };
      let q5: f32 = if d + 5 * block < dim { x[base + d + 5 * block] * x[base + d + 5 * block] } else { 0.0 };
      let q6: f32 = if d + 6 * block < dim { x[base + d + 6 * block] * x[base + d + 6 * block] } else { 0.0 };
      let q7: f32 = if d + 7 * block < dim { x[base + d + 7 * block] * x[base + d + 7 * block] } else { 0.0 };
      ss = ss + q0;
      ss = ss + q1;
      ss = ss + q2;
      ss = ss + q3;
      ss = ss + q4;
      ss = ss + q5;
      ss = ss + q6;
      ss = ss + q7;
    }
    let total: f32 = vxk_block_sum(ss);
    let inv: f32 = 1.0 / sqrtf(total / (dim as f32) + eps);
    for batch in 0..((dim + 8 * block - 1) / (8 * block)) {
      let d: i32 = tid + batch * 8 * block;
      let v0: f32 = if d < dim { x[base + d] * inv * weight[d] } else { 0.0 };
      let v1: f32 = if d + 1 * block < dim { x[base + d + 1 * block] * inv * weight[d + 1 * block] } else { 0.0 };
      let v2: f32 = if d + 2 * block < dim { x[base + d + 2 * block] * inv * weight[d + 2 * block] } else { 0.0 };
      let v3: f32 = if d + 3 * block < dim { x[base + d + 3 * block] * inv * weight[d + 3 * block] } else { 0.0 };
      let v4: f32 = if d + 4 * block < dim { x[base + d + 4 * block] * inv * weight[d + 4 * block] } else { 0.0 };
      let v5: f32 = if d + 5 * block < dim { x[base + d + 5 * block] * inv * weight[d + 5 * block] } else { 0.0 };
      let v6: f32 = if d + 6 * block < dim { x[base + d + 6 * block] * inv * weight[d + 6 * block] } else { 0.0 };
      let v7: f32 = if d + 7 * block < dim { x[base + d + 7 * block] * inv * weight[d + 7 * block] } else { 0.0 };
      if d < dim { out[base + d] = v0; }
      if d + 1 * block < dim { out[base + d + 1 * block] = v1; }
      if d + 2 * block < dim { out[base + d + 2 * block] = v2; }
      if d + 3 * block < dim { out[base + d + 3 * block] = v3; }
      if d + 4 * block < dim { out[base + d + 4 * block] = v4; }
      if d + 5 * block < dim { out[base + d + 5 * block] = v5; }
      if d + 6 * block < dim { out[base + d + 6 * block] = v6; }
      if d + 7 * block < dim { out[base + d + 7 * block] = v7; }
    }
    return;
  }
}

fn vxk_softmax_rows(out: *mut f32, x: *const f32, rows: i32, dim: i32) -> void {
  if rows <= 0 { return; }
  if dim <= 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    let row: i32 = vx_gpu_block_idx_x();
    if row >= rows { return; }
    let base: i32 = row * dim;
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let mut maximum: f32 = x[base];
    for iteration in 0..((dim + block - 1) / block) {
      let d: i32 = tid + iteration * block;
      if d < dim { if x[base + d] > maximum { maximum = x[base + d]; } }
    }
    maximum = vxk_block_max(maximum);
    let mut sum: f32 = 0.0;
    for iteration in 0..((dim + block - 1) / block) {
      let d: i32 = tid + iteration * block;
      if d < dim {
        let v: f32 = expf(x[base + d] - maximum);
        out[base + d] = v;
        sum = sum + v;
      }
    }
    let denominator: f32 = vxk_block_sum(sum);
    for iteration in 0..((dim + block - 1) / block) {
      let d: i32 = tid + iteration * block;
      if d < dim { out[base + d] = out[base + d] / denominator; }
    }
    return;
  }
}

// Stable warp argmax; negative index marks an empty lane. IDs <=256 are
// exactly representable as f32, permitting the same shuffle ABI for the pair.
fn vxk_warp_argmax(score: f32, index: i32) -> i32 {
  let mut result: i32 = index;
  unsafe {
    let mut best: f32 = score;
    let mut delta: i32 = 16;
    for step in 0..5 {
      let other_score: f32 = vx_gpu_shuffle_down_f32(best, delta);
      let other_index: i32 = vx_gpu_shuffle_down_f32(result as f32, delta) as i32;
      let mut replace: i32 = 0;
      if other_index >= 0 {
        if result < 0 { replace = 1; }
        else {
          if other_score > best { replace = 1; }
          if other_score == best { if other_index < result { replace = 1; } }
        }
      }
      if replace != 0 { best = other_score; result = other_index; }
      delta = delta / 2;
    }
    result = vx_gpu_shuffle_idx_f32(result as f32, 0) as i32;
  }
  return result;
}

// vxk_sigmoid's bits without its branch: the same expf argument and the same division, chosen by
// selects, so the router's sixteen loads have no branch to sink behind (#29).
fn vxk_sigmoid_flat(x: f32) -> f32 {
  let mut result: f32 = 0.0;
  unsafe {
    let positive: bool = x >= 0.0;
    let z: f32 = expf(if positive { 0.0 - x } else { x });
    let top: f32 = if positive { 1.0 } else { z };
    result = top / (1.0 + z);
  }
  return result;
}

// Lane `lane`'s score for its c-th expert, lane + 32c (c < 8): the router's scores in registers.
fn vxk_router_score(c: i32, s0: f32, s1: f32, s2: f32, s3: f32, s4: f32, s5: f32, s6: f32, s7: f32) -> f32 {
  let mut result: f32 = s7;
  if c == 0 { result = s0; }
  if c == 1 { result = s1; }
  if c == 2 { result = s2; }
  if c == 3 { result = s3; }
  if c == 4 { result = s4; }
  if c == 5 { result = s5; }
  if c == 6 { result = s6; }
  return result;
}

// One full warp, bounded E<=256,K<=8. Selection bias changes IDs only.
// Each lane reads its (at most eight) experts' scores once, into registers, and marks the experts
// taken in a bit mask, so a slot is register compares and one warp argmax: no reload of the
// logits, the bias and the indices chosen so far, and no barrier, per slot (#29). The rule is
// unchanged: a lane keeps its first largest score in expert order, and the warp the lower id on a
// tie, so the ids and weights are the old kernel's bit for bit (gpu/test_simt.py).
pub extern fn glm_vx_gpu_router(indices: *mut i32, weights: *mut f32, logits: *const f32, bias: *const f32, experts: i32, k: i32, scale: f32) -> void {
  if experts <= 0 { return; }
  if experts > 256 { return; }
  if k <= 0 { return; }
  if k > 8 { return; }
  if k > experts { return; }
  unsafe {
    if vx_gpu_block_idx_x() != 0 { return; }
    if vx_gpu_block_dim_x() != 32 { return; }
    let lane: i32 = vx_gpu_thread_idx_x();
    // All sixteen loads first, from an index clamped into range, and no guard after them, so
    // none waits behind another's sigmoid. A score past the end is never read: `taken` masks it.
    let last: i32 = experts - 1;
    let i0: i32 = if lane < experts { lane } else { last };
    let i1: i32 = if lane + 32 < experts { lane + 32 } else { last };
    let i2: i32 = if lane + 64 < experts { lane + 64 } else { last };
    let i3: i32 = if lane + 96 < experts { lane + 96 } else { last };
    let i4: i32 = if lane + 128 < experts { lane + 128 } else { last };
    let i5: i32 = if lane + 160 < experts { lane + 160 } else { last };
    let i6: i32 = if lane + 192 < experts { lane + 192 } else { last };
    let i7: i32 = if lane + 224 < experts { lane + 224 } else { last };
    let l0: f32 = logits[i0];
    let l1: f32 = logits[i1];
    let l2: f32 = logits[i2];
    let l3: f32 = logits[i3];
    let l4: f32 = logits[i4];
    let l5: f32 = logits[i5];
    let l6: f32 = logits[i6];
    let l7: f32 = logits[i7];
    let b0: f32 = bias[i0];
    let b1: f32 = bias[i1];
    let b2: f32 = bias[i2];
    let b3: f32 = bias[i3];
    let b4: f32 = bias[i4];
    let b5: f32 = bias[i5];
    let b6: f32 = bias[i6];
    let b7: f32 = bias[i7];
    let s0: f32 = vxk_sigmoid_flat(l0) + b0;
    let s1: f32 = vxk_sigmoid_flat(l1) + b1;
    let s2: f32 = vxk_sigmoid_flat(l2) + b2;
    let s3: f32 = vxk_sigmoid_flat(l3) + b3;
    let s4: f32 = vxk_sigmoid_flat(l4) + b4;
    let s5: f32 = vxk_sigmoid_flat(l5) + b5;
    let s6: f32 = vxk_sigmoid_flat(l6) + b6;
    let s7: f32 = vxk_sigmoid_flat(l7) + b7;
    // Bit c: expert lane + 32c is past the end or already chosen.
    let mut taken: u32 = 0u32;
    for c in 0..8 { if lane + c * 32 >= experts { taken = taken | (1u32 << (c as u32)); } }
    let mut mine: i32 = 0;
    for slot in 0..k {
      let mut best_index: i32 = -1;
      let mut best_score: f32 = 0.0;
      for c in 0..8 {
        if ((taken >> (c as u32)) & 1u32) == 0u32 {
          let score: f32 = vxk_router_score(c, s0, s1, s2, s3, s4, s5, s6, s7);
          if best_index < 0 { best_index = lane + c * 32; best_score = score; }
          else { if score > best_score { best_index = lane + c * 32; best_score = score; } }
        }
      }
      let chosen: i32 = vxk_warp_argmax(best_score, best_index);
      if chosen >= 0 {
        if chosen % 32 == lane { taken = taken | (1u32 << ((chosen / 32) as u32)); }
      }
      if lane == slot { mine = chosen; }
    }
    let mut value: f32 = 0.0;
    if lane < k { value = vxk_sigmoid(logits[mine]); }
    let partial: f32 = vxk_warp_sum(value);
    let total: f32 = vx_gpu_shuffle_idx_f32(partial, 0) + 0.00000000000000000001;
    if lane < k { indices[lane] = mine; weights[lane] = value / total * scale; }
    return;
  }
}

// Keep the original single-vector ABI stable; explicit _rows entries batch it.
pub extern fn glm_vx_gpu_rmsnorm(out: *mut f32, x: *const f32, weight: *const f32, n: i32, eps: f32) -> void {
  vxk_rmsnorm_rows(out, x, weight, 1, n, eps);
  return;
}

pub extern fn glm_vx_gpu_rmsnorm_rows(out: *mut f32, x: *const f32, weight: *const f32, rows: i32, dim: i32, eps: f32) -> void {
  vxk_rmsnorm_rows(out, x, weight, rows, dim, eps);
  return;
}

pub extern fn glm_vx_gpu_softmax(out: *mut f32, x: *const f32, n: i32) -> void {
  vxk_softmax_rows(out, x, 1, n);
  return;
}

pub extern fn glm_vx_gpu_softmax_rows(out: *mut f32, x: *const f32, rows: i32, dim: i32) -> void {
  vxk_softmax_rows(out, x, rows, dim);
  return;
}

// ---- Device-resident decode support (gpu/resident.py) -------------------------------------
// Elementwise kernels use the grid-stride loop of swiglu. In-place use (out == a / out == x
// exactly) is allowed because each thread touches only its own index.

pub extern fn glm_vx_gpu_add(out: *mut f32, a: *const f32, b: *const f32, n: i32) -> void {
  unsafe {
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((n + stride - 1) / stride) {
      if i < n { out[i] = a[i] + b[i]; }
      i = i + stride;
    }
    return;
  }
}

pub extern fn glm_vx_gpu_copy(out: *mut f32, x: *const f32, n: i32) -> void {
  unsafe {
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((n + stride - 1) / stride) {
      if i < n { out[i] = x[i]; }
      i = i + stride;
    }
    return;
  }
}

// cache[step[0] * width + i] = row[i]: a cache row at the step's position (see index_scores_at).
pub extern fn glm_vx_gpu_store_row(cache: *mut f32, row: *const f32, step: *const i32, width: i32) -> void {
  unsafe {
    let base: i32 = step[0] * width;
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((width + stride - 1) / stride) {
      if i < width { cache[base + i] = row[i]; }
      i = i + stride;
    }
    return;
  }
}

// ---- Glue fusions (#39, ResidentGLM(fuse_glue=True)) -------------------------------------
// Each gives the bits of the launches it replaces: the same sums in the same order through
// vxk_block_sum, the same per-element arithmetic.

// glm_vx_gpu_residual_rmsnorm with its loads first, eight a thread a batch, and the sums kept in
// registers for the second pass (it read residual_out back from memory); the weights are loaded
// before the block sum too (5.1 -> 3.1 us on the H200 at hidden 6144): residual_out = x +
// residual, out = RMSNorm(residual_out). ss adds the same squares in the same order (a square past
// the row is +0.0), so the bits are residual_rmsnorm's, and add then rmsnorm's.
pub extern fn glm_vx_gpu_residual_rmsnorm8(out: *mut f32, residual_out: *mut f32, x: *const f32, residual: *const f32, weight: *const f32, dim: i32, eps: f32) -> void {
  if dim <= 0 { return; }
  if eps <= 0.0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if vx_gpu_block_idx_x() != 0 { return; }
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    if dim > 8 * block { return; }
    let d: i32 = tid;
    let v0: f32 = if d < dim { x[d] + residual[d] } else { 0.0 };
    let v1: f32 = if d + 1 * block < dim { x[d + 1 * block] + residual[d + 1 * block] } else { 0.0 };
    let v2: f32 = if d + 2 * block < dim { x[d + 2 * block] + residual[d + 2 * block] } else { 0.0 };
    let v3: f32 = if d + 3 * block < dim { x[d + 3 * block] + residual[d + 3 * block] } else { 0.0 };
    let v4: f32 = if d + 4 * block < dim { x[d + 4 * block] + residual[d + 4 * block] } else { 0.0 };
    let v5: f32 = if d + 5 * block < dim { x[d + 5 * block] + residual[d + 5 * block] } else { 0.0 };
    let v6: f32 = if d + 6 * block < dim { x[d + 6 * block] + residual[d + 6 * block] } else { 0.0 };
    let v7: f32 = if d + 7 * block < dim { x[d + 7 * block] + residual[d + 7 * block] } else { 0.0 };
    if d < dim { residual_out[d] = v0; }
    if d + 1 * block < dim { residual_out[d + 1 * block] = v1; }
    if d + 2 * block < dim { residual_out[d + 2 * block] = v2; }
    if d + 3 * block < dim { residual_out[d + 3 * block] = v3; }
    if d + 4 * block < dim { residual_out[d + 4 * block] = v4; }
    if d + 5 * block < dim { residual_out[d + 5 * block] = v5; }
    if d + 6 * block < dim { residual_out[d + 6 * block] = v6; }
    if d + 7 * block < dim { residual_out[d + 7 * block] = v7; }
    let w0: f32 = if d + 0 * block < dim { weight[d + 0 * block] } else { 0.0 };
    let w1: f32 = if d + 1 * block < dim { weight[d + 1 * block] } else { 0.0 };
    let w2: f32 = if d + 2 * block < dim { weight[d + 2 * block] } else { 0.0 };
    let w3: f32 = if d + 3 * block < dim { weight[d + 3 * block] } else { 0.0 };
    let w4: f32 = if d + 4 * block < dim { weight[d + 4 * block] } else { 0.0 };
    let w5: f32 = if d + 5 * block < dim { weight[d + 5 * block] } else { 0.0 };
    let w6: f32 = if d + 6 * block < dim { weight[d + 6 * block] } else { 0.0 };
    let w7: f32 = if d + 7 * block < dim { weight[d + 7 * block] } else { 0.0 };
    let mut ss: f32 = 0.0;
    ss = ss + v0 * v0;
    ss = ss + v1 * v1;
    ss = ss + v2 * v2;
    ss = ss + v3 * v3;
    ss = ss + v4 * v4;
    ss = ss + v5 * v5;
    ss = ss + v6 * v6;
    ss = ss + v7 * v7;
    let total: f32 = vxk_block_sum(ss);
    let inv: f32 = 1.0 / sqrtf(total / (dim as f32) + eps);
    if d < dim { out[d] = v0 * inv * w0; }
    if d + 1 * block < dim { out[d + 1 * block] = v1 * inv * w1; }
    if d + 2 * block < dim { out[d + 2 * block] = v2 * inv * w2; }
    if d + 3 * block < dim { out[d + 3 * block] = v3 * inv * w3; }
    if d + 4 * block < dim { out[d + 4 * block] = v4 * inv * w4; }
    if d + 5 * block < dim { out[d + 5 * block] = v5 * inv * w5; }
    if d + 6 * block < dim { out[d + 6 * block] = v6 * inv * w6; }
    if d + 7 * block < dim { out[d + 7 * block] = v7 * inv * w7; }
    return;
  }
}

// Two RMSNorms in one launch of two blocks: block 0 normalizes a (dim_a) into out_a, block 1 b
// into out_b, each as glm_vx_gpu_rmsnorm does (vxk_rmsnorm_rows' loop and sums), so the same bits.
// The attention's q_a and kv_a norms, which both read only q_a + kv_a's projection.
pub extern fn glm_vx_gpu_rmsnorm_pair(out_a: *mut f32, x_a: *const f32, weight_a: *const f32, dim_a: i32, out_b: *mut f32, x_b: *const f32, weight_b: *const f32, dim_b: i32, eps: f32) -> void {
  unsafe {
    if vx_gpu_block_idx_x() == 0 {
      vxk_rmsnorm_row(out_a, x_a, weight_a, 0, dim_a, eps);
    } else {
      vxk_rmsnorm_row(out_b, x_b, weight_b, 0, dim_b, eps);
    }
    return;
  }
}

// The DSA indexer's key row in one launch of one block, for graph replay: LayerNorm with bias (as
// glm_vx_gpu_layernorm), RoPE on its first `rot` values (as glm_vx_gpu_rope_strided: packed
// [rotated even, rotated odd]), and the row stored at the step's position, cache[step[0] * dim + d]
// (as glm_vx_gpu_store_row). Thread d writes value d past rot; thread p < rot / 2 computes the
// normalized pair (2p, 2p + 1) with the same arithmetic and writes its two rotated values.
pub extern fn glm_vx_gpu_index_key_at(cache: *mut f32, x: *const f32, weight: *const f32, bias: *const f32, cosine: *const f32, sine: *const f32, step: *const i32, dim: i32, rot: i32, eps: f32) -> void {
  if dim <= 0 { return; }
  if eps <= 0.0 { return; }
  if rot < 0 { return; }
  if rot > dim { return; }
  if rot % 2 != 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if vx_gpu_block_idx_x() != 0 { return; }
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    if rot / 2 > block { return; }
    let base: i32 = step[0] * dim;
    let mut s: f32 = 0.0;
    let mut d: i32 = tid;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim { s = s + x[d]; }
    }
    let mean: f32 = vxk_block_sum(s) / (dim as f32);
    let mut ss: f32 = 0.0;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim {
        let c: f32 = x[d] - mean;
        ss = ss + c * c;
      }
    }
    let inv: f32 = 1.0 / sqrtf(vxk_block_sum(ss) / (dim as f32) + eps);
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim && d >= rot { cache[base + d] = (x[d] - mean) * inv * weight[d] + bias[d]; }
    }
    let pairs: i32 = rot / 2;
    if tid < pairs {
      let e: i32 = tid * 2;
      let a: f32 = (x[e] - mean) * inv * weight[e] + bias[e];
      let b: f32 = (x[e + 1] - mean) * inv * weight[e + 1] + bias[e + 1];
      cache[base + tid] = a * cosine[tid] - b * sine[tid];
      cache[base + pairs + tid] = b * cosine[tid] + a * sine[tid];
    }
    return;
  }
}

pub extern fn glm_vx_gpu_scale(out: *mut f32, x: *const f32, alpha: f32, n: i32) -> void {
  unsafe {
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((n + stride - 1) / stride) {
      if i < n { out[i] = x[i] * alpha; }
      i = i + stride;
    }
    return;
  }
}

// out[i] = out[i] + x[i] * weights[slot]: the weighted expert accumulation, with the router
// weight read on the device so no host round trip is needed. Two roundings, as the host path.
pub extern fn glm_vx_gpu_scaled_add(out: *mut f32, x: *const f32, weights: *const f32, slot: i32, n: i32) -> void {
  unsafe {
    let w: f32 = weights[slot];
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((n + stride - 1) / stride) {
      if i < n {
        let weighted: f32 = x[i] * w;
        out[i] = out[i] + weighted;
      }
      i = i + stride;
    }
    return;
  }
}

// LayerNorm with bias over the last dimension (the DSA indexer key norm). One CTA per row;
// mean first, then the variance of the centered values.
pub extern fn glm_vx_gpu_layernorm(out: *mut f32, x: *const f32, weight: *const f32, bias: *const f32, rows: i32, dim: i32, eps: f32) -> void {
  if rows <= 0 { return; }
  if dim <= 0 { return; }
  if eps <= 0.0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let row: i32 = vx_gpu_block_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if row >= rows { return; }
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let base: i32 = row * dim;
    let mut s: f32 = 0.0;
    let mut d: i32 = tid;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim { s = s + x[base + d]; }
    }
    let mean: f32 = vxk_block_sum(s) / (dim as f32);
    let mut ss: f32 = 0.0;
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim {
        let c: f32 = x[base + d] - mean;
        ss = ss + c * c;
      }
    }
    let inv: f32 = 1.0 / sqrtf(vxk_block_sum(ss) / (dim as f32) + eps);
    for iteration in 0..((dim + block - 1) / block) {
      d = tid + iteration * block;
      if d < dim { out[base + d] = (x[base + d] - mean) * inv * weight[d] + bias[d]; }
    }
    return;
  }
}

// RoPE on a strided slice of rows: head h reads x[h*x_stride ..] and writes out[h*out_stride ..]
// (packed [rotated even, rotated odd]), arithmetic identical to glm_vx_gpu_rope_glm. Lets the
// rotary part of [heads, nope+rot] queries be rotated in place of a gather.
pub extern fn glm_vx_gpu_rope_strided(out: *mut f32, x: *const f32, cosine: *const f32, sine: *const f32, heads: i32, dim: i32, x_stride: i32, out_stride: i32) -> void {
  if heads <= 0 { return; }
  if dim <= 0 { return; }
  if dim % 2 != 0 { return; }
  unsafe {
    let pairs: i32 = dim / 2;
    let mut i: i32 = vx_gpu_block_idx_x() * vx_gpu_block_dim_x() + vx_gpu_thread_idx_x();
    let stride: i32 = vx_gpu_grid_dim_x() * vx_gpu_block_dim_x();
    for iteration in 0..((heads * pairs + stride - 1) / stride) {
      if i < heads * pairs {
        let h: i32 = i / pairs;
        let p: i32 = i % pairs;
        let xb: i32 = h * x_stride;
        let ob: i32 = h * out_stride;
        let a: f32 = x[xb + p * 2];
        let b: f32 = x[xb + p * 2 + 1];
        let c: f32 = cosine[p];
        let s: f32 = sine[p];
        out[ob + p] = a * c - b * s;
        out[ob + pairs + p] = b * c + a * s;
      }
      i = i + stride;
    }
    return;
  }
}

// Per-head matvec in one launch: out[h*out_stride + r] = sum_c weight[h*w_stride + r*cols + c]
// * x[h*x_stride + c]. A warp owns one (head,row); the column loop and warp reduction are those
// of glm_vx_gpu_matvec, so each head matches a separate matvec bit for bit. Used for the absorbed
// MLA query (W_k^T q_nope) and the value up-projection.
pub extern fn glm_vx_gpu_matvec_heads(out: *mut f32, weight: *const f32, x: *const f32, heads: i32, rows: i32, cols: i32, w_stride: i32, x_stride: i32, out_stride: i32) -> void {
  if heads <= 0 { return; }
  if rows <= 0 { return; }
  if cols < 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let lane: i32 = tid % 32;
    let index: i64 = (vx_gpu_block_idx_x() as i64) * ((block / 32) as i64) + ((tid / 32) as i64);
    if index >= (heads as i64) * (rows as i64) { return; }
    let h: i64 = index / (rows as i64);
    let r: i64 = index % (rows as i64);
    let wbase: i64 = h * (w_stride as i64) + r * (cols as i64);
    let xbase: i64 = h * (x_stride as i64);
    let mut sum: f32 = 0.0;
    let mut c: i32 = lane;
    for iteration in 0..((cols + 31) / 32) {
      if c < cols { sum = sum + weight[wbase + (c as i64)] * x[xbase + (c as i64)]; }
      c = c + 32;
    }
    let total: f32 = vxk_warp_sum(sum);
    if lane == 0 { out[h * (out_stride as i64) + r] = total; }
    return;
  }
}
