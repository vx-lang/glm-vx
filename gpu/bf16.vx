// BF16-weight projections (M5). Weights are raw bfloat16 bits as uint16 (the top half of a
// binary32); activations, accumulation and output are float32. See BF16.md for the launch contract.
// Keep this CPU-reference prefix self-contained: test_quant_simt.py exercises it through libsimt.
// bfloat16 bits (0..65535) to f32, exact for every encoding. Built from exact power-of-two
// products (the hand PTX path has no bit cast); subnormals stay subnormal, inf/NaN preserved.
pub fn glm_vx_bf16_decode(bits: i32) -> f32 {
  let exponent: i32 = (bits >> 7) & 255;
  let mantissa: i32 = bits & 127;
  let mut magnitude: f32 = (mantissa as f32) / 128.0;
  let mut shift: i32 = -126;
  if exponent > 0 {
    magnitude = ((128 + mantissa) as f32) / 128.0;
    shift = exponent - 127;
  }
  let mut power: f32 = 1.0;
  while shift > 30 { power = power * 1073741824.0; shift = shift - 30; }
  while shift < -30 { power = power / 1073741824.0; shift = shift + 30; }
  if shift >= 0 { power = power * ((1 << shift) as f32); }
  if shift < 0 { power = power / ((1 << (0 - shift)) as f32); }
  magnitude = magnitude * power;
  if exponent == 255 {
    if mantissa == 0 { magnitude = 1.0 / 0.0; }
    if mantissa != 0 { magnitude = 0.0 / 0.0; }
  }
  let mut sign: f32 = 1.0;
  if (bits & 32768) != 0 { sign = -1.0; }
  return magnitude * sign;
}

// GPU ENTRY: CPU tests compile the unchanged prefix above this marker.
extern "C" {
  fn vx_gpu_thread_idx_x() -> i32;
  fn vx_gpu_block_idx_x() -> i32;
  fn vx_gpu_block_dim_x() -> i32;
  fn vx_gpu_shuffle_down_f32(value: f32, delta: i32) -> f32;
}

// Single vector: out[N] = W[N, K] x[K]. One warp per row, block a multiple of 32; lanes read
// adjacent 16-bit weights and accumulate in float32, then a full-warp shuffle reduction.
pub fn glm_vx_gpu_bf16_matvec(out: *mut f32, weight: *const u16, x: *const f32, rows: i32, cols: i32) -> void {
  if rows <= 0 { return; }
  if cols < 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let lane: i32 = tid & 31;
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let warps: i32 = block / 32;
    let row: i64 = (vx_gpu_block_idx_x() as i64) * (warps as i64) + ((tid / 32) as i64);
    if row < (rows as i64) {
      let k: i64 = cols as i64;
      let row_base: i64 = row * k;
      let mut sum: f32 = 0.0;
      let mut col: i64 = lane as i64;
      while col < k {
        sum = sum + glm_vx_bf16_decode(weight[row_base + col] as i32) * x[col];
        col = col + 32;
      }
      sum = sum + vx_gpu_shuffle_down_f32(sum, 16);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 8);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 4);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 2);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 1);
      if lane == 0 { out[row] = sum; }
    }
    return;
  }
}

// Batched and grouped. out[m, n] = sum_k W_e[n, k] * x[m, k] for M activation rows x[M, K].
// experts == 0: one dense weight[N, K] shared by all rows (expert_ids is not read).
// experts  > 0: weight[E, N, K] stacked experts of identical shape; expert_ids[M] picks each
// row's expert. An id outside [0, E) writes zeros to that row (an unrouted slot). One warp per
// (n, m) task, n-major so the M rows sharing a weight row are adjacent warps;
// grid.x = ceil(N*M / (block/32)).
pub fn glm_vx_gpu_bf16_matmul(out: *mut f32, weight: *const u16, x: *const f32, expert_ids: *const i32, rows_m: i32, rows_n: i32, cols: i32, experts: i32) -> void {
  if rows_m <= 0 { return; }
  if rows_n <= 0 { return; }
  if cols < 0 { return; }
  if experts < 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let lane: i32 = tid & 31;
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let warps: i32 = block / 32;
    let task: i64 = (vx_gpu_block_idx_x() as i64) * (warps as i64) + ((tid / 32) as i64);
    let m_count: i64 = rows_m as i64;
    let n_count: i64 = rows_n as i64;
    if task < m_count * n_count {
      let n: i64 = task / m_count;
      let m: i64 = task % m_count;
      let k: i64 = cols as i64;
      let mut expert: i64 = 0;
      let mut valid: i32 = 1;
      if experts > 0 {
        let id: i32 = expert_ids[m];
        if id < 0 { valid = 0; }
        if id >= experts { valid = 0; }
        expert = id as i64;
      }
      let mut sum: f32 = 0.0;
      if valid != 0 {
        let row_base: i64 = (expert * n_count + n) * k;
        let mut col: i64 = lane as i64;
        while col < k {
          sum = sum + glm_vx_bf16_decode(weight[row_base + col] as i32) * x[m * k + col];
          col = col + 32;
        }
      }
      sum = sum + vx_gpu_shuffle_down_f32(sum, 16);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 8);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 4);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 2);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 1);
      if lane == 0 { out[m * n_count + n] = sum; }
    }
    return;
  }
}
