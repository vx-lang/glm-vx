// Batched and grouped FP8 e4m3fn block-scaled projections (M5). Same weight/scale layout and
// decode as fp8.vx (scales are float32 multipliers, one per 128x128 block). See FP8.md.
// Keep this CPU-reference prefix self-contained: test_fp8_batched.py compiles it unchanged.
pub fn glm_vx_fp8m_decode(byte: u8) -> f32 {
  let bits: i32 = byte as i32;
  let exponent: i32 = (bits >> 3) & 15;
  let mantissa: i32 = bits & 7;
  let mut magnitude: f32 = (mantissa as f32) / 512.0;
  if exponent > 0 {
    let power: i32 = 1 << (exponent - 1);
    magnitude = ((8 + mantissa) as f32) * (power as f32) / 512.0;
  }
  // e4m3fn has no infinity: exponent=15/mantissa=7 encodes NaN.
  if exponent == 15 { if mantissa == 7 { magnitude = 0.0 / 0.0; } }
  let mut sign: f32 = 1.0;
  if (bits & 128) != 0 { sign = -1.0; }
  return magnitude * sign;
}

// GPU ENTRY: CPU tests compile the unchanged prefix above this marker.
extern "C" {
  fn vx_gpu_thread_idx_x() -> i32;
  fn vx_gpu_block_idx_x() -> i32;
  fn vx_gpu_block_dim_x() -> i32;
  fn vx_gpu_shuffle_down_f32(value: f32, delta: i32) -> f32;
}

// out[m, n] = sum_k W_e[n, k] * x[m, k] for M activation rows x[M, K].
// experts == 0: one dense weight[N, K] and scales[ceil(N/128), ceil(K/128)] shared by all rows.
// experts  > 0: weight[E, N, K], scales[E, ceil(N/128), ceil(K/128)] stacked experts of identical
// shape; expert_ids[M] picks each row's expert. An id outside [0, E) writes zeros to that row
// (an unrouted slot). One warp per (n, m) task, n-major so the M rows of one weight row are
// adjacent warps; block size is a multiple of 32 and grid.x = ceil(N*M / (block/32)).
// Each 128-column tile's raw-value dot product is summed before its scale is applied, the order
// quant.py's fp8_matvec_blocked uses. NaN codes propagate to every output they touch.
pub fn glm_vx_gpu_fp8_matmul(out: *mut f32, weight: *const u8, scales: *const f32, x: *const f32, expert_ids: *const i32, rows_m: i32, rows_n: i32, cols: i32, experts: i32) -> void {
  if rows_m <= 0 { return; }
  if rows_n <= 0 { return; }
  if cols < 0 { return; }
  if experts < 0 { return; }
  unsafe {
    let tid: i32 = vx_gpu_thread_idx_x();
    let lane: i32 = tid & 31;
    let block: i32 = vx_gpu_block_dim_x();
    if block < 32 { return; }
    if block > 1024 { return; }
    if block % 32 != 0 { return; }
    let warps: i32 = block / 32;
    let task: i64 = (vx_gpu_block_idx_x() as i64) * (warps as i64) + ((tid / 32) as i64);
    let m_count: i64 = rows_m as i64;
    let n_count: i64 = rows_n as i64;
    if task < m_count * n_count {
      let n: i64 = task / m_count;
      let m: i64 = task % m_count;
      let k: i64 = cols as i64;
      let scale_cols: i64 = (k + 127) / 128;
      let scale_rows: i64 = (n_count + 127) / 128;
      let mut expert: i64 = 0;
      let mut valid: i32 = 1;
      if experts > 0 {
        let id: i32 = expert_ids[m];
        if id < 0 { valid = 0; }
        if id >= experts { valid = 0; }
        expert = id as i64;
      }
      let mut sum: f32 = 0.0;
      if valid != 0 {
        let row_base: i64 = (expert * n_count + n) * k;
        let scale_base: i64 = (expert * scale_rows + n / 128) * scale_cols;
        for tile in 0..scale_cols {
          let tile_base: i64 = tile * 128 + (lane as i64);
          let mut part: f32 = 0.0;
          for step in 0..4 {
            let col: i64 = tile_base + ((step * 32) as i64);
            if col < k {
              part = part + glm_vx_fp8m_decode(weight[row_base + col]) * x[m * k + col];
            }
          }
          sum = sum + part * scales[scale_base + tile];
        }
      }
      sum = sum + vx_gpu_shuffle_down_f32(sum, 16);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 8);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 4);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 2);
      sum = sum + vx_gpu_shuffle_down_f32(sum, 1);
      if lane == 0 { out[m * n_count + n] = sum; }
    }
    return;
  }
}
