diff --git a/gpu/spawn/bf16_rows.vx b/gpu/spawn/bf16_rows.vx
new file mode 100644
index 0000000..a0d3535
--- /dev/null
+++ b/gpu/spawn/bf16_rows.vx
@@ -0,0 +1,16 @@
+// glm_vx_spawn_bf16_rows (#63, TTFT): out[t][c] = x[t][c] as bf16 (nearest even) for the first `count` rows of x, one
+// block of 256 lanes a row: prefill_chunk's rows for cuBLASLt's bfloat16 matmul (gpu/cublaslt.Bf16Matmul) of the
+// checkpoint's BF16 Linears over the rows, the router's gate and the indexer's weights_proj (SGLang's bfloat16 rows
+// for the same two).
+// spawn-include: device.vx
+
+pub fn glm_vx_spawn_bf16_rows(out: &mut Tensor<bf16, [?, ?], Memory::HBM>, x: &Tensor<f32, [?, ?], Memory::HBM>, count: i32,
+                              cols: i32) -> void {
+  spawn on(Topology::Device) {
+    for t in 0..count across blocks {
+      for c in 0..cols across lanes(256) {
+        out[t][c] = x[t][c] as bf16;
+      }
+    }
+  }
+}
