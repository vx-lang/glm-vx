+class Bf16Matmul:
+    """gpu/cublaslt.Bf16Matmul's contract (x and out padded to padded_m tokens, token i's outputs at
+    out[i*n:(i+1)*n]) as float64 NumPy on the bfloat16 bits, rounded to float32 once: cuBLASLt's own sum order is
+    the GPU tests' to check."""
+    def __init__(self,ctx,m,n,k):self.ctx,self.m,self.n,self.k,self.padded_m=ctx,m,n,k,-(-m//4)*4
+    def __call__(self,out,x,w,stream=None):
+        mp,n,k=self.padded_m,self.n,self.k
+        assert out.data.size==mp*n and x.data.size==mp*k and w.data.size==n*k
+        def work():
+            value=lambda bits:(bits.astype(np.uint32)<<16).view(np.float32).astype(np.float64)
+            out.data[...]=(value(x.data.reshape(mp,k))@value(w.data.reshape(n,k)).T).astype(np.float32).reshape(out.data.shape)
+        _run(stream,work)
+    def close(self):pass
