// Reads tokenizer.json from the path in its argument, then sequences of token ids on standard
// input, each a u32 count and u32 ids (little-endian). Writes for each the text that the stream
// sends after each id, the text that its end sends, and the text of all the ids, each a u32 length
// and UTF-8 bytes (tests/test_front_tokenizer.py).
import front::link;
import front::tokenizer;
import std::fs;
import std::io;
import std::string;
import std::vec;

fn read_all_stdin(input : &mut Stdin) -> Result<Vec<u8>, StdioError> {
  let mut all = Vec<u8>::new();
  let mut chunk = Vec<u8>::new();
  for _i in 0..65536 {
    chunk.push(0u8);
  }
  while true {
    let n = input.read(&mut chunk)?;
    if n == 0u64 {
      return Result<Vec<u8>, StdioError>::Ok(all);
    }
    for i in 0..(n as i32) {
      all.push(chunk[i]);
    }
  }
  return Result<Vec<u8>, StdioError>::Ok(all);
}

fn read_file(f : &mut File) -> Result<Vec<u8>, FileError> {
  let mut all = Vec<u8>::new();
  let mut chunk = Vec<u8>::new();
  for _i in 0..1048576 {
    chunk.push(0u8);
  }
  while true {
    let n = f.read(&mut chunk)?;
    if n == 0u64 {
      return Result<Vec<u8>, FileError>::Ok(all);
    }
    for i in 0..(n as i32) {
      all.push(chunk[i]);
    }
  }
  return Result<Vec<u8>, FileError>::Ok(all);
}

fn put_text(out : &mut Vec<u8>, text : &Vec<u8>) -> void {
  put_u32(out, text.len() as u32);
  for i in 0..text.len() {
    out.push(text[i]);
  }
}

fn main(root : Root, args : Vec<String>) -> i32 {
  let mut err = root.stderr;
  if args.len() != 2 {
    return 2;
  }
  let mut file = match File::open(&root.files, &args[1], OpenMode::Read) {
    Result<File, FileError>::Ok(f) => { f }
    Result<File, FileError>::Err(_e) => { return 3; }
  };
  let json = match read_file(&mut file) {
    Result<Vec<u8>, FileError>::Ok(b) => { b }
    Result<Vec<u8>, FileError>::Err(_e) => { return 3; }
  };
  let tok = match load(&json) {
    Result<Tokenizer, Vec<u8>>::Ok(t) => { t }
    Result<Tokenizer, Vec<u8>>::Err(message) => {
      let _w = err.write_all(&message);
      return 4;
    }
  };
  let mut input = root.stdin;
  let all = match read_all_stdin(&mut input) {
    Result<Vec<u8>, StdioError>::Ok(b) => { b }
    Result<Vec<u8>, StdioError>::Err(_e) => { return 2; }
  };
  let mut out = Vec<u8>::new();
  let mut at = 0;
  while at + 4 <= all.len() {
    let n = get_u32(&all, at) as i32;
    let mut ids = Vec<u32>::new();
    let mut d = new_detok();
    for i in 0..n {
      let id = get_u32(&all, at + 4 + 4 * i);
      ids.push(id);
      put_text(&mut out, &detok_push(&mut d, &tok, id));
    }
    at = at + 4 + 4 * n;
    put_text(&mut out, &detok_flush(&mut d, &tok));
    put_text(&mut out, &decode_ids(&tok, &ids));
  }
  let mut o = root.stdout;
  let _w = o.write_all(&out);
  return 0;
}
